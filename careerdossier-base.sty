%% colour; those concerns belong to other modules.

\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesExplPackage {careerdossier-base} {2026-08-12} {0.8.0}
  {CareerDossierTeX shared profile metadata, keys, and validation}

%% ---------------------------------------------------------------------------
%% Known profile fields. `orcid` joined the shared profile in v0.2.0;
%% `affiliation` joined in v0.5.0 so statements and other academic documents can
%% consume the same reusable identity data.
%% ---------------------------------------------------------------------------
\clist_const:Nn \c__cdossier_base_fields_clist
  {
    name , headline , email , phone , location , website , linkedin , github ,
    scholar , orcid , affiliation
  }

%% ---------------------------------------------------------------------------
%% Storage: profile field name -> value.
%% ---------------------------------------------------------------------------
\prop_new:N \g__cdossier_base_fields_prop
\tl_new:N   \l__cdossier_base_value_tl
\tl_new:N   \l__cdossier_base_get_tl

%% Contact-label preference (issue #95). Off by default so released documents
%% render unchanged; when enabled, careerdossier-components prefixes a short
%% text label to contact fields whose nature the value itself does not convey.
%% The preference is stored here because base owns the \CDossierSetup key
%% surface; all rendering stays in the components module. Global, like the
%% profile fields it travels with.
\bool_new:N \g__cdossier_base_contactlabels_bool

%% ---------------------------------------------------------------------------
%% Messages.
%% ---------------------------------------------------------------------------
\msg_new:nnnn { careerdossier-base } { missing-name }
  { The~required~profile~field~'name'~is~not~set~(needed~by~#1). }
  {
    Provide~a~name~before~rendering~identity~content,~for~example: \\
    \c_backslash_str CDossierSetup~\c_left_brace_str ~name~=~
      Ada~Lovelace~\c_right_brace_str
  }

\msg_new:nnnn { careerdossier-base } { missing-field }
  { The~required~profile~field~'#1'~is~not~set. }
  {
    Provide~'#1'~with~\c_backslash_str CDossierSetup~before~rendering~
    identity~content.
  }

\msg_new:nnnn { careerdossier-base } { unknown-field }
  { Unknown~profile~field~'#1'. }
  { The~supported~fields~are:~\clist_use:Nn \c__cdossier_base_fields_clist { ,~ } . }

\msg_new:nnnn { careerdossier-base } { unknown-key }
  { Unknown~\c_backslash_str CDossierSetup~key~'#1'. }
  {
    The~supported~keys~are:~
    \clist_use:Nn \c__cdossier_base_fields_clist { ,~ } ,~
    and~the~option~key~contact-labels.
  }

\msg_new:nnn { careerdossier-base } { overwrite }
  { Profile~field~'#1'~was~already~set;~overwriting~with~the~new~value. }

%% A warning, not an error: see the shape check below for why. Warnings print
%% only this text, so the expected form belongs here rather than in a fourth
%% argument no reader would see.
\msg_new:nnn { careerdossier-base } { orcid-shape }
  {
    The~'orcid'~value~'#1'~does~not~look~like~an~ORCID~iD. \\
    An~ORCID~iD~is~sixteen~digits~in~four~hyphen-separated~groups~with~a~
    final~digit~or~X,~for~example~0000-0002-1825-0097;~a~complete~
    https://orcid.org/~URL~is~also~accepted. \\
    The~value~is~used~as~given,~so~check~it~before~publishing.
  }

%% ---------------------------------------------------------------------------
%% Internal: store a field, trimming surrounding spaces and treating a
%% whitespace-only value as missing.
%% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__cdossier_base_store:nn #1#2
  {
    \tl_set:Nx \l__cdossier_base_value_tl { \tl_trim_spaces:n {#2} }
    \tl_if_empty:NTF \l__cdossier_base_value_tl
      { \prop_gremove:Nn \g__cdossier_base_fields_prop {#1} }
      {
        \prop_if_in:NnT \g__cdossier_base_fields_prop {#1}
          { \msg_warning:nnn { careerdossier-base } { overwrite } {#1} }
        \prop_gput:NnV \g__cdossier_base_fields_prop {#1} \l__cdossier_base_value_tl
        %% Recorded first, then checked: a questionable value is still stored
        %% and still typeset.
        \str_if_eq:nnT {#1} { orcid }
          { \__cdossier_base_orcid_check:V \l__cdossier_base_value_tl }
      }
  }

%% ---------------------------------------------------------------------------
%% ORCID shape check (issue #331).
%%
%% An ORCID iD has a documented shape: sixteen digits in four hyphen-separated
%% groups, the last character a digit or `X'. Nothing else in this toolkit looks
%% at the value -- careerdossier-components prefixes anything without a scheme
%% with `https://orcid.org/' -- so a truncated iD, or a value pasted into the
%% wrong key, becomes a confident and wrong link that renders like any other.
%% The check belongs here rather than next to that rendering: it is a question
%% about the recorded data, answered once when the value is recorded and
%% independently of which class later prints it.
%%
%% It warns and never errors. The author may hold an identifier this check does
%% not anticipate, and refusing to typeset a document over one would be
%% disproportionate. Nothing about the stored value, the emitted target, or the
%% `ORCID:' label changes either way.
%%
%% One pattern covers every accepted form: the bare iD, optionally preceded by
%% an `http://' or `https://' scheme, an optional `www.', and an optional
%% `orcid.org/' host. A lowercase `x' checksum character and a single trailing
%% slash are tolerated -- both are what an address bar hands back, and warning
%% about a value that does resolve is the false alarm that teaches authors to
%% ignore the real one. Spaces would be significant in the pattern, so it
%% carries none.
%% ---------------------------------------------------------------------------
\regex_const:Nn \c__cdossier_base_orcid_regex
  { \A(?:https?://)?(?:www\.)?(?:orcid\.org/)?\d{4}-\d{4}-\d{4}-\d{3}[0-9Xx]/?\Z }
\str_new:N \l__cdossier_base_orcid_str

\cs_new_protected:Npn \__cdossier_base_orcid_check:n #1
  {
    %% Compared as a string: the pattern is about characters, and the stored
    %% value carries whatever catcodes the document gave it.
    \str_set:Nn \l__cdossier_base_orcid_str {#1}
    \regex_match:NVF \c__cdossier_base_orcid_regex \l__cdossier_base_orcid_str
      { \msg_warning:nnn { careerdossier-base } { orcid-shape } {#1} }
  }
\cs_generate_variant:Nn \__cdossier_base_orcid_check:n { V }

%% Internal: error out on an unrecognized field name.
\cs_new_protected:Npn \__cdossier_base_check_known:n #1
  {
    \clist_if_in:NnF \c__cdossier_base_fields_clist {#1}
      { \msg_error:nnn { careerdossier-base } { unknown-field } {#1} }
  }

%% Internal: is a field present (and therefore nonblank)?
\prg_new_protected_conditional:Npnn \__cdossier_base_field_if_present:n #1
  { T , F , TF }
  {
    \prop_if_in:NnTF \g__cdossier_base_fields_prop {#1}
      { \prg_return_true: }
      { \prg_return_false: }
  }

%% Internal: require `name` before identity content is rendered.
%% #1 is the calling command; it is stringified, never executed, in the
%% error message.
\cs_new_protected:Npn \__cdossier_base_require_name:N #1
  {
    \__cdossier_base_field_if_present:nF { name }
      { \msg_error:nnx { careerdossier-base } { missing-name } { \token_to_str:N #1 } }
  }

%% Internal: require any known profile field. Statement types use this for
%% email and their type-specific identity requirements; validation remains in
%% the module that owns profile data rather than being duplicated by a class.
\cs_new_protected:Npn \__cdossier_base_require_field:n #1
  {
    \__cdossier_base_check_known:n {#1}
    \__cdossier_base_field_if_present:nF {#1}
      { \msg_error:nnn { careerdossier-base } { missing-field } {#1} }
  }

%% ---------------------------------------------------------------------------
%% Profile keys.
%% ---------------------------------------------------------------------------
\keys_define:nn { cdossier / profile }
  {
    name     .code:n = { \__cdossier_base_store:nn { name }     {#1} } ,
    headline .code:n = { \__cdossier_base_store:nn { headline } {#1} } ,
    email    .code:n = { \__cdossier_base_store:nn { email }    {#1} } ,
    phone    .code:n = { \__cdossier_base_store:nn { phone }    {#1} } ,
    location .code:n = { \__cdossier_base_store:nn { location } {#1} } ,
    website  .code:n = { \__cdossier_base_store:nn { website }  {#1} } ,
    linkedin .code:n = { \__cdossier_base_store:nn { linkedin } {#1} } ,
    github   .code:n = { \__cdossier_base_store:nn { github }   {#1} } ,
    scholar  .code:n = { \__cdossier_base_store:nn { scholar }  {#1} } ,
    orcid    .code:n = { \__cdossier_base_store:nn { orcid }    {#1} } ,
    affiliation .code:n =
      { \__cdossier_base_store:nn { affiliation } {#1} } ,
    %% Not a profile field: a rendering preference consumed by the components
    %% module. `contact-labels` alone means true; the value is validated by
    %% l3keys' boolean handling.
    contact-labels .bool_gset:N = \g__cdossier_base_contactlabels_bool ,
    contact-labels .default:n   = true ,
    unknown  .code:n =
      { \msg_error:nnx { careerdossier-base } { unknown-key } { \l_keys_key_str } } ,
  }

%% ---------------------------------------------------------------------------
%% Public interface.
%% ---------------------------------------------------------------------------

%% \CDossierSetup { key = value, ... }
\NewDocumentCommand \CDossierSetup { m }
  { \keys_set:nn { cdossier / profile } {#1} }

%% \CDossierPrintField {field} -- prints the stored value, nothing if absent,
%% and errors on an unknown field name.
\NewDocumentCommand \CDossierPrintField { m }
  {
    \__cdossier_base_check_known:n {#1}
    \prop_get:NnNT \g__cdossier_base_fields_prop {#1} \l__cdossier_base_get_tl
      { \tl_use:N \l__cdossier_base_get_tl }
  }

%% \CDossierIfFieldTF {field} {true} {false} -- true when the field is present
%% (present implies nonblank); errors on an unknown field name. The branches are
%% long, so they may contain \par or full paragraphs.
\NewDocumentCommand \CDossierIfFieldTF { m +m +m }
  {
    \__cdossier_base_check_known:n {#1}
    \__cdossier_base_field_if_present:nTF {#1} {#2} {#3}
  }

%% \CDossierFieldValue {field} -- expands to the stored value, or nothing if the
%% field is absent. Intended for shared components that need the raw value (for
%% example to build a link target). It does not typeset and does not validate.
%% \prop_item:Nn returns \q_no_value when the key is absent; guard it so that a
%% missing field always expands to empty rather than leaking the quark.
\NewExpandableDocumentCommand \CDossierFieldValue { m }
  {
    \prop_if_in:NnTF \g__cdossier_base_fields_prop {#1}
      { \prop_item:Nn \g__cdossier_base_fields_prop {#1} }
      { }
  }
