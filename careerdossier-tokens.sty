%% careerdossier-tokens is the single source of truth for the calibrated type
%% scale, baseline-derived vertical rhythm, rule and list metrics, and the two
%% supported page-margin presets. It owns no colour, fonts, semantic roles, or
%% rendered components.

\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesExplPackage {careerdossier-tokens} {2026-08-12} {0.8.0}
  {CareerDossierTeX calibrated design tokens}

\RequirePackage { l3keys2e }
\RequirePackage { geometry }

\tl_new:N \l__cdossier_tokens_fontsize_tl
\tl_set:Nn \l__cdossier_tokens_fontsize_tl { 12pt }
\tl_new:N \l__cdossier_tokens_margin_tl
\tl_set:Nn \l__cdossier_tokens_margin_tl { normal }

\msg_new:nnnn { careerdossier-tokens } { unknown-option }
  { Unknown~package~option~'#1'~for~careerdossier-tokens. }
  {
    Supported~options~are~'fontsize'~(10pt,~11pt,~12pt)~and~
    'margin'~(normal,~narrow).
  }

%% l3keys' own choice error reports that the value is not one of a fixed set
%% without saying what that set is, so the accepted values are named here.
\msg_new:nnnn { careerdossier-tokens } { unknown-fontsize }
  { Unknown~'fontsize'~value~'#1'~for~careerdossier-tokens. }
  { The~accepted~values~are~'10pt',~'11pt',~and~'12pt'. }

\msg_new:nnnn { careerdossier-tokens } { unknown-margin }
  { Unknown~'margin'~value~'#1'~for~careerdossier-tokens. }
  {
    The~accepted~values~are~'normal'~(one-inch~margins)~and~
    'narrow'~(half-inch~margins).
  }

\keys_define:nn { cdossier / tokens }
  {
    fontsize .choices:nn =
      { 10pt , 11pt , 12pt }
      { \tl_set_eq:NN \l__cdossier_tokens_fontsize_tl \l_keys_choice_tl } ,
    fontsize / unknown .code:n =
      { \msg_error:nnn { careerdossier-tokens } { unknown-fontsize } {#1} } ,
    fontsize .value_required:n = true ,
    margin .choices:nn =
      { normal , narrow }
      { \tl_set_eq:NN \l__cdossier_tokens_margin_tl \l_keys_choice_tl } ,
    margin / unknown .code:n =
      { \msg_error:nnn { careerdossier-tokens } { unknown-margin } {#1} } ,
    margin .value_required:n = true ,
    unknown .code:n =
      {
        \msg_error:nnx { careerdossier-tokens } { unknown-option }
          { \l_keys_key_str }
      } ,
  }
%% \ProcessKeysPackageOptions reads local package options only, never the
%% global \documentclass list, matching careerdossier-typography and
%% careerdossier-components. Every public class owns its own `fontsize' and
%% `margin' surface and forwards the *resolved* value with
%% \PassOptionsToPackage, so a class option reaches this package only after
%% that class has validated it -- and a value that class rejected is reported
%% once, by the class that owns it. Direct package users receive the same
%% validation contract through \usepackage's own option list.
\ProcessKeysPackageOptions { cdossier / tokens }

%% Resolved base metrics. Keep one public token for body size and one for body
%% leading: duplicate aliases make it unclear which value downstream modules
%% should consume.
\dim_new:N \CDossierBodySize
\dim_new:N \CDossierBodyLeading
\dim_new:N \CDossierPageMargin
%% The leading of the furniture step of the type scale (\CDossierSizeFurniture).
%% Page furniture is the one component positioned by the page geometry rather
%% than by the vertical rhythm, so its line height has to be available as a
%% dimension before any font is selected; the size commands cannot supply it.
\dim_new:N \CDossierFurnitureLeading
\dim_new:N \CDossierRuleThickness
\dim_new:N \CDossierListLabelSep
%% Issue #272: the line-breaking flexibility every family may spend on a
%% paragraph TeX cannot otherwise set within \tolerance. This module owns it
%% because line-breaking policy is a shared typographic decision, not a
%% per-class one; the classes apply the token and none of them names a value.
\dim_new:N \CDossierEmergencyStretch

%% Keep-together penalties (issue #145). Entry-structured documents (résumé,
%% CV) state their page-break policy as named, tokenised penalties rather than
%% bare \nobreak calls, so the policy is visible and independently tunable.
%% Continuous-prose documents (letter, statement) are unaffected and keep
%% ordinary \widowpenalty/\clubpenalty handling.
%%
%% CDossierHeadingKeepPenalty is a hard \nobreak-strength value (10000). It
%% guards the boundaries that must never be broken: an entry heading's own two
%% lines, the entry heading and the first line of its body, and the two list
%% boundaries that would leave a single bullet stranded. Each spans a bounded
%% amount of material, so forbidding the break cannot overflow a page.
%%
%% Issue #333: the section heading is deliberately *not* in that list any more.
%% Read literally, a penalty after the section rule does not say "keep the
%% heading with its first few lines" -- it says "keep the heading with
%% everything up to the next legal breakpoint", which is unbounded and makes the
%% heading hostage to whatever the section happens to contain. Because every
%% vertical token here is rigid and all four classes are \raggedbottom -- an
%% inherited state, sourced and guarded below, where the club/widow values rely
%% on it too -- page badness is constant, so the page builder cannot weigh that
%% keep against the hole it opens; the penalty only ever deletes candidates.
%% The section keep is now expressed as a requirement before the heading -- see
%% CDossierSectionNeedLines -- which bounds it and leaves the boundaries inside
%% the section legal.
%%
%% CDossierListOrphanPenalty guards every interior list boundary and is
%% deliberately below 10000, so a list longer than a page still breaks
%% somewhere in its middle instead of overflowing. Together the two values
%% mean an over-long list breaks, but never at a position that isolates one
%% item.
\int_new:N \CDossierHeadingKeepPenalty
\int_set:Nn \CDossierHeadingKeepPenalty { 10000 }
\int_new:N \CDossierListOrphanPenalty
\int_set:Nn \CDossierListOrphanPenalty { 9997 }

%% CDossierSectionNeedLines is the section heading's keep, expressed as a bound
%% instead of a prohibition (issue #333). A section heading is placed only when
%% at least this many lines of body leading remain on the page; otherwise the
%% page breaks *before* the heading and the heading opens the next one.
%%
%% Four lines is what the heading actually needs to introduce anything: the
%% heading and its rule, the two lines of the first entry heading, and that
%% entry's first line of body. Fewer strands the heading in the sense issue #145
%% forbids; more would start pushing headings to the next page for no gain,
%% since a section is free to break immediately after its first entry.
%%
%% This replaces a keep with no ceiling at all, so it can only commit less
%% material to a page than the penalty it succeeds, never more. It is a count of
%% lines rather than a dimension because it is a statement about content -- the
%% same four lines at every fontsize -- and \CDossierBodyLeading supplies the
%% measure at the point of use.
\int_new:N \CDossierSectionNeedLines
\int_set:Nn \CDossierSectionNeedLines { 4 }

%% CDossierSubsectionNeedLines is the same bound for the record classes' second
%% heading level (issue #337), and it is smaller because a subsection commits
%% less: its own heading line and the two lines of the first entry heading it
%% introduces. There is no rule between them, and the entry heading carries its
%% own keep down to its first body line (issue #145), so the subsection does not
%% have to require that line a second time.
%%
%% A subsection that opens its section directly is exempt from this check
%% altogether -- see \__cdossier_components_subsection:n. The section's own
%% four-line bound already placed that material, so re-testing here could only
%% break the page between a section heading and the subsection immediately under
%% it, which is the stranding issue #145 forbids.
\int_new:N \CDossierSubsectionNeedLines
\int_set:Nn \CDossierSubsectionNeedLines { 3 }

%% Typographic page-break penalties (issue #171). These control hyphenation
%% and paragraph-remnant breaks at page boundaries, complementing the
%% structural keep-together penalties above.
%%
%% CDossierBrokenPenalty discourages splitting a hyphenated word across a
%% page break. A value of 10000 forbids the break entirely.
%%
%% CDossierClubPenalty and CDossierWidowPenalty control single-line paragraph
%% remnants at the foot (club line) or top (widow line) of a page. All four
%% document families share the same forbidding value (10000) rather than a
%% lower value for the continuous-prose classes: measurement against the
%% committed letter fixtures showed a discount penalty (4000) still let a
%% one-line paragraph remnant through, while 10000 removed it with zero
%% overfull vboxes across every two-page fixture. This is safe because all
%% four classes are \raggedbottom, so forbidding club/widow breaks only closes
%% off the first and last line of a paragraph as break points — interior line
%% breaks remain available, so a page can still break inside an over-long
%% paragraph rather than overflow.
%%
%% Issue #335: that \raggedbottom is inherited, not set here. It comes from
%% `article.cls', which issues it in the \if@twoside false branch and switches
%% to \flushbottom for \if@twocolumn; the four classes get it only because each
%% loads `article' one-side and one-column. Under \flushbottom the justification
%% above stops holding -- the short pages these penalties produce would be
%% stretched to the full text height, or reported as `Underfull \vbox', instead
%% of ending in white space -- and nothing about that failure would point back
%% here. The `tokens-*-defaults' regressions therefore assert the effective
%% bottom-fill state of each of the four classes, so a class that later takes
%% `twoside' or `twocolumn' fails a baseline rather than changing the page
%% silently.
%%
%% Issue #351 asked for the rule that would dominate both outcomes -- fill the
%% page unless doing so strands a line. It was specified, built, measured, and
%% declined. What it needs is not a token: LaTeX's \raggedbottom leaves \topskip
%% rigid and puts its fil in \@textbottom, which the output routine inserts at
%% shipout, so the page builder never sees it. Plain TeX's \raggedbottom is
%% `\topskip 10pt plus 60pt' -- the same ragged bottom, with the tolerance where
%% the builder does see it. One line therefore reopens all of the above, which is
%% why the state is now guarded rather than assumed: the `tokens-*-defaults'
%% baselines record \topskip and \@secpenalty beside the bottom-fill state, so a
%% package that supplies either cannot switch this calibration on in silence.
%%
%% Declined because the tolerance does not keep the guarantee, it prices it. The
%% fill it recovers is still bought one-for-one with a stranded line, and the
%% same tolerance makes LaTeX's -300 \@secpenalty live, which moves breaks
%% *earlier* and costs two shipped examples 11.8 points of page-one fill.
%% docs/ARCHITECTURE.md ("Page-break penalties") holds the measurements.
\int_new:N \CDossierBrokenPenalty
\int_set:Nn \CDossierBrokenPenalty { 10000 }
\int_new:N \CDossierClubPenalty
\int_set:Nn \CDossierClubPenalty { 10000 }
\int_new:N \CDossierWidowPenalty
\int_set:Nn \CDossierWidowPenalty { 10000 }

%% Issue #204: every vertical boundary is owned by exactly one token, and every
%% token declared here reaches the page at some boundary in the class that uses
%% it. Two rules make that possible and both are load-bearing.
%%
%% Block boundaries compose with `\addvspace', which takes the *maximum* of the
%% adjacent claims and never their sum (issue #168). Where two tokens met at one
%% boundary the smaller was therefore unreachable: changing it moved nothing and
%% produced no diagnostic. `\CDossierRecordEntryBelowSkip' and
%% `\CDossierLetterheadBelowSkip' were exactly that and are retired; see
%% docs/MIGRATION.md.
%%
%% A paragraph boundary additionally contributes `\parskip', which `\addvspace'
%% cannot absorb -- `\parskip' is inserted at the *next* paragraph's start, after
%% `\addvspace' has already read `\lastskip', so the two always add. A token at
%% such a boundary is therefore emitted as `\addvspace{token - \parskip}', so
%% the token still names the rendered gap. `careerdossier-statement.cls' uses
%% that pattern for its headings and the shared header stack uses it for every
%% header line.
%%
%% Issue #220: a token that cannot change output at any value is not a tunable,
%% whatever its value. `\CDossierSharedHeaderAboveSkip' was glue above the first
%% header line, which is always the first material on page 1 and therefore
%% always discarded; `\CDossierSharedHeaderParSkip' was subtracted from every
%% header gap and then re-contributed by the following header line, so it
%% cancelled itself for every value. Both are retired; see docs/MIGRATION.md.
%% The header group still needs its own paragraph gap -- see
%% `careerdossier-components.sty' -- but it is now a fixed zero rather than a
%% public knob.
%%
%% Issue #223: the two gaps *inside* the header stack are genuinely shared --
%% every class stacks the same lines in the same order, and the stack zeroes
%% `\parskip' for its own group, so the same ratio renders the same gap
%% everywhere. The gap *below* the stack is not shared in the same sense: it is
%% a boundary against whatever the class puts next, and that neighbour differs
%% per family (a ruled section in the record classes, a prose section in the
%% statement, the date line in the letter). One token therefore had to clear
%% the most demanding neighbour in any class, and a heading retune in one
%% family silently spent vertical space in the other two. It is split into one
%% token per family below; see docs/MIGRATION.md.
\skip_new:N \CDossierSharedHeaderNameGapSkip
\skip_new:N \CDossierSharedHeaderMetaGapSkip
\skip_new:N \CDossierRecordHeaderBelowSkip
\skip_new:N \CDossierProseHeaderBelowSkip
\skip_new:N \CDossierLetterHeaderBelowSkip
\skip_new:N \CDossierRecordSectionAboveSkip
\skip_new:N \CDossierRecordSectionRuleGapSkip
\skip_new:N \CDossierRecordSectionBelowSkip
\skip_new:N \CDossierRecordSubsectionAboveSkip
\skip_new:N \CDossierRecordSubsectionBelowSkip
\skip_new:N \CDossierProseSectionAboveSkip
\skip_new:N \CDossierProseSectionBelowSkip
\skip_new:N \CDossierProseSubsectionAboveSkip
\skip_new:N \CDossierProseSubsectionBelowSkip
\skip_new:N \CDossierRecordEntryAboveSkip
\skip_new:N \CDossierRecordEntryGapSkip
\skip_new:N \CDossierRecordListEdgeAboveSkip
\skip_new:N \CDossierRecordListEdgeBelowSkip
\skip_new:N \CDossierRecordItemSepSkip
\skip_new:N \CDossierRecordParSkip
\skip_new:N \CDossierProseParSkip
\skip_new:N \CDossierLetterParSkip
\skip_new:N \CDossierLetterRecipientLineGapSkip
\skip_new:N \CDossierLetterBlockSkip
\skip_new:N \CDossierLetterBodyAboveSkip
\skip_new:N \CDossierLetterBodyBelowSkip
\skip_new:N \CDossierLetterSignatureGapSkip

\cs_new_eq:NN \__cdossier_tokens_article_normalsize: \normalsize

\cs_new_protected:Npn \__cdossier_tokens_set_size_command:Nnn #1#2#3
  {
    \cs_set_protected:Npn #1
      { \fontsize {#2} {#3} \selectfont }
  }

\cs_new_protected:Npn \__cdossier_tokens_set_skip:Nn #1#2
  {
    \skip_set:Nn #1
      {
        \fp_to_dim:n
          { (#2) * \dim_to_fp:n { \CDossierBodyLeading } }
      }
  }

\cs_new_protected:Npn \__cdossier_tokens_resolve:
  {
    \str_case:Vn \l__cdossier_tokens_fontsize_tl
      {
        { 10pt }
          {
            \dim_set:Nn \CDossierBodySize { 10pt }
            \dim_set:Nn \CDossierBodyLeading { 12pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeName { 19pt } { 21pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeDocumentTitle { 15pt } { 17pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeHeadline { 12pt } { 14pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeSection { 11pt } { 13pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeBody { 10pt } { 12pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeSmall { 9pt } { 11pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeFurniture { 8pt } { 10pt }
            \dim_set:Nn \CDossierFurnitureLeading { 10pt }
          }
        { 11pt }
          {
            \dim_set:Nn \CDossierBodySize { 11pt }
            \dim_set:Nn \CDossierBodyLeading { 13.6pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeName { 21pt } { 23pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeDocumentTitle { 16pt } { 18pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeHeadline { 13pt } { 15pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeSection { 12pt } { 14pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeBody { 11pt } { 13.6pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeSmall { 10pt } { 12pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeFurniture { 9pt } { 11pt }
            \dim_set:Nn \CDossierFurnitureLeading { 11pt }
          }
        { 12pt }
          {
            \dim_set:Nn \CDossierBodySize { 12pt }
            \dim_set:Nn \CDossierBodyLeading { 14.5pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeName { 23pt } { 25pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeDocumentTitle { 18pt } { 20pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeHeadline { 14pt } { 16pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeSection { 13pt } { 15pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeBody { 12pt } { 14.5pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeSmall { 11pt } { 13pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeFurniture { 10pt } { 12pt }
            \dim_set:Nn \CDossierFurnitureLeading { 12pt }
          }
      }

    \str_case:Vn \l__cdossier_tokens_margin_tl
      {
        { normal } { \dim_set:Nn \CDossierPageMargin { 1in } }
        { narrow } { \dim_set:Nn \CDossierPageMargin { 0.5in } }
      }

    \dim_set:Nn \CDossierRuleThickness
      {
        \fp_to_dim:n
          { 0.04 * \dim_to_fp:n { \CDossierBodySize } }
      }
    %% enumitem must receive a literal `leftmargin = *`; it does not expand a
    %% macro before testing for the star. LaTeX Lab's tagged-list emulation
    %% instead requires an explicit dimension, which the rendering class
    %% derives from the bullet width plus this shared label separation.
    \dim_set:Nn \CDossierListLabelSep
      {
        \fp_to_dim:n
          { 0.5 * \dim_to_fp:n { \CDossierBodySize } }
      }
    %% Issue #272: one \emergencystretch policy for all four families. Three
    %% classes each wrote `2em' -- the letter and the statement unconditionally,
    %% the CV only at `a4paper' -- and the résumé wrote nothing, so four classes
    %% held three policies and none of them could say why they differed.
    %%
    %% The value is a multiple of \CDossierBodySize rather than of
    %% \CDossierBodyLeading, because emergency stretch is distributed among the
    %% interword glue of a line: it is a horizontal quantity, and the horizontal
    %% unit of the type scale is the body size. 2.00 reproduces the value the
    %% three classes already rendered exactly -- \fontdimen6 equals the design
    %% size for both supported body fonts, so `2em' measured 20/22/24pt at
    %% 10/11/12pt, which is what this ratio gives. The change is therefore
    %% mechanism-only for the letter and the statement, and the token no longer
    %% depends on a font whose quad happens to equal its design size, nor on
    %% which font is current at the point the length is set.
    %%
    %% Issue #310 asked whether the token should instead scale with the measure,
    %% since a pool is spent on a line and a line has a length. It was measured
    %% and it should not, because the quantity it has to cover tracks neither.
    %% Holding one fixture, its text, and its body size fixed and varying only
    %% the measure in 8pt steps from 400pt to 560pt, the smallest pool that
    %% clears every overfull box is a sawtooth with no trend: the résumé Summary
    %% prose needs 1.00pt at a 440pt measure and 11.25pt at 520pt, then nothing
    %% at 528pt, and the bullet path needs 33.75pt at 416pt and 0.75pt at 512pt.
    %% Across the two paths the correlation between measure and required pool
    %% comes out at +0.417 and -0.568 -- opposite signs, so the requirement is
    %% not a function of the measure. It is set by where one paragraph's break
    %% points happen to fall, which no derivation can predict.
    %%
    %% What follows is that the *form* cannot be chosen on rescue efficacy, only
    %% the magnitude can. Sweeping every layout fixture over three body sizes and
    %% both margins, the two forms match wherever the pools match: 1.50 x body
    %% size and 0.040 x measure both leave the same five overfull boxes in the
    %% same five cells, and 2.50 x body size and 0.050 x measure both leave the
    %% same two. So the tie is broken on the one criterion that does separate
    %% them -- a measure-derived token would be the only metric here not on the
    %% type scale, where \CDossierRuleThickness and \CDossierListLabelSep already
    %% sit -- and the ratio stays at the value #272 preserved. Raising it is not
    %% free: 39 paragraphs in that sweep reach the third pass and set within it,
    %% and a larger pool re-breaks them, so a rescue bought for an off-design
    %% stress fixture is paid for by reflowing documents that already set.
    %%
    %% It is applied unconditionally, including by the résumé, which is fully
    %% justified and carries the longest unbreakable strings in the toolkit --
    %% technical terms and URLs in bullet text. Extending it there and to the
    %% letter-paper CV cannot loosen a paragraph that already sets: TeX consults
    %% \emergencystretch only in a third pass, reached only when the second pass
    %% finds no feasible set of breakpoints within \tolerance. It buys back the
    %% paragraphs that would otherwise be set overfull, and nothing else.
    \dim_set:Nn \CDossierEmergencyStretch
      {
        \fp_to_dim:n
          { 2.00 * \dim_to_fp:n { \CDossierBodySize } }
      }

    \__cdossier_tokens_set_skip:Nn \CDossierSharedHeaderNameGapSkip { 0.25 }
    \__cdossier_tokens_set_skip:Nn \CDossierSharedHeaderMetaGapSkip { 0.1875 }
    %% Issue #223: one gap below the header stack per document family, each
    %% answering only for the boundary it actually meets -- the record classes'
    %% ruled section heading, the statement's prose section heading, and the
    %% letter's date line (\CDossierLetterBlockSkip, 0.50). The retired
    %% \CDossierSharedHeaderBelowSkip had to clear whichever of those was
    %% largest in *any* class, so raising a section gap in one family spent
    %% vertical space in the other two, and the letter carried a floor set by a
    %% boundary it does not have. The split shipped mechanism-only, with all
    %% three at the single value the shared token carried; issue #206 then
    %% retuned them together. They remain equal because each still clears its
    %% own neighbour with room to spare, not because one value is imposed on
    %% all three -- the point of #223 is that they may now diverge freely.
    \__cdossier_tokens_set_skip:Nn \CDossierRecordHeaderBelowSkip { 0.9375 }
    \__cdossier_tokens_set_skip:Nn \CDossierProseHeaderBelowSkip { 0.9375 }
    \__cdossier_tokens_set_skip:Nn \CDossierLetterHeaderBelowSkip { 0.9375 }
    \__cdossier_tokens_set_skip:Nn \CDossierRecordSectionAboveSkip { 0.875 }
    %% Issue #169: measured from the section heading's baseline, not from the
    %% bottom of its line box. The value has a hard lower bound -- the heading's
    %% depth, about 0.20 line at every supported size -- because a smaller
    %% offset would draw the rule through descender ink. 0.3125 leaves 1.63 pt
    %% of clearance at 11 pt and sits between the two distances it replaces
    %% (2.28 pt under a heading without descenders, 4.80 pt under one with).
    %%
    %% Issue #206: this comment used to claim 0.3125 was the smallest sixteenth
    %% that clears the descender. It is not -- 0.25 also passes
    %% `tests/smoke/section-rule-baseline.inc' at all three body sizes. The
    %% value is kept for the clearance it leaves, not because a smaller grid
    %% step is unavailable.
    \__cdossier_tokens_set_skip:Nn \CDossierRecordSectionRuleGapSkip { 0.3125 }
    \__cdossier_tokens_set_skip:Nn \CDossierRecordSectionBelowSkip { 0.4375 }
    %% Issue #337: the record classes' second heading level. The pair is not the
    %% prose subsection pair under another name, and only the above-ratio could
    %% have been ported.
    %%
    %% The below-ratio is pinned from both sides. Record boundaries compose with
    %% `\addvspace', which takes the maximum, so a below-token that only ties the
    %% opening claim of what follows never reaches the page: it would be the dead
    %% token issue #204 retired \CDossierRecordEntryBelowSkip for. The two blocks
    %% a record subsection introduces open at 0.3125
    %% (\CDossierRecordEntryAboveSkip, an entry run) and 0.25
    %% (\CDossierRecordListEdgeAboveSkip, the CV's CDossierPublications list), so
    %% the value must exceed 0.3125 to be reachable at all, and must stay under
    %% \CDossierRecordSectionBelowSkip (0.4375) to read as tighter than the
    %% section it sits inside. On the sixteenth grid that leaves exactly 0.375.
    %%
    %% One pair therefore serves both cases, which is the product question #337
    %% asked. 0.375 wins the maximum against an entry run and against the
    %% publication list alike, so the gap below a subsection is the same gap in
    %% both -- the two neighbours differ, but neither of them owns the boundary.
    %%
    %% The above-ratio is 0.75, not the prose pair's 0.625. Every heading pair in
    %% the toolkit satisfies `above >= 2 x below', which
    %% `tests/regression/tokens-invariants.lvt' asserts at 10/11/12pt; with the
    %% below-ratio pinned at 0.375, 0.625 would render 1.67:1 and be the first
    %% pair to violate it. 0.75 meets the floor exactly, the same way
    %% \CDossierRecordSectionAboveSkip is exactly twice its own below-token, and
    %% stays under 0.875 so the subsection is still a child of its section on
    %% both edges.
    %%
    %% The above-token is *not* what a section opening directly with a subsection
    %% renders. There \__cdossier_components_subsection:n suppresses it and
    %% \CDossierRecordSectionBelowSkip (0.4375) owns the boundary alone, so that
    %% gap is the same whether the section opens with a subsection or with an
    %% entry. This is the record equivalent of `\@startsection''s `\if@nobreak'
    %% guard, which gives the statement class the same result -- see the note on
    %% \CDossierProseSubsectionAboveSkip below and the mechanism in
    %% careerdossier-components.
    \__cdossier_tokens_set_skip:Nn \CDossierRecordSubsectionAboveSkip { 0.75 }
    \__cdossier_tokens_set_skip:Nn \CDossierRecordSubsectionBelowSkip { 0.375 }
    %% Issue #177: the heading rhythm of a continuous-prose document -- today
    %% the statement class, the only one with headings and prose paragraph
    %% spacing at once. It cannot reuse the four tokens above, which are
    %% calibrated for a ruled heading in a document whose paragraphs are
    %% separated by nothing (\CDossierRecordParSkip is 0). A prose statement
    %% separates its paragraphs by \CDossierProseParSkip (0.25), so a heading
    %% gap must first exceed that before it separates anything at all.
    %%
    %% The pair is therefore stated against the paragraph gap: 0.875 above is
    %% three and a half times it, 0.375 below is one and a half times it, and
    %% the ratio between them binds a heading to the text it introduces rather
    %% than leaving it floating between two blocks. The subsection pair keeps
    %% that shape one step down (0.625 / 0.3125): still clear of the paragraph
    %% gap, but unambiguously tighter than the section it sits inside.
    %%
    %% Issue #206 retuned all four. The pair relation is a floor -- above is at
    %% least twice below -- rather than an equality, because the ratio of the
    %% tokens is not the ratio a reader perceives: both gaps are padded by the
    %% same line-box white and a heading spends part of its own below-gap on
    %% its deeper font box, so a pair at 2:1 in tokens renders wider than 2:1
    %% in white. Measured on the built statement at 12 pt, this pair renders
    %% 9.65 pt above against 3.27 pt below -- 2.95:1. The subsection pair
    %% renders 7.03 / 2.68, or 2.62:1. `tests/regression/tokens-invariants.lvt'
    %% asserts the floor at 10/11/12 pt.
    %%
    %% One consequence is easy to mis-state: a section that opens directly with
    %% a subsection does *not* take the subsection's above-gap. `\@startsection'
    %% guards its before-skip with `\if@nobreak', which is true immediately
    %% after a heading, so the before-skip is never added there and
    %% \CDossierProseSectionBelowSkip owns that boundary.
    %%
    %% Each of these four owns the complete gap, including the \parskip the
    %% adjacent paragraph contributes; see the sectioning block in
    %% careerdossier-statement.cls for how that is arranged and why the two
    %% below-tokens must stay strictly greater than \CDossierProseParSkip.
    \__cdossier_tokens_set_skip:Nn \CDossierProseSectionAboveSkip { 0.875 }
    \__cdossier_tokens_set_skip:Nn \CDossierProseSectionBelowSkip { 0.375 }
    \__cdossier_tokens_set_skip:Nn \CDossierProseSubsectionAboveSkip { 0.625 }
    \__cdossier_tokens_set_skip:Nn \CDossierProseSubsectionBelowSkip { 0.3125 }
    %% Issue #204: \CDossierRecordEntryAboveSkip is the sole inter-entry token.
    %% The retired \CDossierRecordEntryBelowSkip claimed the same boundary from
    %% the other side and lost every max it entered -- to this token between two
    %% entries, and to \CDossierRecordSectionAboveSkip at a section end.
    \__cdossier_tokens_set_skip:Nn \CDossierRecordEntryAboveSkip { 0.3125 }
    %% Issue #204: the floor for the entry heading -> body boundary, emitted with
    %% `\addvspace' rather than `\vspace'. As a `\vspace' it was extra space that
    %% *added* to whatever the body opened with, so a bullet list sat at
    %% EntryGap + ListEdgeAbove above its own entry and at max(...) below it --
    %% further from the entry that owns it than from the next one. Both ends of a
    %% list are now maxes, so the "a list belongs to the entry above it" relation
    %% is expressible by the ratios alone.
    \__cdossier_tokens_set_skip:Nn \CDossierRecordEntryGapSkip { 0.0625 }
    %% Issue #176: these tokens own the complete list edge. Until #176 the
    %% lists also inherited LaTeX's `\partopsep' -- 3 pt plus stretch that no
    %% token owned and that did not rescale -- so the rendered edge was 4.5 pt at
    %% 10pt, 4.7 pt at 11pt, and 4.81 pt at 12pt: an effective ratio drifting
    %% from 0.375 down to 0.332 of a line as the body size grew. The lists now
    %% set `partopsep = 0pt' and this ratio absorbs the 3 pt, so the same edge
    %% is reproduced and rescales properly.
    %%
    %% Issue #191: the edge above a list and the edge below it are separate
    %% tokens, because LaTeX's `\list' offers only one `topsep' for both and so
    %% could not express a different value at the two ends. The split shipped
    %% as a mechanism change alone, both ratios at the single value #176
    %% calibrated.
    %%
    %% Issue #206 gave them the asymmetry the split exists for: a bullet list
    %% belongs to the entry above it, so it sits closer to that entry than to
    %% the next one. Measured on the résumé at 11 pt, 2.30 pt above the list
    %% against 4.99 pt below -- 2.17:1.
    %%
    %% The opening edge is not a free choice. 0.25 is a hard floor imposed by
    %% Poppler's reading order, not by this design: below it the entry head's
    %% date column extracts after the bullets. The column extracts with its
    %% entry at 0.25 and reorders at 0.1875, identically for the résumé and CV
    %% at 10pt, 11pt, and 12pt, so all of the asymmetry has to come from the
    %% closing edge. See the block comment in careerdossier-components.sty,
    %% `tokens-invariants', the `*-entry-dates-*' extraction fixtures, and
    %% docs/ATS-EXTRACTION.md 3.4.
    \__cdossier_tokens_set_skip:Nn \CDossierRecordListEdgeAboveSkip { 0.25 }
    \__cdossier_tokens_set_skip:Nn \CDossierRecordListEdgeBelowSkip { 0.50 }
    \__cdossier_tokens_set_skip:Nn \CDossierRecordItemSepSkip { 0.00 }
    \__cdossier_tokens_set_skip:Nn \CDossierRecordParSkip { 0.00 }
    \__cdossier_tokens_set_skip:Nn \CDossierProseParSkip { 0.25 }
    %% Issue #222: \CDossierProseParSkip set \parskip for both the letter and
    %% the statement, but the statement's heading below-tokens must stay
    %% strictly greater than it (see the comment above), while the letter has
    %% no heading scale to bound it and would prefer a more generous gap
    %% between its unindented block paragraphs. Splitting the token per family
    %% lets either retune independently; both shipped at the same 0.50 value,
    %% so the split itself was mechanism-only. Issue #206 then tightened both
    %% to 0.25 -- still equal, but now by measurement rather than by the split's
    %% starting condition, and either may move alone from here.
    \__cdossier_tokens_set_skip:Nn \CDossierLetterParSkip { 0.25 }
    %% Issue #204: the recipient block prints one field per line and separated
    %% them with a bare `\\', so the only vertical distance in the letter that no
    %% token expressed was the one inside its most structured block. 0.00
    %% reproduces the plain `\baselineskip' the bare `\\' gave.
    \__cdossier_tokens_set_skip:Nn \CDossierLetterRecipientLineGapSkip { 0.00 }
    \__cdossier_tokens_set_skip:Nn \CDossierLetterBlockSkip { 0.50 }
    %% Issue #204: the letter body's two edges are a pair, and naming only the
    %% opening one left the closing one borrowing \CDossierLetterBlockSkip -- a
    %% token for the boundaries *between* letterhead blocks, not for the body.
    %% The pair shipped at that borrowed value, which made it invisible: the
    %% salutation -> body gap was identical to the gap between two body
    %% paragraphs. Issue #206 lifted it clear of both, so the body now reads as
    %% a framed block. The two must stay equal -- the frame is symmetric
    %% because the body is bounded by peers, not opened by a heading.
    \__cdossier_tokens_set_skip:Nn \CDossierLetterBodyAboveSkip { 0.625 }
    \__cdossier_tokens_set_skip:Nn \CDossierLetterBodyBelowSkip { 0.625 }
    \__cdossier_tokens_set_skip:Nn \CDossierLetterSignatureGapSkip { 2.00 }
  }

\__cdossier_tokens_resolve:

%% url/nolinkurl uses LaTeX's math machinery internally. The 12pt document
%% classes therefore need an explicit math-size mapping when the identity
%% contact line selects the calibrated 11pt small size; without one, LaTeX
%% derives a 5.5pt scriptscript size that the standard math fonts do not
%% provide and emits font-substitution warnings. Keep this type-scale detail
%% here with the other literal size decisions.
\DeclareMathSizes { 11 } { 11 } { 8 } { 6 }

%% Reuse article's own \normalsize setup so its display skips remain tied to
%% the selected class option, then pin the font itself to the resolved whole
%% point size and calibrated leading. No catcode changes occur at call time.
%%
%% Issue #242: this is class-to-package plumbing, not an author command. It
%% transports a resolved load-time option -- \l__cdossier_tokens_fontsize_tl,
%% which is package-private -- into \normalsize, so a document body cannot
%% call it usefully and re-calling it changes nothing. It was named
%% \CDossierApplyBodySize; see docs/MIGRATION.md.
\cs_new_protected:Npn \__cdossier_tokens_apply_body_size:
  {
    \str_if_eq:VnTF \l__cdossier_tokens_fontsize_tl { 11pt }
      {
        \cs_set_protected:Npn \normalsize
          {
            \__cdossier_tokens_article_normalsize:
            \fontsize { \CDossierBodySize } { \CDossierBodyLeading } \selectfont
          }
      }
      { \cs_set_eq:NN \normalsize \__cdossier_tokens_article_normalsize: }
    \normalsize
  }

%% The paper name remains a class concern. The shared primitive is the only
%% place that translates the public normal/narrow preset into geometry options.
%%
%% Issue #242: the name was \CDossierApplyGeometry:n, the one name in the
%% codebase that mixed the public CDossier prefix with an expl3 argument
%% signature. It is plumbing either way -- its argument is the paper name only
%% the calling class knows, and geometry is applied once at load -- so it takes
%% the private form the signature already implied. See docs/MIGRATION.md.
%%
%% Issue #183: the running header and the folio are placed by this module too,
%% because their position is a function of the resolved margin. Until #183 the
%% three furniture dimensions kept `geometry''s untouched defaults --
%% \headheight 12pt, \headsep 25pt, \footskip 30pt -- identical at every
%% fontsize x margin combination. At margin=narrow (0.5in = 36pt) that put the
%% header 1pt *above* the paper edge and the folio 6pt below the text block's
%% bottom margin edge, inside most printers' unprintable region.
%%
%% `margin' measures paper edge to text block, and the head and foot are not
%% included in the text block (no `includehead'/`includefoot'), so both live
%% inside the margin M and \textheight/\textwidth are unaffected by the three
%% values set here.
%%
%% Both distances resolve to a *baseline* position, not to a box edge, so both
%% have to account for the asymmetry of a line box. The kernel's own strut
%% divides a line into 0.7 height and 0.3 depth; for a furniture line of height
%% H, centring the line in a margin M puts its baseline 0.7H past the top of
%% the centred line box, that is (M - H) / 2 + 0.7 H = M / 2 + 0.2 H from the
%% margin's outer edge.
%%
%% Foot. \footskip is measured from the bottom of the text block to the foot
%% baseline, and the text block's bottom edge is the margin's inner edge:
%%
%%     \footskip = M / 2 + 0.2 * H
%%
%% Header. \headsep is likewise measured from the head box to the text block,
%% so it too runs from the margin's *inner* edge -- but the kernel builds the
%% head as \vbox to \headheight {\vfil <head>} with the depth then forced to
%% zero (see \@outputpage in latex.ltx), which pins the head *baseline* to the
%% bottom edge of the \headheight box. \headsep is therefore the distance from
%% the head baseline to the text block, and mirrors \footskip about the
%% margin's midpoint:
%%
%%     \headsep = M / 2 - 0.2 * H
%%
%% Deriving \headsep from the box edge instead -- (M - \headheight) / 2, which
%% centres the head *box* rather than the line inside it -- measures 2.05 pt
%% low at 11pt and 2.77 pt low at 10pt against the rendered ink, and breaks the
%% top-to-bottom mirror symmetry with the folio.
%%
%% \headheight does not affect where the header renders -- the baseline is
%% \headsep above the text block whatever the box height -- but it must be tall
%% enough to contain the furniture line, or `geometry' warns that the head box
%% is too small and the ink can overrun the box it is nominally inside. The
%% furniture leading is that height by construction; `geometry''s fixed 12pt is
%% short of the 12pt line at fontsize=12pt once the line's depth is counted.
\cs_new_protected:Npn \__cdossier_tokens_apply_geometry:n #1
  {
    \geometry
      {
        #1 ,
        margin = \CDossierPageMargin ,
        headheight = \CDossierFurnitureLeading ,
        headsep =
          \fp_to_dim:n
            {
              \dim_to_fp:n { \CDossierPageMargin } / 2
              - 0.2 * \dim_to_fp:n { \CDossierFurnitureLeading }
            } ,
        footskip =
          \fp_to_dim:n
            {
              \dim_to_fp:n { \CDossierPageMargin } / 2
              + 0.2 * \dim_to_fp:n { \CDossierFurnitureLeading }
            }
      }
  }

%% Apply the typographic page-break penalties. Each class calls this after
%% setting up the document and optionally adjusting the penalty tokens for
%% the document family (e.g., CDossierClubPenalty and CDossierWidowPenalty
%% to 4000 for continuous-prose documents).
\NewDocumentCommand \CDossierApplyPageBreakPenalties { }
  {
    \brokenpenalty = \CDossierBrokenPenalty
    \clubpenalty = \CDossierClubPenalty
    \widowpenalty = \CDossierWidowPenalty
  }

\endinput
