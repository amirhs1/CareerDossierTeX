%% careerdossier-tokens is the single source of truth for the calibrated type
%% scale, baseline-derived vertical rhythm, rule and list metrics, and the two
%% supported page-margin presets. It owns no colour, fonts, semantic roles, or
%% rendered components.

\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesExplPackage {careerdossier-tokens} {2026-07-28} {0.6.0}
  {CareerDossierTeX calibrated design tokens}

\RequirePackage { l3keys2e }
\RequirePackage { geometry }

\tl_new:N \l__cdossier_tokens_fontsize_tl
\tl_set:Nn \l__cdossier_tokens_fontsize_tl { 12pt }
\tl_new:N \l__cdossier_tokens_margin_tl
\tl_set:Nn \l__cdossier_tokens_margin_tl { normal }

\msg_new:nnnn { careerdossier-tokens } { unknown-option }
  { Unknown~package~option~'#1'~for~careerdossier-tokens. }
  {
    Supported~options~are~'fontsize'~(10pt,~11pt,~12pt)~and~
    'margin'~(normal,~narrow).
  }

\keys_define:nn { cdossier / tokens }
  {
    fontsize .choices:nn =
      { 10pt , 11pt , 12pt }
      { \tl_set_eq:NN \l__cdossier_tokens_fontsize_tl \l_keys_choice_tl } ,
    fontsize .value_required:n = true ,
    margin .choices:nn =
      { normal , narrow }
      { \tl_set_eq:NN \l__cdossier_tokens_margin_tl \l_keys_choice_tl } ,
    margin .value_required:n = true ,
    unknown .code:n =
      {
        \msg_error:nnx { careerdossier-tokens } { unknown-option }
          { \l_keys_key_str }
      } ,
  }
\ProcessKeysOptions { cdossier / tokens }

%% Resolved base metrics. Keep one public token for body size and one for body
%% leading: duplicate aliases make it unclear which value downstream modules
%% should consume.
\dim_new:N \CDossierBodySize
\dim_new:N \CDossierBodyLeading
\dim_new:N \CDossierPageMargin
\dim_new:N \CDossierRuleThickness
\dim_new:N \CDossierListLabelSep

%% Keep-together penalties (issue #145). Entry-structured documents (résumé,
%% CV) state their page-break policy as named, tokenised penalties rather than
%% bare \nobreak calls, so the policy is visible and independently tunable.
%% Continuous-prose documents (letter, statement) are unaffected and keep
%% ordinary \widowpenalty/\clubpenalty handling.
%%
%% CDossierHeadingKeepPenalty is a hard \nobreak-strength value (10000). It
%% guards the boundaries that must never be broken: a section heading and its
%% rule, an entry heading's own two lines, and the two list boundaries that
%% would leave a single bullet stranded. Each spans a bounded amount of
%% material, so forbidding the break cannot overflow a page.
%%
%% CDossierListOrphanPenalty guards every interior list boundary and is
%% deliberately below 10000, so a list longer than a page still breaks
%% somewhere in its middle instead of overflowing. Together the two values
%% mean an over-long list breaks, but never at a position that isolates one
%% item.
\int_new:N \CDossierHeadingKeepPenalty
\int_set:Nn \CDossierHeadingKeepPenalty { 10000 }
\int_new:N \CDossierListOrphanPenalty
\int_set:Nn \CDossierListOrphanPenalty { 9997 }

%% Typographic page-break penalties (issue #171). These control hyphenation
%% and paragraph-remnant breaks at page boundaries, complementing the
%% structural keep-together penalties above.
%%
%% CDossierBrokenPenalty discourages splitting a hyphenated word across a
%% page break. A value of 10000 forbids the break entirely.
%%
%% CDossierClubPenalty and CDossierWidowPenalty control single-line paragraph
%% remnants at the foot (club line) or top (widow line) of a page. All four
%% document families share the same forbidding value (10000) rather than a
%% lower value for the continuous-prose classes: measurement against the
%% committed letter fixtures showed a discount penalty (4000) still let a
%% one-line paragraph remnant through, while 10000 removed it with zero
%% overfull vboxes across every two-page fixture. This is safe because all
%% four classes are \raggedbottom, so forbidding club/widow breaks only closes
%% off the first and last line of a paragraph as break points — interior line
%% breaks remain available, so a page can still break inside an over-long
%% paragraph rather than overflow.
\int_new:N \CDossierBrokenPenalty
\int_set:Nn \CDossierBrokenPenalty { 10000 }
\int_new:N \CDossierClubPenalty
\int_set:Nn \CDossierClubPenalty { 10000 }
\int_new:N \CDossierWidowPenalty
\int_set:Nn \CDossierWidowPenalty { 10000 }

\skip_new:N \CDossierHeaderAboveSkip
\skip_new:N \CDossierHeaderNameGapSkip
\skip_new:N \CDossierHeaderMetaGapSkip
\skip_new:N \CDossierHeaderBelowSkip
\skip_new:N \CDossierSectionAboveSkip
\skip_new:N \CDossierSectionRuleSkip
\skip_new:N \CDossierSectionBelowSkip
\skip_new:N \CDossierProseSectionAboveSkip
\skip_new:N \CDossierProseSectionBelowSkip
\skip_new:N \CDossierProseSubsectionAboveSkip
\skip_new:N \CDossierProseSubsectionBelowSkip
\skip_new:N \CDossierEntryAboveSkip
\skip_new:N \CDossierEntryGapSkip
\skip_new:N \CDossierEntryBelowSkip
\skip_new:N \CDossierListEdgeSkip
\skip_new:N \CDossierItemSepSkip
\skip_new:N \CDossierParSkip
\skip_new:N \CDossierProseParSkip
\skip_new:N \CDossierAfterHeaderBlockSkip
\skip_new:N \CDossierBlockSkip
\skip_new:N \CDossierAfterSalutationSkip
\skip_new:N \CDossierSignatureSkip

\cs_new_eq:NN \__cdossier_tokens_article_normalsize: \normalsize

\cs_new_protected:Npn \__cdossier_tokens_set_size_command:Nnn #1#2#3
  {
    \cs_set_protected:Npn #1
      { \fontsize {#2} {#3} \selectfont }
  }

\cs_new_protected:Npn \__cdossier_tokens_set_skip:Nn #1#2
  {
    \skip_set:Nn #1
      {
        \fp_to_dim:n
          { (#2) * \dim_to_fp:n { \CDossierBodyLeading } }
      }
  }

\cs_new_protected:Npn \__cdossier_tokens_resolve:
  {
    \str_case:Vn \l__cdossier_tokens_fontsize_tl
      {
        { 10pt }
          {
            \dim_set:Nn \CDossierBodySize { 10pt }
            \dim_set:Nn \CDossierBodyLeading { 12pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeName { 19pt } { 21pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeTitle { 15pt } { 17pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeHeadline { 12pt } { 14pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeSection { 11pt } { 13pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeBody { 10pt } { 12pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeSmall { 9pt } { 11pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeFurniture { 8pt } { 10pt }
          }
        { 11pt }
          {
            \dim_set:Nn \CDossierBodySize { 11pt }
            \dim_set:Nn \CDossierBodyLeading { 13.6pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeName { 21pt } { 23pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeTitle { 16pt } { 18pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeHeadline { 13pt } { 15pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeSection { 12pt } { 14pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeBody { 11pt } { 13.6pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeSmall { 10pt } { 12pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeFurniture { 9pt } { 11pt }
          }
        { 12pt }
          {
            \dim_set:Nn \CDossierBodySize { 12pt }
            \dim_set:Nn \CDossierBodyLeading { 14.5pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeName { 23pt } { 25pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeTitle { 18pt } { 20pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeHeadline { 14pt } { 16pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeSection { 13pt } { 15pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeBody { 12pt } { 14.5pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeSmall { 11pt } { 13pt }
            \__cdossier_tokens_set_size_command:Nnn
              \CDossierSizeFurniture { 10pt } { 12pt }
          }
      }

    \str_case:Vn \l__cdossier_tokens_margin_tl
      {
        { normal } { \dim_set:Nn \CDossierPageMargin { 1in } }
        { narrow } { \dim_set:Nn \CDossierPageMargin { 0.5in } }
      }

    \dim_set:Nn \CDossierRuleThickness
      {
        \fp_to_dim:n
          { 0.04 * \dim_to_fp:n { \CDossierBodySize } }
      }
    %% enumitem must receive a literal `leftmargin = *`; it does not expand a
    %% macro before testing for the star. LaTeX Lab's tagged-list emulation
    %% instead requires an explicit dimension, which the rendering class
    %% derives from the bullet width plus this shared label separation.
    \dim_set:Nn \CDossierListLabelSep
      {
        \fp_to_dim:n
          { 0.5 * \dim_to_fp:n { \CDossierBodySize } }
      }

    \__cdossier_tokens_set_skip:Nn \CDossierHeaderAboveSkip { 0.00 }
    \__cdossier_tokens_set_skip:Nn \CDossierHeaderNameGapSkip { 0.25 }
    \__cdossier_tokens_set_skip:Nn \CDossierHeaderMetaGapSkip { 0.1875 }
    \__cdossier_tokens_set_skip:Nn \CDossierHeaderBelowSkip { 0.8125 }
    \__cdossier_tokens_set_skip:Nn \CDossierSectionAboveSkip { 0.6875 }
    %% Issue #169: measured from the section heading's baseline, not from the
    %% bottom of its line box. The value has a hard lower bound -- the heading's
    %% depth, about 0.20 line at every supported size -- because a smaller
    %% offset would draw the rule through descender ink. 0.3125 leaves 1.63 pt
    %% of clearance at 11 pt and sits between the two distances it replaces
    %% (2.28 pt under a heading without descenders, 4.80 pt under one with).
    %% It is also the smallest sixteenth that clears the descender, so the
    %% normalized scale keeps it rather than moving to a smaller grid step.
    \__cdossier_tokens_set_skip:Nn \CDossierSectionRuleSkip { 0.3125 }
    \__cdossier_tokens_set_skip:Nn \CDossierSectionBelowSkip { 0.375 }
    %% Issue #177: the heading rhythm of a continuous-prose document -- today
    %% the statement class, the only one with headings and prose paragraph
    %% spacing at once. It cannot reuse the four tokens above, which are
    %% calibrated for a ruled
    %% heading in a document whose paragraphs are separated by nothing
    %% (\CDossierParSkip is 0). A prose statement separates its paragraphs by
    %% \CDossierProseParSkip (0.50), so a heading gap must first exceed that
    %% before it separates anything at all: at 0.375 the space opening a
    %% section would be *narrower* than the space between two paragraphs of
    %% one section.
    %%
    %% The pair is therefore stated against the paragraph gap: 1.50 above is
    %% three times it, 0.75 below is one and a half times it, and the 2:1
    %% ratio between them binds a heading to the text it introduces rather
    %% than leaving it floating between two blocks. The subsection pair keeps
    %% that shape one step down (1.00 / 0.625): still clear of the paragraph
    %% gap, but unambiguously tighter than the section it sits inside.
    %%
    %% Each of these four owns the complete gap, including the \parskip the
    %% adjacent paragraph contributes; see the sectioning block in
    %% careerdossier-statement.cls for how that is arranged and why the two
    %% below-tokens must stay strictly greater than \CDossierProseParSkip.
    \__cdossier_tokens_set_skip:Nn \CDossierProseSectionAboveSkip { 1.50 }
    \__cdossier_tokens_set_skip:Nn \CDossierProseSectionBelowSkip { 0.75 }
    \__cdossier_tokens_set_skip:Nn \CDossierProseSubsectionAboveSkip { 1.00 }
    \__cdossier_tokens_set_skip:Nn \CDossierProseSubsectionBelowSkip { 0.625 }
    \__cdossier_tokens_set_skip:Nn \CDossierEntryAboveSkip { 0.25 }
    \__cdossier_tokens_set_skip:Nn \CDossierEntryGapSkip { 0.0625 }
    \__cdossier_tokens_set_skip:Nn \CDossierEntryBelowSkip { 0.125 }
    %% Issue #176: this token now owns the complete list edge. Until #176 the
    %% lists also inherited LaTeX's `\partopsep' -- 3 pt plus stretch that no
    %% token owned and that did not rescale -- so the rendered edge was 4.5 pt at
    %% 10pt, 4.7 pt at 11pt, and 4.81 pt at 12pt: an effective ratio drifting
    %% from 0.375 down to 0.332 of a line as the body size grew. The lists now
    %% set `partopsep = 0pt' and this ratio absorbs the 3 pt, so the same edge
    %% is reproduced (3.75 / 4.25 / 4.53 pt) and rescales properly. 0.3125 is
    %% the sixteenth nearest that drifting ratio that also keeps the list edge
    %% below \CDossierSectionBelowSkip (0.375); at 0.375 a list edge would read
    %% as wide as the gap that opens a section.
    \__cdossier_tokens_set_skip:Nn \CDossierListEdgeSkip { 0.3125 }
    \__cdossier_tokens_set_skip:Nn \CDossierItemSepSkip { 0.00 }
    \__cdossier_tokens_set_skip:Nn \CDossierParSkip { 0.00 }
    \__cdossier_tokens_set_skip:Nn \CDossierProseParSkip { 0.50 }
    \__cdossier_tokens_set_skip:Nn \CDossierAfterHeaderBlockSkip { 0.75 }
    \__cdossier_tokens_set_skip:Nn \CDossierBlockSkip { 0.50 }
    \__cdossier_tokens_set_skip:Nn \CDossierAfterSalutationSkip { 0.50 }
    \__cdossier_tokens_set_skip:Nn \CDossierSignatureSkip { 2.25 }
  }

\__cdossier_tokens_resolve:

%% url/nolinkurl uses LaTeX's math machinery internally. The 12pt document
%% classes therefore need an explicit math-size mapping when the identity
%% contact line selects the calibrated 11pt small size; without one, LaTeX
%% derives a 5.5pt scriptscript size that the standard math fonts do not
%% provide and emits font-substitution warnings. Keep this type-scale detail
%% here with the other literal size decisions.
\DeclareMathSizes { 11 } { 11 } { 8 } { 6 }

%% Reuse article's own \normalsize setup so its display skips remain tied to
%% the selected class option, then pin the font itself to the resolved whole
%% point size and calibrated leading. No catcode changes occur at call time.
\NewDocumentCommand \CDossierApplyBodySize { }
  {
    \str_if_eq:VnTF \l__cdossier_tokens_fontsize_tl { 11pt }
      {
        \cs_set_protected:Npn \normalsize
          {
            \__cdossier_tokens_article_normalsize:
            \fontsize { \CDossierBodySize } { \CDossierBodyLeading } \selectfont
          }
      }
      { \cs_set_eq:NN \normalsize \__cdossier_tokens_article_normalsize: }
    \normalsize
  }

%% The paper name remains a class concern. The shared primitive is the only
%% place that translates the public normal/narrow preset into geometry options.
\cs_new_protected:Npn \CDossierApplyGeometry:n #1
  {
    \geometry
      {
        #1 ,
        margin = \CDossierPageMargin
      }
  }

%% Apply the typographic page-break penalties. Each class calls this after
%% setting up the document and optionally adjusting the penalty tokens for
%% the document family (e.g., CDossierClubPenalty and CDossierWidowPenalty
%% to 4000 for continuous-prose documents).
\NewDocumentCommand \CDossierApplyPageBreakPenalties { }
  {
    \brokenpenalty = \CDossierBrokenPenalty
    \clubpenalty = \CDossierClubPenalty
    \widowpenalty = \CDossierWidowPenalty
  }

\endinput
