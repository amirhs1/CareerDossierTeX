%% careerdossier-typography owns the LuaLaTeX engine check, fontspec loading,
%% the portable default fonts, and the semantic text roles. It carries no
%% colour (see careerdossier-theme) and no page geometry (see the classes).
%%
%% Responsibilities: require LuaLaTeX and fail fatally under any other engine;
%% load fontspec; select the portable default fonts and the opt-in sans body
%% family, both from a normal TeX Live installation, bundling neither; own the
%% cross-class bodyfont=serif|sans selection each class forwards; define the six
%% semantic styles -- name, headline, section, entry title, letter subject, and
%% body -- with the subject and entry-title roles defined independently (#299)
%% so a change to one cannot move the other; render a display heading at a
%% caller-supplied depth (#267) and, when tagged, record its plain text as the
%% element's title; open the Sect division that heading introduces (#268) using
%% the kernel's own sec/begin and sec/end sockets and section stack, so a
%% sibling heading closes the previous division; apply the Latin
%% ligature-suppression and lining-numbers defaults; resolve fonts by file name
%% through luaotfload so the build depends on the TeX Live font tree rather than
%% on OS-installed fonts; and record the tested font version.
%%
%% A style command names meaning (\CDossierSectionStyle), never an
%% implementation (\Large\bfseries).

\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesExplPackage {careerdossier-typography} {2026-08-12} {0.8.0}
  {CareerDossierTeX LuaLaTeX engine guard, portable fonts, and semantic text roles}

%% ---------------------------------------------------------------------------
%% Engine guard: LuaLaTeX only. Fail early and clearly.
%% ---------------------------------------------------------------------------
\msg_new:nnn { careerdossier-typography } { engine }
  {
    CareerDossierTeX~requires~LuaLaTeX. \\
    Compile~with~lualatex,~not~xelatex~or~pdflatex.
  }
\sys_if_engine_luatex:F
  { \msg_fatal:nn { careerdossier-typography } { engine } }

%% ---------------------------------------------------------------------------
%% Package option forwarded by every public document class.  The classes own
%% their public option surfaces and reject unsupported values; this package
%% owns the resulting font selection.  Direct package users receive the same
%% validation contract.
%% ---------------------------------------------------------------------------
\RequirePackage { l3keys2e }

\tl_new:N \l__cdossier_typography_bodyfont_tl
\tl_set:Nn \l__cdossier_typography_bodyfont_tl { serif }

\msg_new:nnnn { careerdossier-typography } { unknown-option }
  { Unknown~package~option~'#1'~for~careerdossier-typography. }
  { Supported~options~are~'bodyfont'~(serif,~sans). }

%% l3keys' own choice error reports that the value is not one of a fixed set
%% without saying what that set is, so the accepted values are named here. A
%% class forwards an already-validated value, so this message is reached only
%% by a direct \usepackage; the contract is the same either way.
\msg_new:nnnn { careerdossier-typography } { unknown-bodyfont }
  { Unknown~'bodyfont'~value~'#1'~for~careerdossier-typography. }
  {
    The~accepted~values~are~'serif'~(TeX~Gyre~Termes~body)~and~
    'sans'~(TeX~Gyre~Heros~body).
  }

\keys_define:nn { cdossier / typography }
  {
    bodyfont .choices:nn =
      { serif , sans }
      { \tl_set_eq:NN \l__cdossier_typography_bodyfont_tl \l_keys_choice_tl } ,
    bodyfont / unknown .code:n =
      { \msg_error:nnn { careerdossier-typography } { unknown-bodyfont } {#1} } ,
    bodyfont .value_required:n = true ,
    unknown .code:n =
      { \msg_error:nnx { careerdossier-typography } { unknown-option }
          { \l_keys_key_str } } ,
  }
\ProcessKeysPackageOptions { cdossier / typography }

%% ---------------------------------------------------------------------------
%% LuaHBTeX emits real interword spaces in the PDF text layer, so this package
%% needs no engine-specific ActualText workaround. Optional ligatures and
%% alternates remain disabled below to keep glyph-to-Unicode mapping simple.
%% ---------------------------------------------------------------------------

%% ---------------------------------------------------------------------------
%% Fonts. Conservative Latin defaults: disable optional ligature and alternate
%% substitutions that can extract as Private Use Area characters, and use
%% lining figures. See the ATS guide,
%% "Ligatures and alternate glyphs".
%% ---------------------------------------------------------------------------
\RequirePackage { fontspec }

%% Use the `...Off' spellings, not `NoCommon', `NoContextual', and so on. Those
%% are the AAT (legacy macOS) convention rather than an older spelling of the
%% same thing: applied to an OpenType face they select nothing and disable
%% nothing, silently, so the substitutions this line exists to switch off stay
%% on. fontspec's manual, Table 11 ("Ligatures"), is the authority for which
%% spelling a given face takes; verify against the installed version.
%%
%% Not listed here, and deliberately: `Ligatures=TeX' (OpenType `tlig') maps
%% TeX-style input for quotes and dashes and is the modern spelling of
%% `Mapping=tex-text'. It is unrelated to the `fi'-class ligatures above, and
%% stays enabled -- tests/regression/typography-bodyfont.tlg pins `+tlig' in the
%% resolved feature string alongside the four `-...' entries below.
\defaultfontfeatures+
  {
    Ligatures = { CommonOff , ContextualOff , DiscretionaryOff , HistoricOff } ,
    Numbers   = Lining ,
  }

%% Portable, freely redistributable TeX Live fonts, resolved by file name
%% through luaotfload so the build does not depend on OS-installed fonts. All
%% four faces are explicit.
%%   body / serif : TeX Gyre Termes (Times-like, default)
%%   body / sans  : TeX Gyre Heros (Helvetica-like, opt-in)
%%   headings     : TeX Gyre Heros in both modes
\setsansfont { texgyreheros }
  [
    Extension      = .otf ,
    UprightFont    = *-regular ,
    BoldFont       = *-bold ,
    ItalicFont     = *-italic ,
    BoldItalicFont = *-bolditalic ,
  ]
\str_if_eq:VnTF \l__cdossier_typography_bodyfont_tl { sans }
  {
    \setmainfont { texgyreheros }
      [
        Extension      = .otf ,
        UprightFont    = *-regular ,
        BoldFont       = *-bold ,
        ItalicFont     = *-italic ,
        BoldItalicFont = *-bolditalic ,
      ]
  }
  {
    \setmainfont { texgyretermes }
      [
        Extension      = .otf ,
        UprightFont    = *-regular ,
        BoldFont       = *-bold ,
        ItalicFont     = *-italic ,
        BoldItalicFont = *-bolditalic ,
      ]
  }

%% ---------------------------------------------------------------------------
%% Semantic text roles. These describe meaning, not a fixed size; the classes
%% add size and spacing. Colour is applied separately through the theme tokens.
%% ---------------------------------------------------------------------------
\NewDocumentCommand \CDossierNameStyle       { } { \sffamily \bfseries }
\NewDocumentCommand \CDossierHeadlineStyle   { } { \sffamily \mdseries }
\NewDocumentCommand \CDossierSectionStyle    { } { \sffamily \bfseries }
\NewDocumentCommand \CDossierEntryTitleStyle { } { \rmfamily \bfseries }
\NewDocumentCommand \CDossierSubjectStyle    { } { \rmfamily \bfseries }
\NewDocumentCommand \CDossierBodyStyle       { } { \rmfamily \normalfont }

%% Issue #299: \CDossierSubjectStyle and \CDossierEntryTitleStyle resolve to the
%% same shape, and that is deliberate rather than duplication. A letter's subject
%% line and a résumé entry's heading are two independent semantic decisions that
%% currently agree; either may change without the other, and a future retune of
%% entry headings must not silently restyle every letter. Do not factor one into
%% the other, and do not define either in terms of the other.

%% \CDossierMutedStyle is deliberately absent here (issue #271). De-emphasis is
%% configurable through `muted=italic|gray|both|plain', so the role may resolve
%% to a colour -- and this package owns no colour. It is defined once, complete,
%% by careerdossier-components, which is the module allowed to combine a shape
%% role from here with a theme token.

%% ---------------------------------------------------------------------------
%% Optional tagged-PDF helpers.  \DocumentMetadata{tagging=on} must be placed
%% before \documentclass, so these interfaces are deliberately dormant for an
%% ordinary build: the kernel's inactive tagging branch renders only its input.
%% They use the supported kernel/tagpdf interfaces only.
%% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__cdossier_typography_artifact:nn #1#2
  {
    \tag_if_active:TF
      {
        \tag_mc_artifact_group_begin:n {#1}
        #2
        \tag_mc_artifact_group_end:
      }
      { #2 }
  }
\cs_new_protected:Npn \__cdossier_typography_layout_artifact:n #1
  { \__cdossier_typography_artifact:nn { layout } {#1} }

%% Mark a leaf text run as real content.
%%
%% Automatic paragraph tagging only reaches material typeset in the main
%% vertical list. Text assembled inside a box that is measured before it is
%% shipped never passes through it, so the kernel emits it under the enclosing
%% artifact default and assistive technology is told to skip it. A hyperlink is
%% unaffected because hyperref opens its own structure element inside the box.
%%
%% Wrapping the run in its own text structure restores the paragraph role such
%% content carried before it was boxed, so a boxed value and an unboxed one
%% reach the structure tree the same way.
\cs_new_protected:Npn \__cdossier_typography_text_content:n #1
  {
    \tag_if_active:TF
      {
        \tag_struct_begin:n { tag = text }
        \tag_mc_begin:n { }
        #1
        \tag_mc_end:
        \tag_struct_end:
      }
      { #1 }
  }

%% Render a display heading with the class-provided visual formatting.  The
%% tagged branch temporarily disables automatic paragraph tagging so the line
%% becomes a heading structure directly, rather than a heading nested inside a
%% paragraph.  All commands used here are public kernel/tagpdf interfaces.
%%
%% Issue #267: the heading level is now a caller-supplied depth rather than a
%% hard-coded 1, because two things in a document can want a heading role and
%% they must not collide. `sec/<n>/title' is the kernel's own generic
%% structure name for a level-<n> sectioning title; its default role mapping
%% resolves depth 1 to `/H1', depth 2 to `/H2', and so on. Depth 1 is reserved
%% for the document identity (the name), so every other heading -- a résumé or
%% CV `\CDossierSection', a statement's title -- passes a depth of 2 or
%% deeper, keeping the identity the document's one and only `/H1' and the
%% heading hierarchy unskipped beneath it.
%%
%% Issue #268: the primitive also accepts the heading's plain title text, so a
%% caller that has it can record it as the heading element's `/T'. That is what
%% the kernel's own sectioning does -- `title-o' on the `sec/<n>/title'
%% element -- and it is what lets a consumer show the heading in a document
%% outline without re-reading the page. The text is purified first, because a
%% `/T' string carries no formatting and an unpurified argument would put font
%% and size commands into the PDF. An empty title omits the key entirely, so a
%% title that purifies away leaves no `/T' rather than an empty PDF string.
%%
%% Issue #268 kept a two-argument wrapper that passed no title, so that the
%% call sites it did not touch needed no edit. #305 gave the remaining three --
%% the document identity and the statement's title line -- their titles too,
%% which left the wrapper with no callers, so it is gone. Every heading in
%% every family now names itself.
%%
%% The title argument must be expandable. Purification expands what it can and
%% *discards* what it cannot, so a protected command is stripped while its
%% argument text survives: passing `\CDossierPrintField {name}' here recorded
%% the literal string `name'. Use `\CDossierFieldValue' or a token list.
\tl_new:N \l__cdossier_typography_heading_title_tl

\cs_new_protected:Npn \__cdossier_typography_heading:nnn #1#2#3
  {
    \tag_if_active:TF
      {
        \pdf_purify:nN { #2 } \l__cdossier_typography_heading_title_tl
        \UseTaggingSocket { para/off }
        \noindent
        \tl_if_empty:NTF \l__cdossier_typography_heading_title_tl
          { \tag_struct_begin:n { tag = \UseStructureName { sec/#1/title } } }
          {
            \tag_struct_begin:n
              {
                tag = \UseStructureName { sec/#1/title } ,
                title-o = { \l__cdossier_typography_heading_title_tl }
              }
          }
        \tag_mc_begin:n { }
        #3
        \tag_mc_end:
        \tag_struct_end:
        \par \nobreak
        \UseTaggingSocket { para/restore }
      }
      {
        \noindent #3
        \par \nobreak
      }
  }

%% ---------------------------------------------------------------------------
%% \__cdossier_typography_division_begin:n {depth} -- start the `Sect' division
%% that a heading at that depth introduces (issue #268).
%%
%% A heading element on its own says only "these words are a heading". It does
%% not say where the section it names begins or ends, so assistive technology
%% reading the structure tree finds every heading and every paragraph as flat
%% siblings, with nothing recording which content belongs to which heading.
%% The enclosing division is what carries that, and `careerdossier-statement.cls'
%% already had it for free by keeping the kernel's `\@startsection'. The record
%% classes render their headings through the primitive above instead, so they
%% have to open the division themselves.
%%
%% They open it through the kernel's own tagging sockets rather than a private
%% pair of `\tag_struct_begin:n'/`\tag_struct_end:' calls. The sockets keep the
%% kernel's section stack, so three things follow that hand-rolled calls would
%% each have had to reimplement: `sec/end' closes every division at this depth
%% or deeper before a sibling opens, a deeper heading nests inside its parent
%% instead of replacing it, and the divisions still open at the end of the
%% document are closed by the kernel's own `tagpdf/finish/before' hook. This is
%% also exactly the mechanism the statement gets from `\@startsection', so both
%% families produce the same shape.
%%
%% This emits no typeset material in either branch, so it cannot move a word;
%% callers still place it after their `\addvspace' so that no structure whatsit
%% can land between the skip and the vertical list it inspects.
%% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__cdossier_typography_division_begin:n #1
  {
    \tag_if_active:T
      {
        \UseTaggingSocket { sec/end } { #1 }
        \UseTaggingSocket { sec/begin } { { #1 } { } }
      }
  }
