% base-fields.lvt — careerdossier-base storage, trimming, and field access.
%
% Covers the happy-path metadata behavior of the base module: values are stored
% trimmed, a whitespace-only value is treated as missing, re-setting a field
% warns and overwrites, present/absent is reported correctly, and the raw value
% accessor expands to the stored value (or nothing when absent).
%
% The final block covers the `orcid' shape check (#331): each accepted
% form passes in silence, and each rejected one warns exactly once and is stored
% anyway. The helper is defined under \ExplSyntaxOn because catcodes cannot be
% switched inside a \TEST body, and it clears the field to empty (which removes
% it, without warning) before each fresh value, so re-using one field across
% cases raises no overwrite warnings. The saved baseline is the assertion that
% the silent cases are silent, so a missing warning line there is a failure and
% not an omission.
%
% The last block covers the `language' key (#288) the same way, with one
% difference its header states: a rejected tag is an error and is not stored.
\input{regression-test}
\documentclass{article}
\usepackage{careerdossier-base}

\ExplSyntaxOn
\cs_new_protected:Npn \cdossiertestOrcid #1
  {
    \CDossierSetup{ orcid = {} }
    \CDossierSetup{ orcid = {#1} }
    \TYPE{ [\CDossierFieldValue{orcid}] }
  }
\cs_new_protected:Npn \cdossiertestLanguage #1
  {
    \CDossierSetup{ language = {} }
    \CDossierSetup{ language = {#1} }
    \TYPE{ [\CDossierFieldValue{language}] }
  }
\ExplSyntaxOff

\begin{document}
\START

\TEST{store-trims-surrounding-space}{
  \CDossierSetup{ name = {   Ada Lovelace   } }
  \TYPE{[\CDossierFieldValue{name}]}
}

\TEST{whitespace-only-value-is-missing}{
  \CDossierSetup{ email = {    } }
  \CDossierIfFieldTF{email}{\TYPE{email-present}}{\TYPE{email-absent}}
}

\TEST{present-and-absent-fields}{
  \CDossierSetup{ location = {Toronto, ON} }
  \CDossierIfFieldTF{location}{\TYPE{location-present}}{\TYPE{location-absent}}
  \CDossierIfFieldTF{phone}{\TYPE{phone-present}}{\TYPE{phone-absent}}
}

\TEST{field-value-of-absent-is-empty}{
  \TYPE{[\CDossierFieldValue{phone}]}
}

\TEST{re-setting-a-field-warns-and-overwrites}{
  \CDossierSetup{ name = {Grace Hopper} }
  \TYPE{[\CDossierFieldValue{name}]}
}

\TEST{orcid-is-a-trimmed-shared-profile-field}{
  \CDossierSetup{ orcid = { 0000-0002-1825-0097 } }
  \CDossierIfFieldTF{orcid}{\TYPE{orcid-present}}{\TYPE{orcid-absent}}
  \TYPE{[\CDossierFieldValue{orcid}]}
}

\TEST{affiliation-is-a-trimmed-shared-profile-field}{
  \CDossierSetup{ affiliation = { Example University } }
  \CDossierIfFieldTF{affiliation}{\TYPE{affiliation-present}}{\TYPE{affiliation-absent}}
  \TYPE{[\CDossierFieldValue{affiliation}]}
}

\TEST{orcid-bare-identifier-is-accepted}{
  \cdossiertestOrcid{0000-0002-1825-0097}
}

\TEST{orcid-checksum-x-is-accepted}{
  \cdossiertestOrcid{0000-0002-1825-009X}
}

\TEST{orcid-resolver-url-is-accepted}{
  \cdossiertestOrcid{https://orcid.org/0000-0002-1825-0097}
}

\TEST{orcid-host-without-a-scheme-is-accepted}{
  \cdossiertestOrcid{orcid.org/0000-0002-1825-0097}
}

\TEST{orcid-truncated-identifier-warns-once}{
  \cdossiertestOrcid{0000-0002-1825-009}
}

\TEST{orcid-over-long-identifier-warns-once}{
  \cdossiertestOrcid{0000-0002-1825-009X7}
}

\TEST{orcid-non-orcid-url-warns-once}{
  \cdossiertestOrcid{https://example.org/ada-lovelace}
}

\TEST{orcid-value-from-another-key-warns-once}{
  \cdossiertestOrcid{scholar.google.com/citations?user=example}
}

% The `language' key (#288). The accepted shape is the rule the maintainer
% approved on 2026-11-06: a two- or three-letter language code, then any number
% of hyphen-separated subtags of one to eight letters or digits -- the
% well-formedness of a BCP 47 tag, without the IANA registry. Each accepted
% tag below is one RFC 5646 uses or permits (region, numeric region, script,
% variant), and passes in silence.
%
% A rejected value is an error, unlike `orcid', and is never recorded: each
% rejected case reports one error and then prints an empty value. The baseline
% is the assertion that the error appears once, not twice (#232), and that it
% names the accepted values (#212).
\TEST{language-primary-subtag-is-accepted}{
  \cdossiertestLanguage{en}
}

\TEST{language-region-subtag-is-accepted}{
  \cdossiertestLanguage{fr-CA}
}

\TEST{language-numeric-region-is-accepted}{
  \cdossiertestLanguage{es-419}
}

\TEST{language-script-and-region-are-accepted}{
  \cdossiertestLanguage{zh-Hant-TW}
}

\TEST{language-variant-subtag-is-accepted}{
  \cdossiertestLanguage{de-CH-1996}
}

\TEST{language-three-letter-code-is-accepted}{
  \cdossiertestLanguage{haw}
}

\TEST{language-is-a-trimmed-shared-profile-field}{
  \cdossiertestLanguage{ en-GB }
  \CDossierIfFieldTF{language}{\TYPE{language-present}}{\TYPE{language-absent}}
}

\TEST{language-name-is-rejected-once}{
  \cdossiertestLanguage{English}
}

\TEST{language-underscore-is-rejected-once}{
  \cdossiertestLanguage{en_GB}
}

\TEST{language-inner-space-is-rejected-once}{
  \cdossiertestLanguage{en GB}
}

\TEST{language-trailing-hyphen-is-rejected-once}{
  \cdossiertestLanguage{fr-}
}

\TEST{language-empty-subtag-is-rejected-once}{
  \cdossiertestLanguage{en--GB}
}

\TEST{language-one-letter-code-is-rejected-once}{
  \cdossiertestLanguage{e}
}

\TEST{language-over-long-subtag-is-rejected-once}{
  \cdossiertestLanguage{en-abcdefghi}
}

% A character that would end the catalog's /Lang string early.
\TEST{language-pdf-string-delimiter-is-rejected-once}{
  \cdossiertestLanguage{en)}
}

% A rejected value leaves the field as it was: no overwrite warning, and the
% earlier tag survives.
\TEST{language-rejected-value-keeps-the-previous-one}{
  \CDossierSetup{ language = {} }
  \CDossierSetup{ language = {fr-CA} }
  \CDossierSetup{ language = {French} }
  \TYPE{[\CDossierFieldValue{language}]}
}

\END
