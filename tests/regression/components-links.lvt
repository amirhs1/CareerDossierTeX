% components-links.lvt — careerdossier-components link targets.
%
% The visible contact text is checked by the extraction fixtures; pdftotext
% cannot see a link's href target, so the target normalization is checked here
% instead. Covers: web profiles gain an https:// scheme only when none is
% present, an existing scheme is preserved, email becomes a mailto: target,
% ORCID identifiers gain their canonical resolver URL, and the link wrapper
% degrades to plain visible text when hyperref is absent — announcing that
% degradation exactly once for the whole document (issue #329).
%
% The linkedin, github, and scholar cases (issue #330) pin the displayed text as
% well as the target, in the form `[display] -> [target]'. Normalization is
% visible, so those two must agree: a bare identifier is expanded to the
% service's canonical address for both, and every value already carrying a `/'
% or a `.' must come out byte-identical to what was written.
%
% Each helper is defined under \ExplSyntaxOn so the private names tokenize
% correctly; catcodes cannot be switched inside a \TEST body. A field is cleared
% to empty (which removes it, without warning) before each fresh value, so
% re-using one field across cases raises no overwrite warnings.
\input{regression-test}
\documentclass{article}
\usepackage{careerdossier-components}

\ExplSyntaxOn
\cs_new_protected:Npn \cdossiertestWebTarget #1
  {
    \CDossierSetup{ website = {} }
    \CDossierSetup{ website = {#1} }
    \__cdossier_components_web:n { website }
    \TYPE{ [\l__cdossier_components_url_tl] }
  }
\cs_new_protected:Npn \cdossiertestProfile #1#2
  {
    \CDossierSetup{ #1 = {} }
    \CDossierSetup{ #1 = {#2} }
    \__cdossier_components_web:n {#1}
    \TYPE{ [\l__cdossier_components_disp_tl] ~ -> ~ [\l__cdossier_components_url_tl] }
  }
\cs_new_protected:Npn \cdossiertestMailTarget #1
  {
    \CDossierSetup{ email = {} }
    \CDossierSetup{ email = {#1} }
    \__cdossier_components_mail:n { email }
    \TYPE{ [\l__cdossier_components_url_tl] }
  }
\cs_new_protected:Npn \cdossiertestOrcidTarget #1
  {
    \CDossierSetup{ orcid = {} }
    \CDossierSetup{ orcid = {#1} }
    \__cdossier_components_orcid:
    \TYPE{ [\l__cdossier_components_url_tl] }
  }
\cs_new_protected:Npn \cdossiertestHrefBranch
  {
    \cs_if_exist:NTF \href
      { \TYPE{ href-present } }
      { \TYPE{ degrades-to-plain-text } }
  }
%% Five linked fields plus one unlinked one, rendered through the real contact
%% line rather than through the individual helpers, so the number of warnings is
%% the number a document would actually see. Every field is cleared first, for
%% the reason given in the header: a second value over a live one warns about
%% the overwrite, and this helper is called twice.
\cs_new_protected:Npn \cdossiertestContactLine
  {
    \clist_map_inline:nn
      { email , location , website , linkedin , github , orcid }
      { \CDossierSetup{ ##1 = {} } }
    \CDossierSetup
      {
        email    = {ada@example.com} ,
        location = {Toronto} ,
        website  = {ada.example} ,
        linkedin = {ada-lovelace} ,
        github   = {ada-lovelace} ,
        orcid    = {0000-0002-1825-0097}
      }
    \__cdossier_components_contactline:
  }
\ExplSyntaxOff

\begin{document}
\START

%% Issue #329. The degradation is checked below; this is its signal, and the
%% property under test is that it appears exactly *once* per document however
%% many links degrade. So it is asserted first, on a contact line carrying five
%% linked fields at once — and every later test in this file renders a further
%% link with hyperref still absent, so the silence in each of their baselines is
%% the other half of the assertion. tests/regression/components-links-hyperref
%% holds the case where hyperref is present and nothing is said at all.
\TEST{links-inert-warns-once-for-a-multi-field-contact-line}{
  \cdossiertestContactLine
}

%% Still nothing on a second full contact line: the flag is global, so it
%% survives the group each contact item is boxed in and the \TEST group above.
\TEST{links-inert-is-not-repeated-by-a-later-contact-line}{
  \cdossiertestContactLine
  \cdossiertestHrefBranch
}

\TEST{web-gains-https-scheme-when-absent}{
  \cdossiertestWebTarget{github.com/ada}
}

\TEST{web-preserves-existing-scheme}{
  \cdossiertestWebTarget{http://ada.example}
}

\TEST{email-becomes-mailto-target}{
  \cdossiertestMailTarget{ada@example.com}
}

\TEST{orcid-identifier-gains-canonical-resolver-target}{
  \cdossiertestOrcidTarget{0000-0002-1825-0097}
}

\TEST{orcid-url-preserves-existing-scheme}{
  \cdossiertestOrcidTarget{https://orcid.org/0000-0002-1825-0097}
}

\TEST{link-degrades-without-hyperref}{
  \cdossiertestHrefBranch
}

%% Issue #330. Three input forms per key: the bare identifier, which is the one
%% that changes; the domain-qualified form every shipped profile uses; and the
%% fully written-out address. Only the first may differ from its input.
\TEST{linkedin-bare-handle-gains-canonical-address}{
  \cdossiertestProfile{linkedin}{ada-lovelace}
}

\TEST{linkedin-domain-qualified-value-unchanged}{
  \cdossiertestProfile{linkedin}{linkedin.com/in/ada-lovelace}
}

\TEST{linkedin-written-out-address-unchanged}{
  \cdossiertestProfile{linkedin}{https://www.linkedin.com/in/ada-lovelace/}
}

\TEST{github-bare-handle-gains-canonical-address}{
  \cdossiertestProfile{github}{ada-lovelace}
}

\TEST{github-domain-qualified-value-unchanged}{
  \cdossiertestProfile{github}{github.com/ada-lovelace}
}

\TEST{github-written-out-address-unchanged}{
  \cdossiertestProfile{github}{https://github.com/ada-lovelace}
}

\TEST{scholar-bare-identifier-gains-canonical-address}{
  \cdossiertestProfile{scholar}{kukA0LcAAAAJ}
}

\TEST{scholar-domain-qualified-value-unchanged}{
  \cdossiertestProfile{scholar}{scholar.google.com/citations?user=kukA0LcAAAAJ}
}

\TEST{scholar-written-out-address-unchanged}{
  \cdossiertestProfile{scholar}{https://scholar.google.com/citations?user=kukA0LcAAAAJ}
}

%% website has no canonical host, so it must keep taking the old path: the
%% displayed text stays as written even when it looks exactly like a handle.
\TEST{website-bare-value-is-not-canonicalized}{
  \cdossiertestProfile{website}{example}
}

\END
