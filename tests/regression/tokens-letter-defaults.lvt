% tokens-letter-defaults.lvt — letter class layout-input defaults; see support/tokens-defaults.inc.
\input{regression-test}
\documentclass{careerdossier-letter}
\ExplSyntaxOn
\NewDocumentCommand \cdossiertestClassDefaults { }
  {
    \TYPE{letter-par-skip = \skip_use:N \CDossierLetterParSkip}
    \TYPE{recipient-line-gap-skip =
      \skip_use:N \CDossierLetterRecipientLineGapSkip}
    \TYPE{block-skip = \skip_use:N \CDossierLetterBlockSkip}
    \TYPE{body-above-skip =
      \skip_use:N \CDossierLetterBodyAboveSkip}
    \TYPE{body-below-skip =
      \skip_use:N \CDossierLetterBodyBelowSkip}
    \TYPE{signature-skip = \skip_use:N \CDossierLetterSignatureGapSkip}
    \skip_if_eq:nnTF { \parskip } { \CDossierLetterParSkip }
      { \TYPE{paragraph-rhythm = shared} }
      { \TYPE{paragraph-rhythm = local} }
    \cs_if_exist:NTF \l__cdossier_letter_afterhead_skip
      { \TYPE{letter-local-skips = present} }
      { \TYPE{letter-local-skips = absent} }
  }
\ExplSyntaxOff
\input{tokens-defaults.inc}
