% components-furniture.lvt — shared page-furniture control flow.
%
% Rendered position and extraction are covered by the layout and tagging
% suites. This regression isolates the component-owned decisions: the
% auxiliary-file page total controls single-page suppression, both shared page
% styles exist, a class may register a live short-label token list, and the
% default output medium resolves to `print' and selects the furniture styles.
% The `screen' half of that last decision lives in components-medium.lvt,
% because a package can only be loaded with one set of options per document.
\input{regression-test}
\documentclass{article}
\usepackage{careerdossier-components}

%% The furniture primitive is an expl3 private name (issue #242), so the call
%% has to sit inside \ExplSyntaxOn: outside it the `_' is a subscript and the
%% name silently splits into \_ plus text, leaving the page styles unset.
\ExplSyntaxOn
\__cdossier_components_apply_page_furniture:

\tl_new:N \l__cdossiertest_runninglabel_tl

\cs_new_protected:Npn \cdossiertestSetLastPage #1
  { \cs_set:cpn { @abspage@last } {#1} }

\cs_new_protected:Npn \cdossiertestReportPageCount
  {
    \__cdossier_components_if_multipage:TF
      { \TYPE{multipage} }
      { \TYPE{single-page} }
  }

\cs_new_protected:Npn \cdossiertestReportStyles
  {
    \cs_if_exist:cTF { ps@cdossierfurniture }
      { \TYPE{main-style=defined} }
      { \TYPE{main-style=missing} }
    \cs_if_exist:cTF { ps@cdossierfurniturefirst }
      { \TYPE{first-style=defined} }
      { \TYPE{first-style=missing} }
  }

\cs_new_protected:Npn \cdossiertestReportRunningLabel
  { \TYPE{label=\l__cdossier_components_runninglabel_tl} }

%% The resolved output medium, and what
%% \__cdossier_components_apply_page_furniture: did with it.
%% \thispagestyle only records a name for shipout, so the head and foot read
%% here are the ones \pagestyle installed.
\cs_new_protected:Npn \cdossiertestReportMedium
  {
    \bool_if:NTF \l__cdossier_components_furniture_bool
      { \TYPE{medium=print} }
      { \TYPE{medium=screen} }
  }

\cs_new_protected:Npn \cdossiertestReportSelectedStyle
  {
    \tl_if_empty:cTF { @oddhead }
      { \TYPE{head=empty} }
      { \TYPE{head=furniture} }
    \tl_if_empty:cTF { @oddfoot }
      { \TYPE{foot=empty} }
      { \TYPE{foot=furniture} }
  }

\cs_new_protected:Npn \cdossiertestUpdateRunningLabel
  {
    \tl_set:Nn \l__cdossiertest_runninglabel_tl { First }
    \__cdossier_components_runninglabel:n
      { \tl_use:N \l__cdossiertest_runninglabel_tl }
    \tl_set:Nn \l__cdossiertest_runninglabel_tl { Updated }
  }

%% Issue #242 classified the furniture primitive as class-to-package plumbing
%% rather than a member of the author-facing \MakeCDossier... family, and
%% renamed it. Asserting only that the private name works would leave the
%% public one free to reappear, so both halves are pinned: the old name must be
%% undefined, not merely unused.
\cs_new_protected:Npn \cdossiertestReportNameSurface
  {
    \cs_if_exist:cTF { __cdossier_components_apply_page_furniture: }
      { \TYPE{private-page-furniture=defined} }
      { \TYPE{private-page-furniture=missing} }
    \cs_if_exist:cTF { MakeCDossierPageFurniture }
      { \TYPE{public-page-furniture=defined} }
      { \TYPE{public-page-furniture=undefined} }
  }
\ExplSyntaxOff

\begin{document}
\START

\TEST{one-page-total-suppresses-furniture}{
  \cdossiertestSetLastPage{1}
  \cdossiertestReportPageCount
}

\TEST{multi-page-total-enables-furniture}{
  \cdossiertestSetLastPage{2}
  \cdossiertestReportPageCount
}

\TEST{shared-page-styles-exist}{
  \cdossiertestReportStyles
}

\TEST{running-label-remains-live-until-shipout}{
  \cdossiertestUpdateRunningLabel
  \cdossiertestReportRunningLabel
}

\TEST{default-medium-is-print-and-selects-the-furniture-styles}{
  \cdossiertestReportMedium
  \cdossiertestReportSelectedStyle
}

\TEST{page-furniture-primitive-name-surface}{
  \cdossiertestReportNameSurface
}

\END
\end{document}
