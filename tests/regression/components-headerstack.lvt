% components-headerstack.lvt — issue #204 shared header-stack gap emission.
%
% The header stack must emit exactly one gap per boundary *between* two present
% header lines, never a leading gap attached to an optional block. Which token
% guards a boundary is decided by position, so the gap below the name stays
% \CDossierSharedHeaderNameGapSkip whether or not the optional `headline' below
% it is present. Before issue #204 that boundary silently fell back to
% \CDossierSharedHeaderMetaGapSkip when the headline was absent.
%
% The letter class is the fixture because it is the prose class that uses the
% shared header: it sets \parskip to \CDossierLetterParSkip document-wide, so the
% logged document-wide \parskip and the logged gaps together also assert the
% group-local zeroing of \parskip inside the stack (issue #220). Each emitted
% gap is logged in points, so the numbers are the assertion — a gap the stack
% fails to emit, emits twice, emits from the wrong token, or emits reduced by an
% un-zeroed \parskip all change the log.
%
% \addvspace is intercepted rather than the stack's own helper so the recorded
% sequence is what actually reaches the vertical list, including the boundary
% below the stack. The interception is local to each \TEST group.
\input{regression-test}
\documentclass{careerdossier-letter}
\CDossierSetup{
  name = {Ada Lovelace},
  email = {ada@example.com},
}

\ExplSyntaxOn
\cs_new_eq:NN \cdossiertest_addvspace:n \addvspace
\cs_new_protected:Npn \cdossiertest_trace_addvspace:
  {
    \cs_set_protected:Npn \addvspace ##1
      {
        \TYPE { addvspace~=~ \dim_eval:n {##1} }
        \cdossiertest_addvspace:n {##1}
      }
  }
\cs_new_protected:Npn \cdossiertest_tokens:
  {
    \TYPE { parskip~=~ \dim_eval:n { \parskip } }
    \TYPE { name-gap~=~ \dim_eval:n { \CDossierSharedHeaderNameGapSkip } }
    \TYPE { meta-gap~=~ \dim_eval:n { \CDossierSharedHeaderMetaGapSkip } }
    \TYPE { below~=~ \dim_eval:n { \CDossierLetterHeaderBelowSkip } }
  }
\NewDocumentCommand \cdossiertestTraceAddvspace { } { \cdossiertest_trace_addvspace: }
\NewDocumentCommand \cdossiertestTokens { } { \cdossiertest_tokens: }
% Issue #255: the composed height of the stack, for the tests that have to
% measure what reaches the page rather than what the stack claims. \ht + \dp so
% the last line's depth is not dropped.
\box_new:N \l_cdossiertest_box
\cs_new_protected:Npn \cdossiertest_boxheight:nn #1#2
  {
    \vbox_set:Nn \l_cdossiertest_box {#2}
    \TYPE
      {
        #1 ~ height~=~
        \dim_eval:n
          {
            \box_ht:N \l_cdossiertest_box + \box_dp:N \l_cdossiertest_box
          }
      }
  }
\NewDocumentCommand \cdossiertestBoxHeight { m +m }
  { \cdossiertest_boxheight:nn {#1} {#2} }
% Issue #224: a header line that announces when its body is executed. The
% announcement is what distinguishes "stored unexpanded and used once, in place"
% from "expanded at push time" or "used twice".
\NewDocumentCommand \cdossiertestMark { m }
  { \TYPE { line-body~ #1 } #1 }
\ExplSyntaxOff

\begin{document}
% Force the math-font loads that \nolinkurl triggers at the contact line's size
% before the first test, so the font-info lines land outside every \TEST group.
\setbox0=\hbox{\CDossierSizeSmall\nolinkurl{ada@example.com}}
\START

\TEST{header-gap-tokens}{
  \cdossiertestTokens
}

% Name, headline, contact line: two interior boundaries, then the boundary
% below the stack. \parskip contributes nothing to any of them.
\TEST{gaps-with-headline}{
  \CDossierSetup{headline = {Data Scientist}}
  \cdossiertestTraceAddvspace
  \MakeCDossierHeader
  \par
}

% Name, contact line. The single interior boundary is still the name gap, and
% the absent headline leaves no gap of its own behind.
\TEST{gaps-without-headline}{
  \CDossierSetup{headline = {}}
  \cdossiertestTraceAddvspace
  \MakeCDossierHeader
  \par
}

% Issue #223: the boundary below the stack is owned by the *letter's* token, not
% by a token shared with the record classes. All three families ship at one
% ratio, so equal values cannot tell them apart; the three tokens are given
% distinct, deliberately un-calibrated values here and the emitted gap names
% which one the class selected. Before the split this reported 44.0pt.
\TEST{below-token-is-the-letter-family-token}{
  \CDossierSetup{headline = {}}
  \setlength\CDossierLetterHeaderBelowSkip{33pt}
  \setlength\CDossierRecordHeaderBelowSkip{44pt}
  \setlength\CDossierProseHeaderBelowSkip{55pt}
  \cdossiertestTraceAddvspace
  \MakeCDossierHeader
  \par
}

% Issue #224: the stack is a public composition API, so a caller that is neither
% \MakeCDossierHeader nor \MakeCDossierStatementHeader gets the same contract.
% Position decides the token for an arbitrary line list too: the name gap guards
% the first boundary and the meta gap every later one, whatever the lines are.
\TEST{public-triple-emits-the-positional-gaps}{
  \setlength\CDossierLetterHeaderBelowSkip{33pt}
  \cdossiertestTraceAddvspace
  \CDossierHeaderBegin
  \CDossierHeaderLine{Alpha}
  \CDossierHeaderLine{Beta}
  \CDossierHeaderLine{Gamma}
  \CDossierHeaderEnd
  \par
}

% A line body is stored, not expanded at push time, and is executed exactly once
% where the stack places it. Every `line-body' announcement therefore lands
% *between* the traced gaps, in reading order — the statement's title line
% depends on this to keep the heading structure it wraps itself in. If
% \CDossierHeaderLine expanded its argument, all three would precede the first
% gap instead.
\TEST{public-line-body-is-deferred-and-used-once}{
  \cdossiertestTraceAddvspace
  \CDossierHeaderBegin
  \CDossierHeaderLine{\cdossiertestMark{Alpha}}
  \CDossierHeaderLine{\cdossiertestMark{Beta}}
  \CDossierHeaderEnd
  \par
}

% An empty stack renders nothing at all — no boundary below a header that has no
% lines. \CDossierHeaderBegin also clears whatever a previous group left behind,
% so the three lines pushed two tests above cannot reappear here.
\TEST{public-empty-stack-emits-nothing}{
  \cdossiertestTraceAddvspace
  \CDossierHeaderBegin
  \CDossierHeaderEnd
  \par
  \TYPE{empty-stack-done}
}

% Issue #255: every test above records the *claim* — the argument \addvspace was
% called with. A claim is not a rendered gap: \addvspace takes the maximum of
% the adjacent claims, so a token can be traced at every boundary it names and
% still contribute nothing to the page. That is the condition #204 exists to
% prevent, and it was found reproduced inside a fixture during #206.
%
% The three composed heights below are the rendering half of the contract, and
% they separate the three tokens because each stack has one more boundary than
% the one above it:
%
%   stack-one-line     one line + \CDossierLetterHeaderBelowSkip
%   header-two-lines   + one line + \CDossierSharedHeaderNameGapSkip
%   header-three-lines + one line + \CDossierSharedHeaderMetaGapSkip
%
% The letter class is what makes this worth measuring rather than deriving. Its
% \parskip is a visible 0.25 line, and the stack subtracts \parskip from every
% gap it emits and zeroes it for its own group (issue #220). If that isolation
% were lost, the traced claims above would not change at all and only these
% heights would move.
\TEST{stack-heights-are-the-rendered-gaps}{
  \CDossierSetup{headline = {}}
  \cdossiertestBoxHeight{stack-one-line}{
    \CDossierHeaderBegin
    \CDossierHeaderLine{Alpha}
    \CDossierHeaderEnd
  }
  \cdossiertestBoxHeight{header-two-lines}{\MakeCDossierHeader}
  \CDossierSetup{headline = {Data Scientist}}
  \cdossiertestBoxHeight{header-three-lines}{\MakeCDossierHeader}
}

\END
