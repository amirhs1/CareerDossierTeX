% resume-entry-edges.lvt — issue #204 entry and list boundary composition.
%
% Two contracts, both invisible in the token values alone.
%
% 1. The entry heading -> body gap is contributed with \addvspace, not \vspace.
%    A \vspace appends a zero glue after its own skip, so \lastskip is 0 when
%    the following block's \addvspace runs and the two *add*; as an \addvspace
%    the token is a floor the block's own edge maxes against. A bullet list
%    therefore opens at \CDossierRecordListEdgeAboveSkip rather than at
%    \CDossierRecordEntryGapSkip + \CDossierRecordListEdgeAboveSkip.
%
% 2. The entry contributes nothing when it closes. Its closing boundary is
%    owned by whatever opens next — \CDossierRecordEntryAboveSkip between two
%    entries, \CDossierRecordSectionAboveSkip at a section end. The retired
%    \CDossierRecordEntryBelowSkip claimed the boundary from the other side and
%    lost every maximum it entered.
%
% 3. \CDossierRecordEntryAboveSkip is only reachable between two entries that
%    carry no bullet list. Where an entry ends with a list, that boundary is
%    max(\CDossierRecordListEdgeBelowSkip, \CDossierRecordEntryAboveSkip) and
%    the list edge governs it; where an entry opens a section, it is
%    max(\CDossierRecordSectionBelowSkip, \CDossierRecordEntryAboveSkip) and
%    the section gap governs it. TEST 1 alone therefore reports the token's
%    value without ever rendering it, which is exactly the unreachable-token
%    condition issue #204 exists to prevent. TEST 3 supplies the missing shape
%    -- two bodiless entries, as the resume's Education and Certificates
%    sections are written -- so a change to the ratio moves a recorded number.
%
% \pagetotal is the assertion: it is the height of the page so far, so the
% difference across a boundary is the rendered gap, after the maxima have
% resolved. Tracing the skips instead would report the claims, not the result.
\input{regression-test}
\documentclass{careerdossier-resume}
\CDossierSetup{
  name = {Ada Lovelace},
  email = {ada@example.com},
}

\ExplSyntaxOn
\cs_new_protected:Npn \cdossiertest_mark:n #1
  { \par \TYPE { #1 ~ page-total~=~ \dim_eval:n { \pagetotal } } }
\cs_new_protected:Npn \cdossiertest_tokens:
  {
    \TYPE { section-above~=~ \dim_eval:n { \CDossierRecordSectionAboveSkip } }
    \TYPE { section-below~=~ \dim_eval:n { \CDossierRecordSectionBelowSkip } }
    \TYPE { entry-above~=~ \dim_eval:n { \CDossierRecordEntryAboveSkip } }
    \TYPE { entry-gap~=~ \dim_eval:n { \CDossierRecordEntryGapSkip } }
    \TYPE { list-edge-above~=~ \dim_eval:n { \CDossierRecordListEdgeAboveSkip } }
    \TYPE { list-edge-below~=~ \dim_eval:n { \CDossierRecordListEdgeBelowSkip } }
  }
\NewDocumentCommand \cdossiertestMark { m } { \cdossiertest_mark:n {#1} }
\NewDocumentCommand \cdossiertestTokens { } { \cdossiertest_tokens: }

%% Issue #332: the keep penalty itself, asserted rather than observed.
%%
%% \pagetotal cannot see a penalty -- it contributes 0pt -- so every assertion
%% above this point holds equally whether the penalty is emitted, misplaced, or
%% absent. That is precisely how a change that altered page-break legality
%% passed the whole regression suite.
%%
%% The probe reads the built vertical list itself rather than \lastpenalty. On
%% the main vertical list the page builder may already have migrated material
%% beyond \unpenalty's reach, and even inside a \vbox the penalty is not the
%% item \unskip uncovers: four glue items separate it from the body's first box,
%% so a \lastpenalty probe reports 0 whether the penalty is there or not.
%%
%% Consecutive glue collapses to a single `g' in the signature. The assertion is
%% where the penalty sits relative to the heading box and the body's first box;
%% freezing the glue count as well would make every spacing retune rewrite this
%% baseline for no gain, and the surrounding \pagetotal tests already own the
%% spacing.
\ExplSyntaxOff
\makeatletter
\newcommand\cdossiertestNodes[1]{%
  \TYPE{#1 nodes = \directlua{
    local t = {}
    local lastglue = false
    for n in node.traverse(tex.box[9].list) do
      if n.id == node.id("penalty") then
        table.insert(t, "P" .. n.penalty) lastglue = false
      elseif n.id == node.id("glue") then
        if not lastglue then table.insert(t, "g") end
        lastglue = true
      elseif n.id == node.id("hlist") then
        table.insert(t, "H") lastglue = false
      else
        table.insert(t, node.type(n.id)) lastglue = false
      end
    end
    tex.sprint(table.concat(t, " "))
  }}%
}

%% Issue #332: the consequence, counted. The signature above says where the
%% penalty sits; this says what that does to the page builder, which is the
%% property the issue is actually about.
%%
%% A vertical break is legal at glue whose predecessor is non-discardable, and
%% at a penalty below 10000. The issue's own evidence was a \tracingpages run,
%% but its `% t=' lines carry exact dimensions that every spacing retune would
%% rewrite; counting the breakpoints in a \vbox asserts the same property
%% without freezing a single measurement.
\newcommand\cdossiertestBreaks[1]{%
  \TYPE{#1 legal-breakpoints = \directlua{
    local legal = 0
    local prev = nil
    for n in node.traverse(tex.box[9].list) do
      if n.id == node.id("glue") then
        if prev ~= nil
           and prev.id ~= node.id("glue")
           and prev.id ~= node.id("penalty")
           and prev.id ~= node.id("kern") then
          legal = legal + 1
        end
      elseif n.id == node.id("penalty") then
        if n.penalty < 10000 then legal = legal + 1 end
      end
      prev = n
    end
    tex.sprint(legal)
  }}%
}
\makeatother

\begin{document}
\setbox0=\hbox{\CDossierSizeSmall\nolinkurl{ada@example.com}}
\START

% A section, an entry whose body opens with a bullet list, and a second entry.
% The marks bracket every boundary the two contracts above govern.
\TEST{entry-and-list-boundaries}{
  \CDossierSection{Experience}
  \cdossiertestMark{after-section-heading}
  \begin{CDossierEntry}[title = {Staff Engineer}]
    \cdossiertestMark{after-entry-heading}
    \begin{CDossierItemize}
      \item Shipped the thing.
    \end{CDossierItemize}
    \cdossiertestMark{after-list}
  \end{CDossierEntry}
  \cdossiertestMark{after-entry}
  \begin{CDossierEntry}[title = {Senior Engineer}]
    \cdossiertestMark{after-second-entry-heading}
    Prose body, no list.
  \end{CDossierEntry}
  \cdossiertestMark{after-second-entry}
}

% The tokens the marks above resolve, for reading the differences against.
\TEST{entry-and-list-tokens}{
  \cdossiertestTokens
}

% Two bodiless entries. The first sits against the section rule, so its opening
% boundary is \CDossierRecordSectionBelowSkip; the second sits against the
% first, so its opening boundary is \CDossierRecordEntryAboveSkip and nothing
% else claims it. Both entries are a single title line, so the two recorded
% differences are directly comparable and the second isolates the token.
\TEST{bare-entry-boundaries}{
  \CDossierSection{Education}
  \cdossiertestMark{after-education-heading}
  \begin{CDossierEntry}[title = {Ph.D. in Computer Science}]
  \end{CDossierEntry}
  \cdossiertestMark{after-first-bare-entry}
  \begin{CDossierEntry}[title = {M.Sc. in Software Engineering}]
  \end{CDossierEntry}
  \cdossiertestMark{after-second-bare-entry}
}

% Issue #255: \CDossierRecordItemSepSkip is the gap *between* two bullets, so a
% one-item list cannot render it — and TEST 1's list has one item, which is the
% same gap between reporting a token and rendering it that point 3 above
% describes. A two-item list is the missing shape, and it is the only one: the
% token reaches the page nowhere else in the record classes, and the only other
% place it is read at all is `\bibitemsep' in careerdossier-biblatex.
%
% The recorded difference across the list is two bullet lines, one item gap, and
% both list edges. It is the item gap that distinguishes it from TEST 1's
% single-item list, whose difference has no item gap in it at all.
\TEST{list-item-separation}{
  \CDossierSection{Skills}
  \begin{CDossierEntry}[title = {Tooling}]
    \cdossiertestMark{after-skills-entry-heading}
    \begin{CDossierItemize}
      \item First bullet.
      \item Second bullet.
    \end{CDossierItemize}
    \cdossiertestMark{after-two-item-list}
  \end{CDossierEntry}
}

% Issue #332: an entry with a body emits the keep penalty that binds its heading
% to that body's first line; an entry without one emits nothing, so the boundary
% after it stays a legal breakpoint. Probed at the two points where the answer
% differs -- at the start of the body, and after a bodiless entry has closed.
%
% The bodied probe reads 10000 and the bare probe reads 0. Deleting the penalty
% outright turns the first into 0, which is what makes an entry heading
% separable from a prose body; emitting it unconditionally turns the second into
% 10000, which is issue #332 itself. Neither failure is visible in \pagetotal.
\TEST{entry-keep-penalty}{
  \setbox9=\vbox{\begin{CDossierEntry}[title = {Bodied Entry}]Prose body, no
    list.\end{CDossierEntry}}
  \cdossiertestNodes{bodied}
  \setbox9=\vbox{\begin{CDossierEntry}[title = {Bare Entry}]\end{CDossierEntry}}
  \cdossiertestNodes{bare}
}

% Issue #332: a run of bodiless entries, as an Education or Certificates section
% is written. Every inter-entry boundary must remain a legal breakpoint. With the
% penalty emitted unconditionally the count collapses, because each leaked
% penalty sits immediately before the glue that would otherwise carry the break
% and the next entry's \addvspace collapses into that same glue rather than
% putting a box between them.
\TEST{bare-entry-breakpoints}{
  \setbox9=\vbox{%
    \begin{CDossierEntry}[title = {Ph.D. in Computer Science}]\end{CDossierEntry}%
    \begin{CDossierEntry}[title = {M.Sc. in Software Engineering}]\end{CDossierEntry}%
    \begin{CDossierEntry}[title = {B.A.Sc. in Computer Engineering}]\end{CDossierEntry}%
  }
  \cdossiertestBreaks{bare-run}
}

\END
