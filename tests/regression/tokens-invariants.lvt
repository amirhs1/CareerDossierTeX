% tokens-invariants.lvt — issue #204 vertical-boundary token invariants.
%
% Every vertical boundary is owned by exactly one token, and `\addvspace' takes
% the maximum of the adjacent claims. Which token therefore reaches the page at
% a shared boundary is decided by the *relative order* of the calibrated ratios,
% not by any one of them alone. These relations are that order, written down.
%
% The saved baseline is the assertion. Each relation reports `holds' or
% `violated', so a ratio change that silently makes a token unreachable — or
% that repairs one — shows up as a reviewable diff rather than as a token no
% document responds to. Issue #204 fixed the mechanism that made several of
% these expressible at all; issue #206 assigns the ratios that satisfy them.
%
% Several relations are therefore recorded as `violated' at the committed
% defaults. That is deliberate and is the point of committing this test before
% the retune rather than with it: the baseline states exactly which orderings
% #206 has to repair, and the retune's diff will show them flipping to `holds'
% one at a time instead of arriving as one opaque block of new numbers.
%
% One relation is not a design ordering at all. The extraction floor on
% `\CDossierRecordListEdgeAboveSkip' (issue #219) records a bound imposed from
% outside the type scale: below it, the entry heading's right-hand column stops
% extracting with its entry. It is stated here because it constrains the same
% retune the orderings above constrain, and because nothing in the component it
% affects can express it. Unlike the rest, it must hold at every value #206 may
% choose; it is not a target to be repaired later.
%
% The three heading pairs are recorded as `above >= 2 x below', not as an
% equality. Measured on rendered output during #206, the ratio of the *tokens*
% is not the ratio a reader perceives: both gaps are padded by the same
% line-box white, and a section heading set in a larger size spends part of its
% own below-gap on its deeper font box, so a pair at exactly 2:1 reads flatter
% than 2:1. A trial retune at 2.67:1 measured about 3.5:1 of visible white in
% the statement class. The relation therefore names the floor the hierarchy
% depends on and leaves the surplus to the calibration.
\input{regression-test}
\documentclass{article}
\usepackage{careerdossier-tokens}

\ExplSyntaxOn
\cs_new_protected:Npn \cdossiertest_invariant:nn #1#2
  {
    \bool_if:nTF {#2}
      { \TYPE { #1 ~ => ~ holds } }
      { \TYPE { #1 ~ => ~ violated } }
  }
\cs_new_protected:Npn \cdossiertest_invariants:n #1
  {
    \keys_set:nn { cdossier / tokens } { fontsize = #1 }
    \__cdossier_tokens_resolve:
    \TYPE { fontsize = #1 }
    %% The letter's header block has to out-claim the section that follows it in
    %% a record document, and the one that follows it in a prose document.
    \cdossiertest_invariant:nn
      { SharedHeaderBelowSkip > RecordSectionAboveSkip }
      {
        \dim_compare_p:nNn
          { \CDossierSharedHeaderBelowSkip } > { \CDossierRecordSectionAboveSkip }
      }
    \cdossiertest_invariant:nn
      { SharedHeaderBelowSkip > ProseSectionAboveSkip }
      {
        \dim_compare_p:nNn
          { \CDossierSharedHeaderBelowSkip } > { \CDossierProseSectionAboveSkip }
      }
    %% Each heading pair binds the heading to the text it introduces: the gap
    %% opening the block is at least twice the gap closing the heading. A pair
    %% that fell below this floor would read as a heading suspended between two
    %% blocks rather than as one that belongs to what follows.
    %%
    %% The 2 sp tolerance is not slack in the design rule; it removes a rounding
    %% artefact. Each token is rounded to a whole scaled point independently, so
    %% a pair set at exactly 2:1 can miss by 1 sp depending on which way the
    %% halves fall: at 11pt the body leading is 13.6pt = 891290 sp, and
    %% 0.75 x 891290 rounds up to 668468, whose double exceeds 1.5 x 891290 by
    %% one scaled point. Without the tolerance an exactly-2:1 pair reports
    %% `holds' at 10pt and 12pt and `violated' at 11pt, which is a false
    %% failure and would push a retune away from exact 2:1 for no design reason.
    \cdossiertest_invariant:nn
      { RecordSectionAboveSkip >= 2 ~ x ~ RecordSectionBelowSkip }
      {
        ! \dim_compare_p:nNn
            { \CDossierRecordSectionAboveSkip + 2sp }
            < { \CDossierRecordSectionBelowSkip * 2 }
      }
    \cdossiertest_invariant:nn
      { ProseSectionAboveSkip >= 2 ~ x ~ ProseSectionBelowSkip }
      {
        ! \dim_compare_p:nNn
            { \CDossierProseSectionAboveSkip + 2sp }
            < { \CDossierProseSectionBelowSkip * 2 }
      }
    \cdossiertest_invariant:nn
      { ProseSubsectionAboveSkip >= 2 ~ x ~ ProseSubsectionBelowSkip }
      {
        ! \dim_compare_p:nNn
            { \CDossierProseSubsectionAboveSkip + 2sp }
            < { \CDossierProseSubsectionBelowSkip * 2 }
      }
    %% A subsection is a child of the section containing it, on both edges.
    \cdossiertest_invariant:nn
      { ProseSubsectionAboveSkip < ProseSectionAboveSkip }
      {
        \dim_compare_p:nNn
          { \CDossierProseSubsectionAboveSkip }
          < { \CDossierProseSectionAboveSkip }
      }
    \cdossiertest_invariant:nn
      { ProseSubsectionBelowSkip < ProseSectionBelowSkip }
      {
        \dim_compare_p:nNn
          { \CDossierProseSubsectionBelowSkip }
          < { \CDossierProseSectionBelowSkip }
      }
    %% Two entries must sit closer together than an entry and the section
    %% heading above it, or the section boundary stops reading as the stronger.
    \cdossiertest_invariant:nn
      { RecordEntryAboveSkip < RecordSectionBelowSkip }
      {
        \dim_compare_p:nNn
          { \CDossierRecordEntryAboveSkip } < { \CDossierRecordSectionBelowSkip }
      }
    %% The entry heading -> body gap is a floor a list overrides, so it may not
    %% exceed the list's own opening edge.
    \cdossiertest_invariant:nn
      { RecordEntryGapSkip <= RecordListEdgeAboveSkip }
      {
        ! \dim_compare_p:nNn
            { \CDossierRecordEntryGapSkip } > { \CDossierRecordListEdgeAboveSkip }
      }
    %% A bullet list belongs to the entry above it: it must sit closer to that
    %% entry than to the material below it, and closer than two entries sit to
    %% each other.
    \cdossiertest_invariant:nn
      { RecordListEdgeAboveSkip < RecordListEdgeBelowSkip }
      {
        \dim_compare_p:nNn
          { \CDossierRecordListEdgeAboveSkip }
          < { \CDossierRecordListEdgeBelowSkip }
      }
    \cdossiertest_invariant:nn
      { RecordListEdgeAboveSkip < RecordEntryAboveSkip }
      {
        \dim_compare_p:nNn
          { \CDossierRecordListEdgeAboveSkip } < { \CDossierRecordEntryAboveSkip }
      }
    %% Issue #219: an extraction floor, not a design preference, and the only
    %% relation here that is not about how the page reads.
    %%
    %% The entry heading sets its dates/location in a right-hand column. Poppler
    %% builds its reading order from glyph positions alone -- the PDF tag tree
    %% has no bearing on it -- and groups lines into blocks by vertical
    %% proximity. Once a bullet list closes up against the heading, the heading's
    %% left column and the list merge into one *tall* block. A tall left block
    %% spanning the whole vertical band of a short right-hand one is Poppler's
    %% signature for a two-column page, so it emits the entire left column and
    %% only then the right: the dates sort after the bullets, or after the
    %% `Page N of M' folio on a page carrying furniture.
    %%
    %% The trigger is a page-level property the entry head does not own. Nothing
    %% confined to `\__cdossier_components_entryhead:nnnn' reaches it: the
    %% heading row is already one line box in source order, which is not what
    %% Poppler groups on; changing the heading's internal line spacing never
    %% splits the block; and every invisible character that could bridge the gap
    %% is either discarded by Poppler (U+0020, U+00A0, U+200B) or absent from
    %% TeX Gyre Heros (U+2000, U+2002, U+2003, U+2007, U+2009, and U+205F were
    %% each tried). Bridging with a character Poppler
    %% does keep needs a dense run of them -- about 130 per heading row, which
    %% draws visible ink and fills the text layer with junk. Widening the gap
    %% below the heading is the only lever, so this token carries the constraint.
    %%
    %% 0.25 is measured, not assumed: on the committed fixtures the column
    %% extracts with its entry at 0.25 and reorders at 0.1875, identically for
    %% the resume and CV classes at 10pt, 11pt, and 12pt. The floor is therefore
    %% a property of the ratio rather than of any body size. Retuning this token
    %% below it silently breaks extraction on both classes at once; the three
    %% `*-entry-dates-*' fixtures in tests/extraction/ catch it, and this
    %% relation states the bound they enforce. See docs/ATS-EXTRACTION.md 3.4.
    %%
    %% The 2 sp tolerance is the rounding artefact documented above: the token is
    %% rounded to a whole scaled point independently of the comparison value, so
    %% a ratio set at exactly 0.25 can miss the bound by 1 sp.
    \cdossiertest_invariant:nn
      { RecordListEdgeAboveSkip >= 0.25 ~ x ~ BodyLeading ~ (extraction ~ floor) }
      {
        ! \dim_compare_p:nNn
            { \CDossierRecordListEdgeAboveSkip + 2sp }
            < { 0.25 \CDossierBodyLeading }
      }
    %% Hard, not a preference: `\@xsect' reads a non-positive after-skip as a
    %% request for a run-in heading, and careerdossier-statement.cls passes
    %% `below - \parskip'.
    \cdossiertest_invariant:nn
      { ProseParSkip < ProseSectionBelowSkip }
      {
        \dim_compare_p:nNn
          { \CDossierProseParSkip } < { \CDossierProseSectionBelowSkip }
      }
    \cdossiertest_invariant:nn
      { ProseParSkip < ProseSubsectionBelowSkip }
      {
        \dim_compare_p:nNn
          { \CDossierProseParSkip } < { \CDossierProseSubsectionBelowSkip }
      }
    %% The letter body's two edges are a symmetric pair, and both have to read
    %% as stronger than a letterhead block boundary, which in turn has to read
    %% as stronger than the gap between two paragraphs.
    \cdossiertest_invariant:nn
      { LetterBodyAboveSkip = LetterBodyBelowSkip }
      {
        \dim_compare_p:nNn
          { \CDossierLetterBodyAboveSkip } = { \CDossierLetterBodyBelowSkip }
      }
    \cdossiertest_invariant:nn
      { LetterBodyAboveSkip > LetterBlockSkip }
      {
        \dim_compare_p:nNn
          { \CDossierLetterBodyAboveSkip } > { \CDossierLetterBlockSkip }
      }
    \cdossiertest_invariant:nn
      { LetterBlockSkip > LetterParSkip }
      {
        \dim_compare_p:nNn
          { \CDossierLetterBlockSkip } > { \CDossierLetterParSkip }
      }
  }
\NewDocumentCommand \cdossiertestInvariants { m }
  { \cdossiertest_invariants:n {#1} }
\ExplSyntaxOff

\begin{document}
\START

\TEST{boundary-token-ordering}{
  \cdossiertestInvariants{10pt}
  \cdossiertestInvariants{11pt}
  \cdossiertestInvariants{12pt}
}

\END
