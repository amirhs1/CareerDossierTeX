% biblatex-profile.lvt — optional integration profile and author matching.
\input{regression-test}
\documentclass{article}
\usepackage{hyperref}
\usepackage{careerdossier-biblatex}

\CDossierHighlightAuthor{family={Lovelace}, given={Ada}}
\CDossierHighlightAuthor{family={Lovelace}, given={A.}}
% Issue #541. Declared with ordinary spaces, the way the name reads; Biber
% writes the parsed part with a delimiter macro between the words instead, and
% the tests below drive the matcher with both spellings.
\CDossierHighlightAuthor{family={Van den Berg}, given={Maria Elena}}

\ExplSyntaxOn
\cs_new_protected:Npn \cdossiertestBibName #1#2
  {
    \cs_set:Npn \namepartfamily {#1}
    \cs_set:Npn \namepartgiven  {#2}
    \__cdossier_biblatex_highlight_if:TF
      { \TYPE{ [#1/#2]=highlight } }
      { \TYPE{ [#1/#2]=ordinary } }
  }
% The declaration side of issue #541, which \cdossiertestBibName cannot reach:
% that one drives the parsed name part, and this drives the declared one. The
% declaration is stored globally and a group would not contain it, but it is
% matched here, so it is not among the ones reported at \end{document}.
\cs_new_protected:Npn \cdossiertestBibDeclaredDelimiter
  {
    \CDossierHighlightAuthor{family={Hopper}, given={Grace\bibnamedelima Brewster}}
    \group_begin:
      \cs_set:Npn \namepartfamily { Hopper }
      \cs_set:Npn \namepartgiven  { Grace~Brewster }
      \__cdossier_biblatex_highlight_if:TF
        { \TYPE{ [declared-delimiter]=highlight } }
        { \TYPE{ [declared-delimiter]=ordinary } }
    \group_end:
  }
\cs_new_protected:Npn \cdossiertestBibFormatting #1
  {
    \group_begin:
      \cs_set_protected:Npn \mkbibbold ##1 { \TYPE{ bold-applied } ##1 }
      \cs_set:Npn \namepartfamily { Lovelace }
      \cs_set:Npn \namepartgiven  { Ada }
      \str_if_eq:nnTF {#1} { bibliography }
        { \toggletrue  { blx@bibliography } }
        { \togglefalse { blx@bibliography } }
      \mkbibnamefamily { Lovelace }
      \TYPE{ #1-formatting-complete }
    \group_end:
  }
\ExplSyntaxOff

\begin{document}
\START

\TEST{exact-full-name-matches}{
  \cdossiertestBibName{Lovelace}{Ada}
}

\TEST{declared-initial-variant-matches}{
  \cdossiertestBibName{Lovelace}{A.}
}

\TEST{partial-name-does-not-match}{
  \cdossiertestBibName{Lovelace}{Augusta Ada}
}

\TEST{different-family-does-not-match}{
  \cdossiertestBibName{Hopper}{Grace}
}

% Issue #541. Biber does not separate the words of a multi-word name part with
% a space: `given = {Maria Elena}' reaches \namepartgiven as
% `Maria\bibnamedelima Elena'. Comparing that against the declaration's
% ordinary space matched nothing and said nothing, so the only symptom was a
% name left in the regular weight. The delimiter spellings here are copied from
% a .bbl Biber wrote, not invented: \bibnamedelima between words,
% \bibnamedelimb where a longer word follows, \bibnamedelimi after an initial.
\TEST{multi-word-given-matches-across-the-delimiter}{
  \cdossiertestBibName{Van den Berg}{Maria\bibnamedelima Elena}
}

\TEST{multi-word-given-matches-the-b-delimiter}{
  \cdossiertestBibName{Van den Berg}{Maria\bibnamedelimb Elena}
}

% The delimiter spelling was the documented workaround before the normalisation
% existed, so a document carrying it must keep matching rather than trade one
% silent failure for another.
\TEST{declaration-written-with-a-delimiter-still-matches}{
  \cdossiertestBibDeclaredDelimiter
}

% Normalising the delimiter must not make the comparison indiscriminate: a
% different multi-word name still has to miss.
\TEST{different-multi-word-given-does-not-match}{
  \cdossiertestBibName{Van den Berg}{Maria\bibnamedelima Teresa}
}

\TEST{bibliography-name-is-emphasized}{
  \cdossiertestBibFormatting{bibliography}
}

% The URL glue policy of issue #312. The PDF-level assertion lives in
% tests/links, which needs Biber and Poppler and is therefore skippable; this
% one is the cheap, always-run statement of what the package sets, and it is
% what would notice a value drifting back toward a stretchable cap.
%
% \biburlbigskip must have no stretch component at all. A cap merely bounds the
% stretch, and TeX exceeds a stated stretch to set an otherwise underfull line,
% which is how a 262-character URL split under the earlier 0mu plus 1mu. Rigid
% glue is the guarantee: there is nothing to stretch.
\TEST{url-glue-is-rigid}{
  \showthe\biburlbigskip
}

% Rigid glue alone leaves TeX no way to absorb the remainder of a line, so it
% overran the margin instead. These three permit a break inside a run of
% letters or digits when punctuation offers none; BibLaTeX disables all three
% by default, so a zero here would restore the overfull lines.
\TEST{url-break-penalties-are-enabled}{
  \showthe\value{biburlnumpenalty}
  \showthe\value{biburlucpenalty}
  \showthe\value{biburllcpenalty}
}

\TEST{citation-name-is-not-emphasized}{
  \cdossiertestBibFormatting{citation}
}

\END
\end{document}
