% biblatex-profile.lvt — optional integration profile and author matching.
\input{regression-test}
\documentclass{article}
\usepackage{hyperref}
\usepackage{careerdossier-biblatex}

\CDossierHighlightAuthor{family={Lovelace}, given={Ada}}
\CDossierHighlightAuthor{family={Lovelace}, given={A.}}

\ExplSyntaxOn
\cs_new_protected:Npn \cdossiertestBibName #1#2
  {
    \cs_set:Npn \namepartfamily {#1}
    \cs_set:Npn \namepartgiven  {#2}
    \__cdossier_biblatex_highlight_if:TF
      { \TYPE{ [#1/#2]=highlight } }
      { \TYPE{ [#1/#2]=ordinary } }
  }
\cs_new_protected:Npn \cdossiertestBibFormatting #1
  {
    \group_begin:
      \cs_set_protected:Npn \mkbibbold ##1 { \TYPE{ bold-applied } ##1 }
      \cs_set:Npn \namepartfamily { Lovelace }
      \cs_set:Npn \namepartgiven  { Ada }
      \str_if_eq:nnTF {#1} { bibliography }
        { \toggletrue  { blx@bibliography } }
        { \togglefalse { blx@bibliography } }
      \mkbibnamefamily { Lovelace }
      \TYPE{ #1-formatting-complete }
    \group_end:
  }
\ExplSyntaxOff

\begin{document}
\START

\TEST{exact-full-name-matches}{
  \cdossiertestBibName{Lovelace}{Ada}
}

\TEST{declared-initial-variant-matches}{
  \cdossiertestBibName{Lovelace}{A.}
}

\TEST{partial-name-does-not-match}{
  \cdossiertestBibName{Lovelace}{Augusta Ada}
}

\TEST{different-family-does-not-match}{
  \cdossiertestBibName{Hopper}{Grace}
}

\TEST{bibliography-name-is-emphasized}{
  \cdossiertestBibFormatting{bibliography}
}

% The URL glue policy of issue #312. The PDF-level assertion lives in
% tests/links, which needs Biber and Poppler and is therefore skippable; this
% one is the cheap, always-run statement of what the package sets, and it is
% what would notice a value drifting back toward a stretchable cap.
%
% \biburlbigskip must have no stretch component at all. A cap merely bounds the
% stretch, and TeX exceeds a stated stretch to set an otherwise underfull line,
% which is how a 262-character URL split under the earlier 0mu plus 1mu. Rigid
% glue is the guarantee: there is nothing to stretch.
\TEST{url-glue-is-rigid}{
  \showthe\biburlbigskip
}

% Rigid glue alone leaves TeX no way to absorb the remainder of a line, so it
% overran the margin instead. These three permit a break inside a run of
% letters or digits when punctuation offers none; BibLaTeX disables all three
% by default, so a zero here would restore the overfull lines.
\TEST{url-break-penalties-are-enabled}{
  \showthe\value{biburlnumpenalty}
  \showthe\value{biburlucpenalty}
  \showthe\value{biburllcpenalty}
}

\TEST{citation-name-is-not-emphasized}{
  \cdossiertestBibFormatting{citation}
}

\END
\end{document}
