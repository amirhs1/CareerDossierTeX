% tokens-scale.lvt — calibrated type, rhythm, list, and geometry tokens.
\input{regression-test}
\documentclass{article}
\usepackage{enumitem}
\usepackage{careerdossier-tokens}

\ExplSyntaxOn
\cs_new_protected:Npn \cdossiertest_dimension:N #1
  { \TYPE { \token_to_str:N #1 = \dim_use:N #1 } }
\cs_new_protected:Npn \cdossiertest_skip:N #1
  { \TYPE { \token_to_str:N #1 = \skip_use:N #1 } }
\cs_new_protected:Npn \cdossiertest_size:N #1
  {
    \group_begin:
      #1
      \TYPE
        {
          \token_to_str:N #1 =
          \cs:w f@size \cs_end: /
          \cs:w f@baselineskip \cs_end:
        }
    \group_end:
  }
\cs_new_protected:Npn \cdossiertest_scale:n #1
  {
    \keys_set:nn { cdossier / tokens } { fontsize = #1 }
    \__cdossier_tokens_resolve:
    \TYPE { fontsize = #1 }
    \cdossiertest_dimension:N \CDossierBodySize
    \cdossiertest_dimension:N \CDossierBodyLeading
    \cdossiertest_size:N \CDossierSizeName
    \cdossiertest_size:N \CDossierSizeDocumentTitle
    \cdossiertest_size:N \CDossierSizeHeadline
    \cdossiertest_size:N \CDossierSizeSection
    \cdossiertest_size:N \CDossierSizeBody
    \cdossiertest_size:N \CDossierSizeSmall
    \cdossiertest_size:N \CDossierSizeFurniture
    \cdossiertest_dimension:N \CDossierFurnitureLeading
    \cdossiertest_dimension:N \CDossierRuleThickness
    \cdossiertest_dimension:N \CDossierListLabelSep
    \cdossiertest_dimension:N \CDossierEmergencyStretch
    \cdossiertest_skip:N \CDossierSharedHeaderNameGapSkip
    \cdossiertest_skip:N \CDossierSharedHeaderMetaGapSkip
    \cdossiertest_skip:N \CDossierRecordHeaderBelowSkip
    \cdossiertest_skip:N \CDossierProseHeaderBelowSkip
    \cdossiertest_skip:N \CDossierLetterHeaderBelowSkip
    \cdossiertest_skip:N \CDossierRecordSectionAboveSkip
    \cdossiertest_skip:N \CDossierRecordSectionRuleGapSkip
    \cdossiertest_skip:N \CDossierRecordSectionBelowSkip
    \cdossiertest_skip:N \CDossierProseSectionAboveSkip
    \cdossiertest_skip:N \CDossierProseSectionBelowSkip
    \cdossiertest_skip:N \CDossierProseSubsectionAboveSkip
    \cdossiertest_skip:N \CDossierProseSubsectionBelowSkip
    \cdossiertest_skip:N \CDossierRecordEntryAboveSkip
    \cdossiertest_skip:N \CDossierRecordEntryGapSkip
    \cdossiertest_skip:N \CDossierRecordListEdgeAboveSkip
    \cdossiertest_skip:N \CDossierRecordListEdgeBelowSkip
    \cdossiertest_skip:N \CDossierRecordItemSepSkip
    \cdossiertest_skip:N \CDossierRecordParSkip
    \cdossiertest_skip:N \CDossierProseParSkip
    \cdossiertest_skip:N \CDossierLetterParSkip
    \cdossiertest_skip:N \CDossierLetterRecipientLineGapSkip
    \cdossiertest_skip:N \CDossierLetterBlockSkip
    \cdossiertest_skip:N \CDossierLetterBodyAboveSkip
    \cdossiertest_skip:N \CDossierLetterBodyBelowSkip
    \cdossiertest_skip:N \CDossierLetterSignatureGapSkip
  }
\cs_new_protected:Npn \cdossiertest_margin:n #1
  {
    \keys_set:nn { cdossier / tokens } { margin = #1 }
    \__cdossier_tokens_resolve:
    \TYPE { margin = #1;~page-margin = \dim_use:N \CDossierPageMargin }
  }
\cs_new_protected:Npn \cdossiertest_list:
  {
    \begin { itemize }
      [
        leftmargin = * ,
        labelsep = \CDossierListLabelSep ,
        topsep = \CDossierRecordListEdgeAboveSkip ,
        itemsep = \CDossierRecordItemSepSkip ,
        parsep = 0pt ,
        label = \textbullet ,
      ]
      \TYPE
        {
          leftmargin = \the \leftmargin ;
          labelwidth-plus-labelsep =
          \dim_eval:n { \labelwidth + \labelsep }
        }
      \item Compiles.
    \end { itemize }
  }
\cs_new_protected:Npn \cdossiertest_body_catcode:
  {
    \int_set:Nn \l_tmpa_int { \char_value_catcode:n { `@ } }
    \__cdossier_tokens_apply_body_size:
    \TYPE
      {
        at-catcode-before = \int_use:N \l_tmpa_int ;
        after = \int_eval:n { \char_value_catcode:n { `@ } }
      }
  }
\NewDocumentCommand \cdossiertestScale { m }
  { \cdossiertest_scale:n {#1} }
\NewDocumentCommand \cdossiertestMargin { m }
  { \cdossiertest_margin:n {#1} }
\NewDocumentCommand \cdossiertestList { }
  { \cdossiertest_list: }
\NewDocumentCommand \cdossiertestBodyCatcode { }
  { \cdossiertest_body_catcode: }

%% Issue #242 classified the body-size primitive as class-to-package plumbing
%% and renamed it. Asserting only that the private name works would leave the
%% public one free to reappear, so both halves are pinned: the old name must be
%% undefined, not merely unused.
\NewDocumentCommand \cdossiertestNameSurface { }
  {
    \cs_if_exist:cTF { __cdossier_tokens_apply_body_size: }
      { \TYPE{private-apply-body-size=defined} }
      { \TYPE{private-apply-body-size=missing} }
    \cs_if_exist:cTF { CDossierApplyBodySize }
      { \TYPE{public-apply-body-size=defined} }
      { \TYPE{public-apply-body-size=undefined} }
  }
\ExplSyntaxOff

\begin{document}
\START

\TEST{all-type-and-rhythm-tokens}{
  \cdossiertestScale{10pt}
  \cdossiertestScale{11pt}
  \cdossiertestScale{12pt}
}

\TEST{both-margin-presets}{
  \cdossiertestMargin{normal}
  \cdossiertestMargin{narrow}
}

\TEST{flush-left-list-metrics}{
  \cdossiertestScale{11pt}
  \cdossiertestList
}

\TEST{body-size-preserves-caller-catcodes}{
  \cdossiertestScale{11pt}
  \cdossiertestBodyCatcode
}

\TEST{body-size-primitive-name-surface}{
  \cdossiertestNameSurface
}

\END
