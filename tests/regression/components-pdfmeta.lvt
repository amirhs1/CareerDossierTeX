% components-pdfmeta.lvt — careerdossier-components PDF metadata construction.
%
% Five things are checked here, none of which any other suite can see.
%
% 1. The "has the document already set this?" test. The module derives
%    pdftitle/pdfauthor/pdflang from the profile, but must never overwrite a
%    value the document supplied itself. hyperref leaves an unset \@pdftitle and
%    \@pdfauthor defined-but-empty, and an unset \@pdflang as \relax. Those two
%    states must both read as "unset", and only a non-empty value as
%    "user-supplied".
%
%    This case is worth pinning because getting it wrong is *silent*: expl3
%    reports a \relax-meaning control sequence as not existing, so treating the
%    non-existent branch as "already set" makes the field vanish from the PDF
%    with nothing in the log. The control sequences below stand in for
%    hyperref's, so the conditional is exercised without loading hyperref.
%
% 5. The same question asked of the kernel's PDF management, which is where the
%    document's own pdftitle and pdfauthor land under \DocumentMetadata and
%    where hyperref's \@pdftitle and \@pdfauthor stay empty (issue #440).
%    Reading only case 1 therefore reported "the document supplied nothing" for
%    a document that supplied both, and the derived values overwrote them --
%    silently, since the two mechanisms write the same Info entries. Four states
%    of that second reader are pinned: no accessor (the default path), the key
%    absent, the key present and empty, and the key carrying a value.
%
% 2. The title join. The owning class declares a document type so a resume and a
%    cover letter built from one profile do not receive identical titles; with no
%    doctype the title is the bare name.
%
% 3. What is actually written, as opposed to what is derived (issue #276). The
%    two cases above test the ingredients; this one records the \hypersetup
%    calls the module makes, so the derived pdflang and the decision to leave a
%    user-supplied one alone are pinned as behaviour rather than inferred from
%    the conditional.
%
% 4. The ViewerPreferences /DisplayDocTitle request (issue #277), which is the
%    one piece of this metadata that is *not* applied at \begin{document}. It
%    cannot be: pdfdisplaydoctitle is a boolean whose default is
%    indistinguishable from a document's explicit `false', so the only way to
%    let the document win is to write it before the document can — as soon as
%    hyperref exists, while the class is still loading. Two halves of that are
%    pinned here: the request is made, and it asks for `true'; and the function
%    applied at \begin{document} does not also make it, so folding the two
%    together fails this file rather than quietly starting to overwrite user
%    values. That the request is on the hyperref load hook, and that a
%    document's own `false' therefore wins, is a property of a built PDF and is
%    asserted in tests/tagging/run.sh.
%
% Whether the values actually reach the PDF catalog and info dictionary is a
% property of the built document, not of this log. The smoke fixtures cover the
% derived title and author; /DisplayDocTitle is covered by tests/tagging/run.sh
% and /Lang by tests/metadata/run.sh, both of which inspect built PDFs. /Lang
% needs its own suite because it is written by a different mechanism at a
% different time, and is the only one of the three that depends on package load
% order.
\input{regression-test}
\documentclass{article}
\usepackage{careerdossier-components}

\ExplSyntaxOn
% Stand-ins for hyperref's internals, in each state the real ones can be in.
% \@pdflang unset is \relax; \@pdftitle unset is a plain (non-long) empty macro,
% which is what \cs_set_nopar:cpn reproduces. The \long empty is included
% deliberately: hyperref's fields are not \long today, but an emptiness test
% that depends on that would be correct only by luck, and would fail silently.
\cs_set_eq:cN      { cdossiertestrelax } \relax
\cs_set_nopar:cpn  { cdossiertestempty } { }
\cs_set:cpn        { cdossiertestlongempty } { }
\cs_set_nopar:cpn  { cdossiertestfull  } { Already~Set~By~User }

\cs_new_protected:Npn \cdossiertestVerdict #1
  {
    \__cdossier_components_hyp_if_unset:nTF {#1}
      { \TYPE{ #1 ~ -> ~ unset } }
      { \TYPE{ #1 ~ -> ~ user-supplied } }
  }

\cs_new_protected:Npn \cdossiertestTitle
  {
    \__cdossier_components_pdftitle:
    \TYPE{ [\l__cdossier_components_pdfname_tl] }
  }
\cs_new_protected:Npn \cdossiertestSetDoctype #1
  { \__cdossier_components_doctype:n {#1} }
\cs_new_protected:Npn \cdossiertestClearDoctype
  { \tl_clear:N \l__cdossier_components_doctype_tl }

% A recorder standing in for hyperref's \hypersetup. It is installed inside a
% \TEST, so the definition is local: it must not exist while the begindocument
% hook runs, or \__cdossier_components_pdfmeta: would take this file for a
% document that loaded hyperref.
\cs_new_protected:Npn \cdossiertestRecordHypersetup
  {
    \cs_set_protected:Npn \hypersetup ##1
      { \TYPE{ hypersetup: ~ \tl_to_str:n {##1} } }
  }
\cs_new_protected:Npn \cdossiertestDisplayDocTitle
  { \__cdossier_components_pdfdisplaydoctitle: }
\cs_new_protected:Npn \cdossiertestPdfmeta
  { \__cdossier_components_pdfmeta: }
% Stand in for a document that set pdflang itself. hyperref stores the value in
% \@pdflang, which is what the module reads.
\cs_new_protected:Npn \cdossiertestSetUserLang #1
  { \cs_set_nopar:cpn { @pdflang } {#1} }
% ... and for the other route, \DocumentMetadata{lang=...}, which hyperref never
% sees: the kernel records it and writes the catalog itself. The stand-in takes
% the property name the real one does, and is undefined in this file until a
% test installs it -- which is also the state of a document that never used
% \DocumentMetadata.
\cs_new_protected:Npn \cdossiertestSetKernelLang #1
  { \cs_set:cpn { GetDocumentProperties } ##1 {#1} }

% The same shape for /Title and /Author (issue #440). Under \DocumentMetadata
% hyperref writes those into the kernel's PDF management and leaves \@pdftitle
% and \@pdfauthor defined-but-empty, so the stand-ins above report "unset" for a
% document that did in fact supply a value. \pdfmanagement_get:nnN is the reader
% that can see it; like \GetDocumentProperties it does not exist at all on the
% default path, which is why it is undefined here until a test installs it.
%
% The real one yields \q_no_value for a key the dictionary does not carry, so
% the stand-in does too: that quark and an empty value are different states of
% the store and both have to read as "the document supplied nothing".
\cs_new_protected:Npn \cdossiertestSetKernelInfo #1#2
  {
    \cs_set_protected:Npn \pdfmanagement_get:nnN ##1##2##3
      {
        \str_if_eq:nnTF {##2} {#1}
          { \tl_set:Nn ##3 {#2} }
          { \tl_set:Nn ##3 { \q_no_value } }
      }
  }
% Reset the profile name without the `overwriting with the new value' warning
% (issue #439). The ligature tests below walk one name through eight spellings,
% and the warning is correct every time -- eight copies of it in the baseline
% would bury the four strings the test exists to pin. It is redirected rather
% than silenced globally so it still fires for every other test in this file.
\cs_new_protected:Npn \cdossiertestSetName #1
  {
    \group_begin:
      \msg_redirect_name:nnn { careerdossier-base } { overwrite } { none }
      \CDossierSetup { name = {#1} }
    \group_end:
  }
\cs_new_protected:Npn \cdossiertestSetKernelInfoEmptyStore
  {
    \cs_set_protected:Npn \pdfmanagement_get:nnN ##1##2##3
      { \tl_set:Nn ##3 { \q_no_value } }
  }
\cs_new_protected:Npn \cdossiertestKernelInfoVerdict #1
  {
    \__cdossier_components_kernel_info_if_set:nTF {#1}
      { \TYPE{ Info/#1 ~ -> ~ user-supplied } }
      { \TYPE{ Info/#1 ~ -> ~ unset } }
  }
\ExplSyntaxOff

\begin{document}
\START

% An unset \@pdflang is \relax. expl3 reports \relax as non-existent, so this is
% the case that must not be mistaken for "the user set it".
\TEST{relax-field-reads-as-unset}{
  \cdossiertestVerdict{cdossiertestrelax}
}

% An unset \@pdftitle/\@pdfauthor is defined but empty.
\TEST{empty-field-reads-as-unset}{
  \cdossiertestVerdict{cdossiertestempty}
}

% The same, but \long. \tl_if_empty:N compares meaning against \c_empty_tl,
% which is not \long, so it would call this one non-empty and silently refuse to
% write the field. The test pins the expansion-based check that does not care.
\TEST{long-empty-field-also-reads-as-unset}{
  \cdossiertestVerdict{cdossiertestlongempty}
}

% A field the document set must be left alone.
\TEST{non-empty-field-reads-as-user-supplied}{
  \cdossiertestVerdict{cdossiertestfull}
}

% A name hyperref never defined: nothing to preserve, so treat it as unset.
\TEST{undefined-field-reads-as-unset}{
  \cdossiertestVerdict{cdossiertestneverdefined}
}

% With a doctype declared, the title distinguishes the document from a sibling
% built off the same profile.
%
% The baseline holds the separator as the en dash it is. It used to hold `--',
% which looked equivalent and was not: only one of the two build paths converted
% it, so the string this test reports was not the string half of the users got
% (issue #428). What this test can see is the builder's output, so it is the
% place the spelling is pinned; that the two paths then agree about it is
% tests/metadata/run.sh's assertion, since it needs two real PDFs.
\TEST{title-joins-doctype-and-name}{
  \CDossierSetup{ name = {Ada Lovelace} }
  \cdossiertestSetDoctype{Testdoc}
  \cdossiertestTitle
}

% With no doctype, the title is the bare name and carries no stray separator.
\TEST{title-without-doctype-is-bare-name}{
  \cdossiertestClearDoctype
  \cdossiertestTitle
}

% The input-ligature table, sequence by sequence (issue #439).
%
% tests/metadata/run.sh asserts the property that matters -- the two build paths
% spell a user's `--' the same way -- but it can only afford one built pair, so
% it covers `--' and is silent about the other three. This is where the table
% itself is pinned, because here a case costs a line.
%
% The negative controls are the point of the test, not padding. `` and '' look
% like they belong on the list and do not: \pdfstringdef leaves them as the two
% ASCII characters typed, measured under LuaHBTeX 1.24.0. Converting them here
% would make the tagged path disagree with the default one in the opposite
% direction -- a fix that introduces the bug it is fixing, and one no built
% fixture in this repo would catch, since none carries a quote in a name.
%
% Two hyphens is not a subset of three: the baseline holds an en dash for one
% and an em dash for the other, so an implementation that tried `--' first would
% turn --- into an en dash and a stray hyphen, and fail here rather than in a
% user's PDF.
\TEST{title-converts-tex-input-ligatures}{
  \cdossiertestClearDoctype
  \cdossiertestSetName{a--b}        \cdossiertestTitle
  \cdossiertestSetName{a---b}       \cdossiertestTitle
  \cdossiertestSetName{a----b}      \cdossiertestTitle
  \cdossiertestSetName{!`a?`b}      \cdossiertestTitle
}

\TEST{title-leaves-quotes-and-guillemets-alone}{
  \cdossiertestClearDoctype
  \cdossiertestSetName{``a''}       \cdossiertestTitle
  \cdossiertestSetName{<<a>> ,,b}   \cdossiertestTitle
  \cdossiertestSetName{a-b}         \cdossiertestTitle
}

% The doctype is user text on one class -- careerdossier-statement derives it
% from \CDossierStatementSetup{title=...} -- so the pass has to see the composed
% string, not just the name. Converting the name alone passes every other case
% in this file.
%
% \CDossierSetup is global here -- the profile outlives the \TEST that set it,
% which is what lets title-without-doctype-is-bare-name above read the name set
% two tests earlier. So this block restores the name it found on the way out:
% the tests below derive metadata from whatever is current, and would otherwise
% report `a-b'.
\TEST{title-converts-ligatures-in-the-doctype-too}{
  \cdossiertestSetName{Ada Lovelace}
  \cdossiertestSetDoctype{Testdoc -- Draft}
  \cdossiertestTitle
}

% The viewer is asked to display the title, and asked for `true' -- the value
% is what makes /DisplayDocTitle appear in the catalog at all.
\TEST{displaydoctitle-asks-hyperref-for-true}{
  \cdossiertestRecordHypersetup
  \cdossiertestDisplayDocTitle
}

% Everything \__cdossier_components_pdfmeta: asks hyperref for, in one place.
% Two contracts read off the same three lines:
%
%   * no pdfdisplaydoctitle among them (#277). The derived fields are applied at
%     \begin{document}, where a user value can be detected and preserved, while
%     that one is applied at hyperref load time, where it can be overridden
%     instead. Fold the two together and a line appears below.
%   * pdflang is derived, and its value is `en' (#276). The project is
%     English-only, so the value is fixed.
\TEST{pdfmeta-writes-title-author-and-lang}{
  \cdossiertestRecordHypersetup
  \cdossiertestSetDoctype{Testdoc}
  \cdossiertestPdfmeta
}

% A document that set pdflang keeps it: no pdflang line below. The other two
% fields are still derived, which is what makes this a precedence test rather
% than an all-or-nothing one.
\TEST{pdfmeta-keeps-user-pdflang}{
  \cdossiertestRecordHypersetup
  \cdossiertestSetUserLang{en-GB}
  \cdossiertestPdfmeta
}

% The same, for a language declared through \DocumentMetadata rather than
% \hypersetup. hyperref's \@pdflang is untouched by that route, so reading it
% alone would report "the document declared nothing" and the derived `en' would
% overwrite a language the document did in fact state -- silently, since both
% end up writing the same catalog key. Again: no pdflang line below.
\TEST{pdfmeta-keeps-documentmetadata-lang}{
  \cdossiertestRecordHypersetup
  \cdossiertestSetKernelLang{de}
  \cdossiertestPdfmeta
}

% ---------------------------------------------------------------------------
% The kernel's Info dictionary as a second route into /Title and /Author, and
% the four states its reader has to tell apart (issue #440).
% ---------------------------------------------------------------------------

% No accessor at all: the default path, where hyperref owns the Info dictionary
% and \@pdftitle is the record. Nothing to preserve here, so "unset" -- and this
% is the state every other test in this file is in, which is what keeps the new
% reader from changing the default path's answers above.
\TEST{kernel-info-without-accessor-reads-as-unset}{
  \cdossiertestKernelInfoVerdict{Title}
}

% The accessor exists but the dictionary has no such key. \q_no_value is not a
% value the document supplied, and reading it as one would suppress the derived
% title on every tagged build.
\TEST{kernel-info-no-value-reads-as-unset}{
  \cdossiertestSetKernelInfoEmptyStore
  \cdossiertestKernelInfoVerdict{Title}
}

% Present but empty. A distinct state from \q_no_value, and the same verdict:
% an empty title is not a title, and treating it as one leaves the PDF with the
% filename in the viewer's tab bar.
\TEST{kernel-info-empty-value-reads-as-unset}{
  \cdossiertestSetKernelInfo{Title}{}
  \cdossiertestKernelInfoVerdict{Title}
}

% The state the bug turned on: the document's own value, in the one place the
% tagged path puts it.
\TEST{kernel-info-value-reads-as-user-supplied}{
  \cdossiertestSetKernelInfo{Title}{Already~Set~By~User}
  \cdossiertestKernelInfoVerdict{Title}
}

% The reader is asked per key, not once for the pair. A document that set only
% pdftitle must still receive a derived author.
\TEST{kernel-info-is-read-per-key}{
  \cdossiertestSetKernelInfo{Title}{Already~Set~By~User}
  \cdossiertestKernelInfoVerdict{Author}
}

% And the behaviour those verdicts buy, recorded the way the pdflang precedence
% tests above are: a title the document set through \DocumentMetadata's route
% produces no pdftitle line below, while pdfauthor and pdflang are still
% derived. Before #440 all three lines appeared and the user's title was gone.
\TEST{pdfmeta-keeps-kernel-info-title}{
  \cdossiertestRecordHypersetup
  \cdossiertestSetDoctype{Testdoc}
  \cdossiertestSetKernelInfo{Title}{Already~Set~By~User}
  \cdossiertestPdfmeta
}

% The mirror image: no pdfauthor line, and the title still derived.
\TEST{pdfmeta-keeps-kernel-info-author}{
  \cdossiertestRecordHypersetup
  \cdossiertestSetDoctype{Testdoc}
  \cdossiertestSetKernelInfo{Author}{Already~Set~By~User}
  \cdossiertestPdfmeta
}

\END
