% Fictional bibliography data for the copy-paste integrity fixtures (#294).
% The URL entry carries deliberately many breakpoints and is longer than the
% remaining measure, so BibLaTeX must break it across lines: that is the state
% in which a stretched breakpoint becomes a split token.
@article{doi-entry,
  author       = {Lovelace, Ada and Hopper, Grace},
  title        = {Newest DOI Publication},
  journaltitle = {Journal of Examples},
  date         = {2026},
  doi          = {10.9999/example.transactions.2026.analytical-engine.appendix-g}
}

@book{url-entry,
  author    = {Lovelace, Ada},
  title     = {Oldest URL Publication},
  publisher = {Example Press},
  date      = {2024},
  url       = {https://records.example.invalid/collections/analytical-engine/notes/1843/appendix-g.html}
}

% The 88-character URL above is short enough that the earlier `0mu plus 1mu'
% cap held for it, which is why the suite passed while issue #312's defect was
% live. This one is 262 characters of query string, the length at which the cap
% stopped holding: the same address in a résumé bullet wraps correctly through
% \CDossierLink, so the bibliography's URL glue is the only thing under test
% here. It is a real, publicly resolvable Wikipedia advanced-search result
% rather than an invented worst case, so what it measures is an address a user
% could plausibly cite.
@online{long-url-entry,
  author = {Lovelace, Ada},
  title  = {Advanced Search for Research-Creation Sources},
  date   = {2026},
  url    = {https://en.wikipedia.org/w/index.php?search=research-creation+sound-producing+Iranian+adornments+museum+conservation+archival+silencing+diasporic+futurism+embodied+performance+sound+studies+material+culture+museum+collections+classification+preservation&title=Special%3ASearch&profile=advanced&fulltext=1&ns0=1}
}
