%% lintfixture-wrong-target.sty — option-lint fixture (issue #233)
%%
%% `margin' has both halves in this module, but its handler was pasted from the
%% option above it and still reports the `fontsize' message, so a rejected
%% margin names the wrong accepted values. Expected verdict: OK for `fontsize',
%% WRONG TARGET for `margin'. Lint input only.

\msg_new:nnnn { lintfixture-wrong-target } { unknown-fontsize }
  { Unknown~'fontsize'~value~'#1'~for~lintfixture-wrong-target. }
  { The~accepted~values~are~'10pt',~'11pt',~and~'12pt'. }

\msg_new:nnnn { lintfixture-wrong-target } { unknown-margin }
  { Unknown~'margin'~value~'#1'~for~lintfixture-wrong-target. }
  { The~accepted~values~are~'normal'~and~'narrow'. }

\keys_define:nn { cdossier / lintfixture }
  {
    fontsize .choices:nn =
      { 10pt , 11pt , 12pt }
      { \tl_set_eq:NN \l__lintfixture_fontsize_tl \l_keys_choice_tl } ,
    fontsize / unknown .code:n =
      { \msg_error:nnn { lintfixture-wrong-target } { unknown-fontsize } {#1} } ,
    fontsize .value_required:n = true ,
    margin .choices:nn =
      { normal , narrow }
      { \tl_set_eq:NN \l__lintfixture_margin_tl \l_keys_choice_tl } ,
    margin / unknown .code:n =
      { \msg_error:nnn { lintfixture-wrong-target } { unknown-fontsize } {#1} } ,
    margin .value_required:n = true ,
  }
