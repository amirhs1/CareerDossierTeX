%% careerdossier-theme owns the Phase 1 monochrome semantic colour, rule, and
%% link tokens. Colour never carries meaning by itself; these tokens exist so
%% components and classes do not hard-code colours.

\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesExplPackage {careerdossier-theme} {2026-08-04} {0.7.0}
  {CareerDossierTeX monochrome semantic colour, rule, and link tokens}

\RequirePackage { xcolor }

%% ---------------------------------------------------------------------------
%% Monochrome palette. Body text is black; the muted gray is dark enough to
%% keep well above the 4.5:1 normal-text floor on white. Measured against the
%% WCAG 2.1 relative-luminance formula, DeviceGray 0.30 on white is 8.52:1
%% (issue #271); "about 8.5:1" here was an estimate until then.
%%
%% `cdossier-muted' is consumed by the components module's de-emphasis role,
%% \CDossierMutedStyle, under `muted=gray' and `muted=both'. It is never the
%% only carrier of meaning: the runs it de-emphasises -- an entry's dates and
%% location, and the statement context line -- are identified by their position
%% and their content, and `muted=italic' (the default) reaches the same reader
%% with no colour at all. See careerdossier-components.sty.
%% ---------------------------------------------------------------------------
\definecolor { cdossier-text }    { gray } { 0 }
\definecolor { cdossier-muted }   { gray } { 0.30 }
\definecolor { cdossier-rule }    { gray } { 0 }
\definecolor { cdossier-link }    { gray } { 0 }

%% ---------------------------------------------------------------------------
%% Public semantic colour tokens, usable as grouped switches:
%%   {\CDossierMutedColor secondary text}
%%
%% `\CDossierPrimaryColor' was retired in issue #270: it reached no component,
%% class, or example, and its colour, `cdossier-primary', was `gray 0' -- the
%% same value as `cdossier-text' under a different name. See
%% docs/MIGRATION.md.
%% ---------------------------------------------------------------------------
\NewDocumentCommand \CDossierTextColor    { } { \color { cdossier-text }    }
\NewDocumentCommand \CDossierMutedColor   { } { \color { cdossier-muted }   }
\NewDocumentCommand \CDossierRuleColor    { } { \color { cdossier-rule }    }
\NewDocumentCommand \CDossierLinkColor    { } { \color { cdossier-link }    }

%% ---------------------------------------------------------------------------
%% Print-safe links. When hyperref is present, links are coloured black and
%% drawn without borders, so they read as ordinary text on paper and in
%% grayscale while the visible URL or identifier still stands on its own.
%% \urlstyle{same} keeps \url/\nolinkurl text in the surrounding font instead of
%% typewriter, so breakable contact URLs do not switch to a monospace face.
%% The hook applies whenever hyperref loads, regardless of load order.
%% ---------------------------------------------------------------------------
\AddToHook { package/hyperref/after }
  {
    \hypersetup { colorlinks = true , allcolors = cdossier-link }
    \urlstyle { same }
  }
