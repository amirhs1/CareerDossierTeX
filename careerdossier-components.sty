%% ---------------------------------------------------------------------------
%% Output medium (issue #184).
%%
%% The same dossier is read in two contexts with genuinely different needs. On
%% screen the PDF viewer already shows page position, so a `Page N of M' folio
%% is redundant chrome; on paper a loose page has no such affordance, and the
%% folio is what keeps a multi-page dossier in order after it is put down.
%% `medium' names that output context, which is what actually drives the
%% decision -- unlike `theme', which names the (fixed) colour decision.
%%
%% Package option forwarded by every public document class. The classes own
%% their public option surfaces and reject unsupported values; this package
%% owns the page furniture, so it owns the resulting decision.
%% \ProcessKeysPackageOptions reads local package options only, never the
%% global \documentclass list, so a class option reaches this package only
%% after that class has validated it. Direct package users receive the same
%% validation contract.
%%
%% Only the furniture is suppressed. Page geometry is untouched, so the text
%% block sits in exactly the same place under both values and `medium' cannot
%% reflow a document.
%% ---------------------------------------------------------------------------
\RequirePackage { l3keys2e }

\bool_new:N \l__cdossier_components_furniture_bool
\bool_set_true:N \l__cdossier_components_furniture_bool

%% `medium' now drives two independent decisions, so each has its own state
%% rather than one bool read in two senses: the page furniture below, and the
%% body-copy link decoration of issue #278. They are not each other's negation
%% by accident -- a third medium, if one is ever added, would have to answer
%% both questions separately.
\bool_new:N \l__cdossier_components_screen_bool

\msg_new:nnnn { careerdossier-components } { unknown-option }
  { Unknown~package~option~'#1'~for~careerdossier-components. }
  {
    Supported~options~are~'medium'~(print,~screen),~
    'muted'~(italic,~gray,~both,~plain),~and~
    'entrymeta'~(column,~inline).
  }

%% l3keys' own choice error reports that the value is not one of a fixed set
%% without saying what that set is, so the accepted values are named here.
\msg_new:nnnn { careerdossier-components } { unknown-medium }
  { Unknown~'medium'~value~'#1'. }
  {
    The~accepted~values~are~'print'~(running~header~and~'Page~N~of~M'~folio)~
    and~'screen'~(neither).
  }

%% ---------------------------------------------------------------------------
%% Entry-metadata de-emphasis (issues #271, #324).
%%
%% `Muted' used to name two mechanisms in two modules -- a gray in the theme and
%% an italic in typography -- and only the italic reached the page. It now names
%% one rendered result, chosen by the document:
%%
%%   muted = italic  the run is italic and black
%%   muted = gray    the run is upright in cdossier-muted, gray 0.30
%%   muted = both    the run is italic *and* gray
%%   muted = plain   the run is upright and black: none of it     (default)
%%
%% The first three values are the three corners of shape-by-colour that apply
%% *some* de-emphasis; `plain' is the fourth, which applies none.
%%
%% There is a real trade-off behind the styled values, which is why they are an
%% option rather than a fixed decision. Italic at small sizes is harder for
%% low-vision and dyslexic readers than a high-contrast gray, and entry metadata
%% is scanned rather than read. But shape is the only de-emphasis that survives
%% output that loses gray levels -- a fax, a photocopy, a 1-bit print.
%%
%% `plain' is the default because both halves of that trade-off are real, and a
%% reader affected by both would otherwise have nothing to select. Applying no
%% de-emphasis is defensible rather than a loss of meaning: it was never the
%% only carrier, since the dates are identified by their position and by their
%% content -- they read as a date range -- and under `entrymeta=inline' the
%% separator identifies them too. Being body text in the ordinary text token, it
%% is also the one value that cannot fail a contrast floor. A document that
%% wants the styling asks for it by name.
%%
%% The role lives here because it is the only place it can. careerdossier-theme
%% owns the colour and careerdossier-typography owns the shape, and neither may
%% reach into the other; this package owns rendered parts and loads both. The
%% option is forwarded by every public class, exactly as `medium' is.
%%
%% Under every value this is a visual role only: no extractor sees a difference,
%% and the extraction baselines do not move.
%% ---------------------------------------------------------------------------
\msg_new:nnnn { careerdossier-components } { unknown-muted }
  { Unknown~'muted'~value~'#1'. }
  {
    The~accepted~values~are~'italic'~(italic,~black),~
    'gray'~(upright,~gray~0.30),~'both'~(italic~and~gray),~and~
    'plain'~(upright,~black:~no~de-emphasis).
  }

%% ---------------------------------------------------------------------------
%% Entry-metadata placement (issue #230).
%%
%%   entrymeta = column  dates/location flush right, in their own column  (default)
%%   entrymeta = inline  dates/location follow title/organization on the line
%%
%% This option exists to buy back one number, and it is worth stating which.
%% `\CDossierRecordListEdgeAboveSkip' carries a measured floor of 0.25 that is
%% not a rhythm decision at all: it is an *extraction* constraint (issue #219,
%% PR #229). Poppler splits a line at a large horizontal gap first, groups the
%% resulting fragments into blocks by vertical proximity second, and orders the
%% blocks third. A flush-right column guarantees that gap on every heading row,
%% so once a bullet list closes up against the heading Poppler groups the
%% heading's left column with the list and reads the whole thing before the
%% dates. Enough vertical separation below the heading is the only thing that
%% keeps the two bands apart -- hence the floor on a spacing token.
%%
%% #219 measured every alternative that keeps the column. Restructuring the
%% heading does not reach it, because the heading row is already one line box in
%% source order and that is not what Poppler groups on. Invisible bridge glyphs
%% do not reach it either, at any code point or position, because the line is
%% split at the gap *before* the fragments are grouped, so a right-margin glyph
%% is simply absorbed into the dates block. A dense soft-hyphen run and a
%% TOC-style leader fill both work, and both put visible ink across the heading.
%% Removing the column is the one mechanism that removes the gap.
%%
%% So it is offered as a choice rather than taken as a default. Design, a clean
%% text layer, and a sub-0.25 list edge are mutually exclusive; any two are
%% available. `column' stays the default because it is the layout every existing
%% document was written against and the one the résumé's visual identity rests
%% on, and because making `inline' the default would reflow every document in
%% the world to buy a number that only some of them care about.
%%
%% Under `inline' the floor is *inapplicable*, not lifted. There is no column,
%% so there is no gap for Poppler to split on and the constraint never arises;
%% the committed default of the token is unchanged and `tokens-invariants' still
%% guards it. A document that wants a tighter list edge sets both, per document.
%%
%% The separator is a public token rather than a literal so it can be restyled,
%% and it is emitted only between two cells that are both present -- an entry
%% with no organization must not open its second line with one, which is rule 5
%% of AGENTS.md on the horizontal axis.
%% ---------------------------------------------------------------------------
\bool_new:N \l__cdossier_components_entrymeta_inline_bool

\msg_new:nnnn { careerdossier-components } { unknown-entrymeta }
  { Unknown~'entrymeta'~value~'#1'. }
  {
    The~accepted~values~are~'column'~(dates~and~location~flush~right)~
    and~'inline'~(dates~and~location~on~the~same~line~as~the~title~
    and~organization).
  }

\keys_define:nn { cdossier / components }
  {
    entrymeta .choices:nn =
      { column , inline }
      {
        \bool_set:Nn \l__cdossier_components_entrymeta_inline_bool
          { \str_if_eq_p:Vn \l_keys_choice_tl { inline } }
      } ,
    entrymeta / unknown .code:n =
      { \msg_error:nnn { careerdossier-components } { unknown-entrymeta } {#1} } ,
    entrymeta .value_required:n = true ,
    medium .choices:nn =
      { print , screen }
      {
        \bool_set:Nn \l__cdossier_components_furniture_bool
          { \str_if_eq_p:Vn \l_keys_choice_tl { print } }
        \bool_set:Nn \l__cdossier_components_screen_bool
          { \str_if_eq_p:Vn \l_keys_choice_tl { screen } }
      } ,
    medium / unknown .code:n =
      { \msg_error:nnn { careerdossier-components } { unknown-medium } {#1} } ,
    medium .value_required:n = true ,
    muted .choices:nn =
      { italic , gray , both , plain }
      { \__cdossier_components_set_muted:V \l_keys_choice_tl } ,
    muted / unknown .code:n =
      { \msg_error:nnn { careerdossier-components } { unknown-muted } {#1} } ,
    muted .value_required:n = true ,
    unknown .code:n =
      { \msg_error:nnx { careerdossier-components } { unknown-option }
          { \l_keys_key_str } } ,
  }

%% The role is redefined rather than branched at each use, so a de-emphasised
%% run costs the same as before the option existed and there is exactly one
%% definition to read. \CDossierBodyStyle carries the family and resets the
%% shape, so `gray' is upright without saying so twice -- and it is what makes
%% `plain' the body role itself rather than \normalfont, which would drop back
%% to the document family and be wrong under `bodyfont=sans'.
\cs_new_protected:Npn \__cdossier_components_set_muted:n #1
  {
    \str_case:nn {#1}
      {
        { italic }
          { \RenewDocumentCommand \CDossierMutedStyle { }
              { \CDossierBodyStyle \itshape } }
        { gray }
          { \RenewDocumentCommand \CDossierMutedStyle { }
              { \CDossierBodyStyle \CDossierMutedColor } }
        { both }
          { \RenewDocumentCommand \CDossierMutedStyle { }
              { \CDossierBodyStyle \itshape \CDossierMutedColor } }
        { plain }
          { \RenewDocumentCommand \CDossierMutedStyle { }
              { \CDossierBodyStyle } }
      }
  }
\cs_generate_variant:Nn \__cdossier_components_set_muted:n { V }

%% Declared before the options are read so the default is the same statement as
%% every other value, and \RenewDocumentCommand above always has a target.
\NewDocumentCommand \CDossierMutedStyle { } { \CDossierBodyStyle }

%% The `entrymeta=inline' separator (issue #230). `|' is the same mark the
%% contact line uses for the same job, so a document has one field separator
%% rather than two.
%%
%% Three properties are deliberate and each is pinned by a test.
%%
%% The rendered mark is wrapped in \CDossierBodyStyle, in its own group. The
%% cell that follows it on the second line is set in \CDossierMutedStyle, which
%% under `muted=italic' or `muted=both' is italic -- and an italic `|' is a
%% visibly slanted rule between two upright-and-slanted runs, which reads as a
%% glyph belonging to the metadata rather than as the boundary between two
%% fields. The separator is not metadata; it is punctuation between cells, so it
%% takes the body role on both lines and never the muted one. \CDossierBodyStyle
%% resets shape as well as family, so this holds under every `muted' value and
%% under `bodyfont=sans'.
%%
%% The mark is a layout artifact, exactly as the contact line's `|' is. It is
%% ink that separates two fields, not content of either, so assistive technology
%% is not made to announce a vertical bar between an entry's title and its
%% dates, and a consumer reading the structure text receives the same logical
%% string the `column' form produces.
%%
%% The two spaces are not symmetric, and the asymmetry is the point. An artifact
%% interrupts the enclosing marked-content run, so the heading arrives as two
%% runs rather than one, and whatever falls *outside* the artifact is what a
%% consumer concatenating them sees. The leading space is therefore ordinary
%% content glue -- it is the word boundary, and it is unbreakable so the mark
%% stays with the cell it follows. The trailing space sits inside the artifact,
%% because a second content space would concatenate to `Engineer  2024-2026'
%% with a doubled gap where `column' has one.
%%
%% That leading space is also why the inline form needs no \pdffakespace. tagpdf
%% marks only glue with a positive natural width; `column's `\hfill' has none,
%% which is the whole of issue #302, and an interword space has plenty.
%%
%% Breaking still works: the trailing space is real glue whether or not it is
%% marked as an artifact, so a long heading may break after the separator, and
%% a break there discards the trailing space as TeX discards any other.
\NewDocumentCommand \CDossierEntryMetaSeparator { }
  {
    \nobreakspace
    {
      \CDossierBodyStyle
      \__cdossier_typography_layout_artifact:n { | \space }
    }
  }

\ProcessKeysPackageOptions { cdossier / components }

%% ---------------------------------------------------------------------------
%% Contact line.
%%
%% Fields are rendered in one fixed, logical order; missing fields are skipped
%% and separators are inserted only between rendered items, so no stray or
%% duplicated separators can appear.
%% ---------------------------------------------------------------------------
\clist_const:Nn \c__cdossier_components_contactorder_clist
  { email , phone , location , website , linkedin , github , scholar , orcid }

\tl_new:N   \l__cdossier_components_disp_tl
\tl_new:N   \l__cdossier_components_url_tl
\tl_new:N   \l__cdossier_components_target_tl
\tl_new:N   \l__cdossier_components_shown_tl
\str_new:N  \l__cdossier_components_scheme_str
\bool_new:N \l__cdossier_components_printed_bool
\tl_new:N   \l__cdossier_components_label_tl
\box_new:N  \l__cdossier_components_contact_box
\box_new:N  \l__cdossier_components_contact_line_box
\box_new:N  \l__cdossier_components_contact_candidate_box
\dim_new:N  \l__cdossier_components_contact_sep_dim

\msg_new:nnnn { careerdossier-components } { contact-item-too-wide }
  { Contact~field~'#1'~is~wider~than~the~available~contact-line~width. }
  {
    Shorten~the~displayed~value,~select~margin=narrow,~or~use~a~smaller~
    supported~fontsize.~Contact~items~are~kept~on~one~line~and~are~not~
    split~automatically.
  }

%% Opt-in contact-field labels (issue #95). A screen reader announces the email
%% and website as links, but a phone number is read as bare digits with nothing
%% conveying what it is; plain extraction and ATS parsers see no link
%% annotations at all. A visible text label is the one mechanism that works in
%% every consumer, including untagged output, so it is the primary fix.
%%
%% Only the fields whose nature the value itself does not convey are labelled:
%% email, phone, and website. The linkedin, github, and scholar values begin
%% with their service's domain, orcid always carries its own label (below), and
%% a location value is a place name. Labels are fixed English strings; the
%% project is English-only (docs/ARCHITECTURE.md).
\prop_const_from_keyval:Nn \c__cdossier_components_labels_prop
  {
    email   = Email ,
    phone   = Phone ,
    website = Website ,
  }

%% Leaf: typeset one label word tied to the value that follows. A label is
%% meaningful content, never a layout artifact: it must reach the structure
%% tree and the extracted text, unlike the separators below. Contact items are
%% boxed before they are shipped, which puts them outside automatic paragraph
%% tagging, so the run is marked as content explicitly rather than inheriting
%% the enclosing artifact default.
\cs_new_protected:Npn \__cdossier_components_labeltext:n #1
  { \__cdossier_typography_text_content:n { #1:\nobreakspace } }
\cs_generate_variant:Nn \__cdossier_components_labeltext:n { V }

%% Emit the label for a field, only when labels are enabled and the field has
%% one. Called from the per-field renderer, so an absent field can never leave
%% an orphan label.
\cs_new_protected:Npn \__cdossier_components_label:n #1
  {
    \bool_if:NT \g__cdossier_base_contactlabels_bool
      {
        \prop_get:NnNT \c__cdossier_components_labels_prop {#1}
          \l__cdossier_components_label_tl
          { \__cdossier_components_labeltext:V \l__cdossier_components_label_tl }
      }
  }

%% Boundary between present contact items. The deterministic row packer calls
%% this only after both adjacent atomic items are known to fit on the same row.
\cs_new_protected:Npn \__cdossier_components_sep:
  {
    \__cdossier_typography_layout_artifact:n
      { \hbox:n { ~|~ } }
  }

%% ---------------------------------------------------------------------------
%% Link decoration (issue #278).
%%
%% careerdossier-theme sets `colorlinks=true, allcolors=cdossier-link' with
%% `cdossier-link' at gray 0, so a link is drawn in body black with no border.
%% Where the visible text *is* the address -- the contact line, \CDossierLink,
%% an ORCID iD, a bibliography DOI -- that costs nothing: the text announces
%% itself. Where an author writes their own anchor text,
%%
%%     documented in a \href{https://example.test/work}{public write-up}
%%
%% nothing at all marks `public write-up' as actionable. That is worse than the
%% colour-only case WCAG 2.1 AA 1.4.1 is about: there is no cue of any kind.
%%
%% `medium' already names the reading context, so it carries the decision. On
%% screen the anchor text is underlined; on paper it is not, which is the
%% deliberate print treatment this toolkit shipped with. The *annotation* is
%% emitted under both media: it costs nothing on paper and stripping it would
%% hand dead links to anyone who opens a `medium=print' file on screen.
%%
%% Three findings from issue #278 shape the implementation, and each is a
%% constraint rather than a preference.
%%
%%   - `colorlinks=true' is the only thing suppressing hyperref's default 1pt
%%     annotation border. Turning it off to make room for a rule brings the
%%     border back as `/Border [0 0 1]'. So the rule is drawn by us and
%%     `colorlinks' is never touched.
%%   - \__cdossier_components_link:nn below is the chokepoint for every link
%%     this package generates, and it is the wrong hook: a user's \href in body
%%     copy never reaches it. Patching it decorated exactly the links that
%%     already announced themselves and left the one that did not byte-identical.
%%   - \RenewDocumentCommand\href{omm} detonates. hyperref re-catcodes the URL
%%     argument inside \hyper@normalise before expanding it, and an xparse
%%     wrapper that grabs the argument first fails in the URL scanner.
%%
%% The last one is why the wrapper below grabs *no* arguments. It records that
%% this link came from \href and hands the untouched token stream straight to
%% hyperref's own scanner, which then runs exactly as it always did. The flag is
%% read once, in \hyper@link@, which is where hyperref has the link text in hand
%% and has finished with catcodes.
%%
%% The flag is global because it must survive the \begingroup that \href opens
%% between setting and reading it. Its lifetime is that single macro hop:
%% \hyper@link@ clears it before typesetting anything, so \hyperlink and
%% \hyperref -- which share \hyper@link@ but are not author prose -- are never
%% decorated by a stale value.
%% ---------------------------------------------------------------------------
%% lua-ul draws the rule, and the choice was settled by measurement rather than
%% by preference. ulem was tried first and rejected.
%%
%% \uline reboxes its argument and rebuilds the interword spaces as its own
%% leaders. That survives every check this project had before issue #302: the
%% rendered page is correct, veraPDF passes, and Poppler, MuPDF, and PDFKit all
%% read `public write-up' back intact, because they rebuild words from glyph
%% geometry and the gap is still there. What changes is the structure tree. A
%% consumer reading the logical text of the Link element -- which is what a
%% screen reader announces -- gets `publicwrite-up': tagpdf marks a real space
%% only where it finds interword glue, and ulem has replaced that glue. The same
%% class of defect as issues #302 and #315, arriving by a third route.
%%
%% lua-ul underlines by attaching a node attribute and letting LuaTeX draw the
%% rule at shipout. Nothing is reboxed, the glue is untouched, and the space
%% survives -- tests/tagging/resume-linkdecoration pins that. It is LuaLaTeX-only,
%% which costs this toolkit nothing: LuaLaTeX is the sole supported engine, and
%% the classes already error on anything else. LPPL 1.3c, in TeX Live, and it
%% pulls in luacolor (LPPL 1.3) as its one further dependency.
%%
%% Reboxing was also the #161 hazard -- boxed text under tagging can silently
%% become a bare /Artifact -- so avoiding the rebox removes that risk too rather
%% than merely testing for it. The test is kept regardless.
\RequirePackage { lua-ul }

%% Set true for exactly one link, by the \href wrapper installed below.
\bool_new:N \g__cdossier_components_hrefdeco_bool

%% Suppresses decoration for the links this toolkit renders itself, where the
%% visible text is the address. Local, so it lasts for one group.
\bool_new:N \l__cdossier_components_plainlinks_bool

%% \CDossierPlainLinks: a declaration, scoped to the enclosing group, that turns
%% link decoration off. Public because careerdossier-cv and careerdossier-biblatex
%% both render address-as-text links that this package cannot reach, and because
%% a document may legitimately want an undecorated region.
%%
%% Every one of those links displays the address through \nolinkurl or url.sty,
%% so the visible text already announces itself and needs no second cue -- which
%% is the split issue #278 settled deliberately rather than by default. On the
%% contact line in particular a rule under the e-mail and the website, but not
%% under the phone or the location, reads as `these two are emphasised' rather
%% than `these are links', because every item on that line is an identifier.
\NewDocumentCommand \CDossierPlainLinks { }
  { \bool_set_true:N \l__cdossier_components_plainlinks_bool }

%% \CDossierLinkStyle{<text>}: the semantic role. Under `medium=print', and
%% wherever \CDossierPlainLinks is in force, it is the identity.
%%
%% The rule sits at lua-ul's own depth, 0.75ex below the baseline, which is
%% font-relative and so clears descenders at every `fontsize' and under either
%% `bodyfont'. Its thickness is this project's shared \CDossierRuleThickness
%% instead of lua-ul's 0.1ex, so a link rule and a section rule are the same
%% weight and both scale with the body size.
%%
%% lua-ul states the rule as two signed offsets from the baseline, so the top
%% edge is the bottom edge plus the thickness.
\cs_new_protected:Npn \__cdossier_components_underline:n #1
  {
    \underLine
      [ bottom = -0.75ex , top = -0.75ex + \CDossierRuleThickness ]
      {#1}
  }

\NewDocumentCommand \CDossierLinkStyle { m }
  {
    \bool_lazy_and:nnTF
      { \l__cdossier_components_screen_bool }
      { ! \l__cdossier_components_plainlinks_bool }
      { \__cdossier_components_underline:n {#1} }
      {#1}
  }

%% Install the \href hook. Guarded on \hyper@link@ so a document without
%% hyperref, or a future hyperref that renames it, degrades to today's
%% undecorated output instead of failing; tests/regression asserts the hook is
%% actually in place, because a silent no-op here looks exactly like
%% `medium=print'.
\cs_new_protected:Npn \__cdossier_components_install_link_hook:
  {
    \NewCommandCopy \__cdossier_components_href_orig: \href
    \cs_set_protected:Npn \href
      {
        \bool_gset_true:N \g__cdossier_components_hrefdeco_bool
        \__cdossier_components_href_orig:
      }
    \cs_new_eq:Nc \__cdossier_components_hyperlink_orig:w { hyper@link@ }
    \cs_set_protected:cpn { hyper@link@ } [##1]##2##3##4
      {
        \bool_if:NTF \g__cdossier_components_hrefdeco_bool
          {
            \bool_gset_false:N \g__cdossier_components_hrefdeco_bool
            %% A blank argument is passed through untouched so hyperref still
            %% issues its own "Suppressing empty link" warning, which a
            %% \CDossierLinkStyle wrapper would make unreachable.
            \tl_if_blank:nTF {##4}
              { \__cdossier_components_hyperlink_orig:w [##1] {##2} {##3} {##4} }
              {
                \__cdossier_components_hyperlink_orig:w [##1] {##2} {##3}
                  { \CDossierLinkStyle {##4} }
              }
          }
          { \__cdossier_components_hyperlink_orig:w [##1] {##2} {##3} {##4} }
      }
  }

\AddToHook { package/hyperref/after }
  {
    \cs_if_exist:cT { hyper@link@ }
      { \__cdossier_components_install_link_hook: }
  }

%% Every link this package emits is guarded on \href, and the false branch is
%% the right behavior: the address stays visible, selectable, and extractable.
%% What the false branch has no way of announcing is that it was taken. The
%% page looks finished, and the author finds out by clicking a dead address in
%% the finished PDF. So say it once (issue #329).
%%
%% Once per document, not once per field: a contact line renders up to six
%% linked fields, and the cause is a single missing package, not six mistakes.
%% The flag is global because each contact item is rendered inside \hbox_set:Nn,
%% which would restore a local one before the next item could read it.
%%
%% Reported where the degradation happens rather than at \begin{document}, so a
%% document that emits no links at all is not warned about links. That also puts
%% the message after \START in the regression fixtures, where a baseline can
%% pin it.
\msg_new:nnnn { careerdossier-components } { links-inert }
  { Links~are~typeset~as~plain~text~because~hyperref~is~not~loaded. }
  {
    This~package~links~contact~fields~and~\CDossierLink\ with~\href,~which~
    hyperref~provides.~The~addresses~remain~visible,~selectable,~and~
    extractable,~but~nothing~in~the~PDF~is~clickable.~Load~hyperref,~or~use~
    one~of~the~supplied~classes,~which~load~it~for~you.
  }

\bool_new:N \g__cdossier_components_inertwarned_bool

%% Called from the false branch of every \href guard in the toolkit, including
%% the manual publication target in careerdossier-cv.
\cs_new_protected:Npn \__cdossier_components_links_inert:
  {
    \bool_if:NF \g__cdossier_components_inertwarned_bool
      {
        \bool_gset_true:N \g__cdossier_components_inertwarned_bool
        \msg_warning:nn { careerdossier-components } { links-inert }
      }
  }

%% Rewrite every raw `#' in a link target to \# in place (issue #353).
%%
%% A `#' in a profile value survives tokenization -- unlike `%', which the lexer
%% destroys before any package code can see it -- so it reaches here intact, at
%% catcode 6, and the displayed address already renders correctly. Only the
%% \href target fails, and it fails from inside hyperref: \Hy@tempa is built
%% with \edef, where a lone parameter character is "Illegal parameter number in
%% definition of \Hy@tempa" -- a diagnostic naming neither the field, nor the
%% value, nor the fix.
%%
%% THE OBVIOUS REPAIR IS THE WRONG ONE, AND FAILS SILENTLY. Handing hyperref a
%% catcode-12 string instead (\str_set:Nn) compiles with zero errors, which is
%% exactly why it is dangerous: hyperref reads an unescaped `#' as the fragment
%% delimiter and drops everything after it, so `example.com/a#b' emits
%%
%%     /URI(https://example.com/a)
%%
%% -- a loud build failure traded for a link that looks right on the page and
%% points at the wrong address, the same class of defect as issue #328. No
%% text-layer test can catch it, because the displayed address is correct either
%% way. Measured, not inferred: the two spellings were compared in an
%% uncompressed build, and only \# reaches the annotation intact.
%%
%% So the target has to carry \#, the one spelling hyperref preserves, and the
%% rewrite is a token substitution rather than a catcode change. l3regex is the
%% idiom that can express it: \cP matches the parameter catcode class, which an
%% \tl_replace_all:Nnn search argument cannot hold -- a lone parameter token
%% breaks expl3's own argument scanning before the replacement is ever reached.
%%
%% A value that already writes \# is a control sequence, not a parameter
%% character, so \cP\# does not match it and documents using the documented
%% escape are untouched.
%%
%% BOTH ARGUMENTS OF A LINK NEED THIS, not just the target. \nolinkurl is also
%% built on \hyper@normalise, and so also \edef's \Hy@tempa: measured on the
%% reproducer, rewriting only the target took the failure from five errors to
%% two, and the two that remained were the displayed address. The unlinked
%% branch below needs no rewrite -- nothing there reaches hyperref, and the
%% parameter character typesets as `#' on its own.
\cs_new_protected:Npn \__cdossier_components_hashescape:N #1
  { \regex_replace_all:nnN { \cP\# } { \c{\#} } #1 }

%% Link wrapper. The visible identifier is wrapped in \nolinkurl so long URLs
%% gain URL-aware breakpoints instead of overrunning the margin; the theme sets
%% \urlstyle{same} so the text stays in the body font rather than switching to
%% monospace. Degrades to plain visible text when hyperref is absent, so the
%% identifier is always present and extractable.
%%
%% The visible text here is the address, so the link is left plain under both
%% media -- see \CDossierPlainLinks above.
\cs_new_protected:Npn \__cdossier_components_link:nn #1#2
  {
    \cs_if_exist:NTF \href
      {
        \group_begin:
          \CDossierPlainLinks
          \tl_set:Nn \l__cdossier_components_target_tl {#1}
          \tl_set:Nn \l__cdossier_components_shown_tl  {#2}
          \__cdossier_components_hashescape:N \l__cdossier_components_target_tl
          \__cdossier_components_hashescape:N \l__cdossier_components_shown_tl
          \href { \l__cdossier_components_target_tl }
            { \nolinkurl { \l__cdossier_components_shown_tl } }
        \group_end:
      }
      { \__cdossier_components_links_inert: #2 }
  }
\cs_generate_variant:Nn \__cdossier_components_link:nn { VV }

%% Body-text link (issue #308). The contact line's items are packed as atomic
%% boxes, so its links only ever break at url.sty's own punctuation points. A
%% link inside running prose or a bullet has no such packer behind it: it is
%% one long token in a justified paragraph, and the three available forms all
%% fail differently.
%%
%%   - plain text has no URL breakpoints at all, so TeX either overruns the
%%     margin or *hyphenates* the address -- which sets an inserted hyphen that
%%     copy-and-paste then carries into the pasted URL;
%%   - \url breaks at punctuation only, so a long segment carrying none (a
%%     repository or report identifier) is still one unbreakable token: measured
%%     at 178.34 pt over the measure in a resume bullet at fontsize=10pt,
%%     margin=narrow, and worse at the larger sizes;
%%   - \emergencystretch cannot reach either case. It redistributes interword
%%     glue on the offending line, and a line holding one over-wide token has
%%     none to redistribute. See \CDossierEmergencyStretch (issue #272).
%%
%% So the break points have to be supplied. \UrlBreaks is extended, for the
%% duration of one link, with every ASCII letter and digit, which lets the
%% address break anywhere rather than only after punctuation. url.sty inserts a
%% penalty and no discretionary hyphen at these points, so a wrapped address
%% still reassembles exactly -- the copy-paste invariant of issue #294, which
%% tests/links now pins for body text as well as the contact line.
%%
%% The extension is local to the group below rather than a global change to
%% \UrlBreaks, so the contact line and the bibliography keep the punctuation-only
%% breaks they were measured with.
\tl_const:Nn \c__cdossier_components_anybreak_tl
  {
    \do \a \do \b \do \c \do \d \do \e \do \f \do \g \do \h \do \i
    \do \j \do \k \do \l \do \m \do \n \do \o \do \p \do \q \do \r
    \do \s \do \t \do \u \do \v \do \w \do \x \do \y \do \z
    \do \A \do \B \do \C \do \D \do \E \do \F \do \G \do \H \do \I
    \do \J \do \K \do \L \do \M \do \N \do \O \do \P \do \Q \do \R
    \do \S \do \T \do \U \do \V \do \W \do \X \do \Y \do \Z
    \do \0 \do \1 \do \2 \do \3 \do \4
    \do \5 \do \6 \do \7 \do \8 \do \9
  }

%% Normalize a link target in place: supply https:// when the value carries no
%% scheme of its own. Shared by the web-profile fields and by \CDossierLink so
%% both accept the same input, `example.org/path' as readily as a full URL.
%%
%% Detect an existing scheme by string, not by token list: the value's colon is
%% an ordinary character (catcode 12) while a literal colon in this package is a
%% letter (catcode 11) under expl3, so a catcode-sensitive \tl_if_in: would never
%% match and would double the scheme.
%%
%% The same catcode difference decides what the *inserted* scheme becomes, and
%% getting it wrong is silent. hyperref splits an \href target on a catcode-12
%% colon to find its scheme (\@hyper@readexternallink); a catcode-11 colon is
%% invisible to that split, so hyperref takes the target for a local file,
%% appends `.pdf', and emits a GoToR "open a remote PDF" action instead of a
%% URI action -- with no warning, and with the page, the extracted text, and
%% copy-paste integrity all still correct. Hence :Ne and \tl_to_str:n, which
%% put the scheme in at catcode 12, exactly as a document that wrote the
%% address out in full would (issue #328).
\cs_new_protected:Npn \__cdossier_components_scheme:N #1
  {
    \str_set:NV \l__cdossier_components_scheme_str #1
    \str_if_in:NnF \l__cdossier_components_scheme_str { :// }
      { \tl_put_left:Ne #1 { \tl_to_str:n { https:// } } }
  }

%% A URL cannot contain a literal space, so one in the argument is a mistake --
%% and in practice always the same mistake: the address was broken across two
%% source lines, and the line end became a space.
%%
%% It has to be removed rather than merely reported, because the two halves of
%% \CDossierLink treat it differently. url.sty discards spaces, so the *displayed*
%% address closes up and the page looks correct; \href's target is not processed
%% by url.sty and keeps the space, so the link silently points somewhere else.
%% Stripping the target restores the agreement the page already implies.
%%
%% Warn anyway. The removal is a repair, not a supported input format: the
%% author still wants to know, and %20 is what a genuine space is written as.
\msg_new:nnnn { careerdossier-components } { link-target-space }
  { Removed~a~space~from~the~\CDossierLink\ target~'#1'. }
  {
    A~URL~cannot~contain~a~literal~space,~and~the~displayed~address~drops~it~
    while~the~link~target~would~have~kept~it~--~so~the~text~and~the~link~would~
    disagree.~The~usual~cause~is~a~line~break~inside~the~argument:~keep~the~
    address~on~one~source~line.~Write~%20~if~the~space~is~real.
  }

%% \CDossierLink{<url>}: the supported way to put a link in body text. The
%% argument is both the displayed text and, once normalized, the link target.
%%
%% The argument is read as ordinary text, exactly as a profile field value is,
%% so a target containing TeX special characters needs them escaped. It is not
%% \url's verbatim argument.
\cs_new_protected:Npn \__cdossier_components_bodylink:n #1
  {
    \group_begin:
      \tl_set:Nn \l__cdossier_components_disp_tl {#1}
      \tl_set:Nn \l__cdossier_components_url_tl  {#1}
      \tl_remove_all:Nn \l__cdossier_components_url_tl { ~ }
      \tl_if_eq:NNF \l__cdossier_components_url_tl \l__cdossier_components_disp_tl
        {
          \msg_warning:nnV { careerdossier-components } { link-target-space }
            \l__cdossier_components_url_tl
        }
      \__cdossier_components_scheme:N \l__cdossier_components_url_tl
      \cs_if_exist:NT \UrlBreaks
        { \tl_put_right:NV \UrlBreaks \c__cdossier_components_anybreak_tl }
      \__cdossier_components_link:VV
        \l__cdossier_components_url_tl \l__cdossier_components_disp_tl
    \group_end:
  }

\NewDocumentCommand \CDossierLink { m }
  { \__cdossier_components_bodylink:n {#1} }

%% Email: a mailto: link over the visible address.
%%
%% \tl_to_str:n for the scheme, for the reason given at
%% \__cdossier_components_scheme:N. This one used to escape the consequences by
%% luck: it took the same wrong branch, but \@hyper@linkfile saw what looked
%% like an extension in the address's domain and fell back to a URL, so no
%% `.pdf' was appended. That is not something to rely on (issue #328).
\cs_new_protected:Npn \__cdossier_components_mail:n #1
  {
    \tl_set:Nx \l__cdossier_components_disp_tl { \CDossierFieldValue {#1} }
    \tl_set:Nx \l__cdossier_components_url_tl
      { \tl_to_str:n { mailto: } \l__cdossier_components_disp_tl }
    \__cdossier_components_link:VV \l__cdossier_components_url_tl \l__cdossier_components_disp_tl
  }

%% Services whose bare identifier has a documented canonical address, and the
%% prefix that produces it (issue #330). Authors hold a LinkedIn or GitHub
%% handle, not a profile path, and a Scholar identifier rather than the query
%% string around it -- so the natural value used to produce https://<handle>,
%% a broken link with no warning and a page that looked correct.
%%
%% The prefix carries no scheme: it is prepended to the *displayed* text, which
%% then becomes the target in the ordinary way, so the visible address and the
%% link agree by construction rather than by a second rule. `website' has no
%% canonical host by definition and is deliberately absent, which leaves its
%% behaviour exactly as before.
%%
%% Each value is braced because it is keyval input and two of them contain the
%% `=' that would otherwise be read as the item's own separator.
\prop_const_from_keyval:Nn \c__cdossier_components_canonical_prop
  {
    linkedin = {linkedin.com/in/} ,
    github   = {github.com/} ,
    scholar  = {scholar.google.com/citations?user=} ,
  }

\tl_new:N   \l__cdossier_components_canonical_tl
\str_new:N  \l__cdossier_components_value_str

%% A value is a bare identifier when it contains neither `/' nor `.'. Those two
%% characters are what every address form has -- with a scheme, without one, or
%% with a `www.' host -- and what none of these three services allows in an
%% identifier, so the test needs no list of hosts to keep current and no guess
%% about which address form was written. Anything holding either is passed
%% through untouched: canonicalizing `www.' or a trailing slash away would
%% change the output of documents that already work.
\cs_new_protected:Npn \__cdossier_components_canonical:n #1
  {
    \prop_get:NnNT \c__cdossier_components_canonical_prop {#1}
      \l__cdossier_components_canonical_tl
      {
        \str_set:NV \l__cdossier_components_value_str
          \l__cdossier_components_disp_tl
        \str_if_in:NnF \l__cdossier_components_value_str { / }
          {
            \str_if_in:NnF \l__cdossier_components_value_str { . }
              {
                \tl_put_left:NV \l__cdossier_components_disp_tl
                  \l__cdossier_components_canonical_tl
              }
          }
      }
  }

%% Web profile: a link over the visible address. A bare identifier for a service
%% with a canonical address is expanded to that address first, so the displayed
%% text is the value as given for every other input and the canonical form for
%% that one. The href target is then normalized to include a scheme.
\cs_new_protected:Npn \__cdossier_components_web:n #1
  {
    \tl_set:Nx \l__cdossier_components_disp_tl { \CDossierFieldValue {#1} }
    \__cdossier_components_canonical:n {#1}
    \tl_set_eq:NN \l__cdossier_components_url_tl \l__cdossier_components_disp_tl
    \__cdossier_components_scheme:N \l__cdossier_components_url_tl
    \__cdossier_components_link:VV \l__cdossier_components_url_tl \l__cdossier_components_disp_tl
  }

%% ORCID: unlike an ordinary web-profile value, a bare ORCID identifier has a
%% documented canonical destination. Keep the identifier visible with a text
%% label, so its meaning does not depend on a colour, icon, or link annotation.
\cs_new_protected:Npn \__cdossier_components_orcid:
  {
    \tl_set:Nx \l__cdossier_components_disp_tl { \CDossierFieldValue { orcid } }
    \tl_set_eq:NN \l__cdossier_components_url_tl \l__cdossier_components_disp_tl
    \str_set:NV \l__cdossier_components_scheme_str \l__cdossier_components_url_tl
    \str_if_in:NnF \l__cdossier_components_scheme_str { :// }
      {
        %% :Ne and \tl_to_str:n for the reason given at
        %% \__cdossier_components_scheme:N -- a catcode-11 colon here would
        %% make the ORCID link a GoToR action (issue #328).
        \str_if_in:NnTF \l__cdossier_components_scheme_str { orcid.org/ }
          { \tl_put_left:Ne \l__cdossier_components_url_tl
              { \tl_to_str:n { https:// } } }
          { \tl_put_left:Ne \l__cdossier_components_url_tl
              { \tl_to_str:n { https://orcid.org/ } } }
      }
    %% This branch builds its own \href rather than going through
    %% \__cdossier_components_link:nn, so it needs the raw-`#' rewrite the
    %% chokepoint applies (issue #353). An ORCID identifier holds no `#', but
    %% the value is author-supplied and a mistyped one would otherwise fail
    %% with hyperref's internal diagnostic while every other field no longer
    %% does.
    \__cdossier_components_hashescape:N \l__cdossier_components_url_tl
    \__cdossier_components_hashescape:N \l__cdossier_components_disp_tl
    \cs_if_exist:NTF \href
      {
        \group_begin:
          \CDossierPlainLinks
          \href { \l__cdossier_components_url_tl }
            { ORCID:\nobreakspace \nolinkurl { \l__cdossier_components_disp_tl } }
        \group_end:
      }
      {
        \__cdossier_components_links_inert:
        ORCID:\nobreakspace \l__cdossier_components_disp_tl
      }
  }

%% Render one contact field: an optional identifying label, then the value —
%% linked for the web-facing fields, plain text for the rest.
%%
%% The linked branches need no explicit content marking: hyperref opens its own
%% structure element inside the box. An unlinked value does not, so it is marked
%% here for the same reason the label above is.
\cs_new_protected:Npn \__cdossier_components_render:n #1
  {
    \__cdossier_components_label:n {#1}
    \str_case:nnF {#1}
      {
        { email }    { \__cdossier_components_mail:n { email }    }
        { website }  { \__cdossier_components_web:n  { website }  }
        { linkedin } { \__cdossier_components_web:n  { linkedin } }
        { github }   { \__cdossier_components_web:n  { github }   }
        { scholar }  { \__cdossier_components_web:n  { scholar }  }
        { orcid }    { \__cdossier_components_orcid:              }
      }
      { \__cdossier_typography_text_content:n { \CDossierPrintField {#1} } }
  }

%% Render one complete contact item into a box.  If the item cannot fit even on
%% an otherwise empty line, stop with a field-specific diagnostic instead of
%% silently splitting it or producing knowingly overfull output.
\cs_new_protected:Npn \__cdossier_components_contactitem_set:n #1
  {
    \hbox_set:Nn \l__cdossier_components_contact_box
      { \__cdossier_components_render:n {#1} }
    \dim_compare:nNnT
      { \box_wd:N \l__cdossier_components_contact_box }
      >
      { \linewidth }
      {
        \msg_error:nnn
          { careerdossier-components }
          { contact-item-too-wide }
          {#1}
      }
  }

%% Ship one packed contact row at the full available width.  The stretch on
%% either side centers the already-packed atomic items without introducing any
%% breakpoints or changing their extraction order.
\cs_new_protected:Npn \__cdossier_components_contactline_ship:
  {
    \noindent
    \hbox_to_wd:nn { \linewidth }
      {
        \hfil
        \box_use_drop:N \l__cdossier_components_contact_line_box
        \hfil
      }
    \par
  }

%% Build a contact line from a caller-supplied ordered field list. This keeps
%% link normalization and separator insertion component-owned while allowing a
%% document class to display only the contacts relevant to its document model.
%% Rows are packed greedily in fixed field order. Separators are added only
%% after two atomic items are known to fit on the same row, so a bar can never
%% be orphaned at either visual edge.
\cs_new_protected:Npn \__cdossier_components_contactline:N #1
  {
    \bool_set_false:N \l__cdossier_components_printed_bool
    \hbox_set:Nn \l__cdossier_components_contact_candidate_box { ~|~ }
    \dim_set:Nn \l__cdossier_components_contact_sep_dim
      { \box_wd:N \l__cdossier_components_contact_candidate_box }
    \clist_map_inline:Nn #1
      {
        \CDossierIfFieldTF {##1}
          {
            \__cdossier_components_contactitem_set:n {##1}
            \bool_if:NTF \l__cdossier_components_printed_bool
              {
                \dim_compare:nNnTF
                  {
                    \box_wd:N \l__cdossier_components_contact_line_box
                    + \l__cdossier_components_contact_sep_dim
                    + \box_wd:N \l__cdossier_components_contact_box
                  }
                  >
                  { \linewidth }
                  {
                    \__cdossier_components_contactline_ship:
                    \box_set_eq_drop:NN
                      \l__cdossier_components_contact_line_box
                      \l__cdossier_components_contact_box
                  }
                  {
                    \hbox_set:Nn
                      \l__cdossier_components_contact_candidate_box
                      {
                        \box_use_drop:N
                          \l__cdossier_components_contact_line_box
                        \__cdossier_components_sep:
                        \box_use_drop:N \l__cdossier_components_contact_box
                      }
                    \box_set_eq_drop:NN
                      \l__cdossier_components_contact_line_box
                      \l__cdossier_components_contact_candidate_box
                  }
              }
              {
                \box_set_eq_drop:NN
                  \l__cdossier_components_contact_line_box
                  \l__cdossier_components_contact_box
                \bool_set_true:N \l__cdossier_components_printed_bool
              }
          }
          { }
      }
    \bool_if:NT \l__cdossier_components_printed_bool
      { \__cdossier_components_contactline_ship: }
  }

%% Typeset the complete contact block. Packing is deterministic, so no
%% emergency stretch or paragraph-internal breakpoint is required.
\cs_new_protected:Npn \__cdossier_components_contactparagraph:N #1
  {
    \group_begin:
      \__cdossier_components_contactline:N #1
    \group_end:
  }

%% Default identity contact line used by the released résumé, CV, and letter
%% classes. Its order and output remain unchanged.
\cs_new_protected:Npn \__cdossier_components_contactline:
  {
    \__cdossier_components_contactline:N
      \c__cdossier_components_contactorder_clist
  }

\cs_new_protected:Npn \__cdossier_components_contactparagraph:
  {
    \__cdossier_components_contactparagraph:N
      \c__cdossier_components_contactorder_clist
  }

%% ---------------------------------------------------------------------------
%% Header stack -- public composition API.
%%
%% Issue #204: one emission site for every centered header line and every gap
%% between two of them, shared by \MakeCDossierHeader below and by
%% \MakeCDossierStatementHeader. Both headers are the same shape -- a name, a
%% run of optional lines, and a contact line -- and both used to attach each gap
%% as a *leading* skip on the optional block that followed it. That is the
%% "separator attached to the item" shape the project forbids everywhere else,
%% and it hid a defect: which token guarded the boundary below the name depended
%% on whether an optional field two lines further down happened to be present.
%%
%% Issue #224: the stack is public. \MakeCDossierHeader renders a fixed
%% three-line identity block, but the statement needs up to six lines whose
%% extra ones *interleave* with it -- its title sits between the name and the
%% contact line -- so neither an append-only hook nor a split into "identity,
%% then metadata" preserves the reading order. The statement therefore composed
%% its header by driving this module's private primitives, which is a boundary
%% leak. \CDossierHeaderBegin, \CDossierHeaderLine, and \CDossierHeaderEnd are
%% those primitives promoted verbatim, and both wrappers now compose over them.
%% Spelled as a command triple rather than a `CDossierHeader' environment: an
%% environment reads more idiomatically only if its body is genuinely restricted
%% to line calls, and here it is not -- a caller interleaves arbitrary
%% conditionals between lines, as both wrappers below do.
%%
%% Going public moves nothing else across the boundary. The component still owns
%% every gap and the triple adds no spacing knob, and validation stays with the
%% wrappers: neither `name' nor a statement type is a precondition of stacking
%% lines.
%%
%% A caller pushes only the lines it will actually print, in reading order, and
%% the helper interleaves the gaps. Position decides the token, not presence:
%% the boundary below the name is always \CDossierSharedHeaderNameGapSkip and
%% every later boundary is \CDossierSharedHeaderMetaGapSkip, whatever the line
%% below it turns out to be.
%%
%% Each line is its own paragraph, so `\parskip' lands in every boundary. In the
%% prose classes that is a visible gap the header tokens could not express a
%% value below, and `\addvspace' cannot absorb it: `\parskip' is inserted at the
%% next paragraph's start, after `\addvspace' has already read `\lastskip', so
%% the two always add. The stack therefore zeroes `\parskip' for its own group
%% and subtracts it from every gap it emits inside that group, so each
%% between-line token names the rendered gap in every class.
%%
%% Issue #220: that isolation is load-bearing and must stay, but the zero is not
%% a tunable. It used to come from a public \CDossierSharedHeaderParSkip, which
%% cancelled itself algebraically: the stack emitted every gap as
%% `gap - \parskip' and the following header line then contributed `\parskip'
%% again, so the rendered gap was `gap' for every value of the token. It is now
%% a literal zero; the subtraction below is kept because it is the project-wide
%% emission contract for a paragraph boundary, not because `\parskip' can be
%% non-zero here.
%%
%% Issue #419: the boundary below the stack is not inside that group -- it is
%% emitted after `\group_end:' has restored the class's real `\parskip', which
%% is non-zero in the two prose classes. There the same subtraction is
%% load-bearing rather than a no-op, so \CDossierHeaderEnd routes that boundary
%% through the same \__cdossier_components_headerstack_gap:N helper the
%% between-line boundaries use: one emission contract, applied wherever a
%% paragraph follows, whether `\parskip' happens to be zero or not.
%%
%% Issue #223: the gaps *between* two header lines are genuinely shared -- every
%% class stacks the same shape and the group-local zero above makes the same
%% ratio render the same gap in all four. The gap *below* the stack is not: it
%% is a boundary against whatever the class puts next, and that neighbour
%% differs per family. The rendering class therefore names its own token once at
%% load time and the stack emits that. The default is the record token, which is
%% what a document that loads this package without one of the four classes gets.
%% ---------------------------------------------------------------------------
\seq_new:N \l__cdossier_components_headerstack_seq
\int_new:N \l__cdossier_components_headerline_int
\tl_new:N \l__cdossier_components_headerbelow_tl
\tl_set:Nn \l__cdossier_components_headerbelow_tl
  { \CDossierRecordHeaderBelowSkip }

%% Name the token owning the boundary below the header stack. It is stored by
%% name rather than by value because the calibrated skips are resolved from the
%% class options, so a value copied at load time could predate `fontsize'.
\cs_new_protected:Npn \__cdossier_components_headerbelow:N #1
  { \tl_set:Nn \l__cdossier_components_headerbelow_tl {#1} }

\NewDocumentCommand \CDossierHeaderBegin { }
  { \seq_clear:N \l__cdossier_components_headerstack_seq }

%% The argument is stored unexpanded and re-used once, so a line may carry
%% structure -- the name and the statement's title line each wrap themselves in
%% \__cdossier_typography_heading:nnn and keep their heading tagging.
\NewDocumentCommand \CDossierHeaderLine { m }
  { \seq_put_right:Nn \l__cdossier_components_headerstack_seq {#1} }

%% A gap that precedes a paragraph has to be reduced by the `\parskip' that
%% paragraph contributes on its own; see the block comment above. Every
%% boundary the stack emits routes through this one helper, including the
%% boundary below the stack (issue #419), so `\parskip' is read wherever it is
%% not already zeroed for the group.
\cs_new_protected:Npn \__cdossier_components_headerstack_gap:N #1
  { \addvspace { \dim_eval:n { #1 - \parskip } } }

\NewDocumentCommand \CDossierHeaderEnd { }
  {
    \seq_if_empty:NF \l__cdossier_components_headerstack_seq
      {
        \group_begin:
          \skip_zero:N \parskip
          \centering
          \int_zero:N \l__cdossier_components_headerline_int
          \seq_map_inline:Nn \l__cdossier_components_headerstack_seq
            {
              \int_incr:N \l__cdossier_components_headerline_int
              \int_case:nnF { \l__cdossier_components_headerline_int }
                {
                  %% Issue #220: the first line has no boundary above it inside
                  %% the stack. The retired \CDossierSharedHeaderAboveSkip
                  %% claimed one, but a header is always the first material on
                  %% its page, where TeX discards the glue -- so it rendered
                  %% nothing at any value.
                  { 1 } { }
                  { 2 }
                    {
                      \__cdossier_components_headerstack_gap:N
                        \CDossierSharedHeaderNameGapSkip
                    }
                }
                {
                  \__cdossier_components_headerstack_gap:N
                    \CDossierSharedHeaderMetaGapSkip
                }
              %% The `\par' belongs inside the line's own group so the paragraph
              %% is broken with that line's leading, not the surrounding one's.
              \group_begin:
                ##1
                \par
              \group_end:
            }
        \group_end:
        \exp_args:No \__cdossier_components_headerstack_gap:N
          \l__cdossier_components_headerbelow_tl
      }
  }

%% ---------------------------------------------------------------------------
%% Identity block.
%%
%% A centered block of name, optional headline, and the contact line, shared by
%% the résumé header and the cover-letter sender identity. Requires `name`.
%% A thin wrapper over the public header stack above: it owns the validation and
%% the choice of the three lines, and nothing else.
%% ---------------------------------------------------------------------------
%% Issue #267: the name is the document identity and outranks every other
%% heading, so it is depth 1 of the shared heading primitive -- the only line
%% in this stack that is.
\NewDocumentCommand \MakeCDossierHeader { }
  {
    \__cdossier_base_require_name:N \MakeCDossierHeader
    \CDossierHeaderBegin
    \CDossierHeaderLine
      {
        %% Issue #305: the name is passed twice on purpose. The second group is
        %% the rendered line; the first is the same text unformatted, which
        %% becomes the heading element's `/T'. Both read the same field, so
        %% they cannot drift.
        %%
        %% The title argument uses \CDossierFieldValue, not
        %% \CDossierPrintField. The title is purified before it is written, and
        %% purification expands what it can and *discards* what it cannot:
        %% \CDossierPrintField is protected, so it survives as a stripped
        %% command whose argument text remains, and the recorded title came out
        %% as the literal string `name' rather than as the applicant's. A wrong
        %% title is worse than none, and nothing about the rendered page shows
        %% it, so the tagging fixture asserts the value.
        \__cdossier_typography_heading:nnn { 1 }
          { \CDossierFieldValue { name } }
          {
            \CDossierNameStyle
            \CDossierSizeName
            \CDossierPrintField { name }
          }
      }
    \CDossierIfFieldTF { headline }
      {
        \CDossierHeaderLine
          {
            \CDossierHeadlineStyle
            \CDossierSizeHeadline
            \CDossierPrintField { headline }
          }
      }
      { }
    \CDossierHeaderLine
      {
        \CDossierBodyStyle
        \CDossierSizeSmall
        \__cdossier_components_contactparagraph:
      }
    \CDossierHeaderEnd
  }

%% ---------------------------------------------------------------------------
%% Page furniture.
%%
%% All document classes share one page-style pair. Under the default
%% `medium=print' a multi-page document gets a centered "Page N of M" folio
%% throughout and a centered identity label from page two. A one-page document
%% gets no furniture. The total comes from the LaTeX kernel's last absolute
%% page, recorded in the auxiliary file, so the single-page decision settles on
%% the second pass. On the first clean pass the kernel supplies \maxdimen as the
%% unknown total and the folio is provisionally shown.
%%
%% Under `medium=screen' no furniture is emitted on any page and the page-style
%% pair is never selected.
%%
%% Page-style material is artifact-marked by the kernel's tagged-PDF shipout
%% path. Do not wrap it in document structure here.
%% ---------------------------------------------------------------------------
\tl_new:N \l__cdossier_components_runninglabel_tl

%% A class registers the short document label used after page one. Statement
%% classes may pass a token-list reference so a later preamble setup command
%% can change the value before shipout.
\cs_new_protected:Npn \__cdossier_components_runninglabel:n #1
  { \tl_set:Nn \l__cdossier_components_runninglabel_tl {#1} }

\prg_new_conditional:Npnn \__cdossier_components_if_multipage: { T , F , TF }
  {
    \int_compare:nNnTF { \use:c { @abspage@last } } > { 1 }
      { \prg_return_true: }
      { \prg_return_false: }
  }

\cs_new:Npn \__cdossier_components_runninghead:
  {
    \hfil
    {
      \sffamily
      \CDossierSizeFurniture
      \CDossierTextColor
      \CDossierFieldValue { name }
      \enspace -- \enspace
      \tl_use:N \l__cdossier_components_runninglabel_tl
    }
    \hfil
  }

\cs_new:Npn \__cdossier_components_folio:
  {
    \__cdossier_components_if_multipage:T
      {
        \hfil
        {
          \sffamily
          \CDossierSizeFurniture
          \CDossierTextColor
          Page~\thepage\space of~\use:c { @abspage@last }
        }
        \hfil
      }
  }

\makeatletter
\def\ps@cdossierfurniture{%
  \let\@mkboth\@gobbletwo
  \def\@oddhead{\__cdossier_components_runninghead:}%
  \let\@evenhead\@oddhead
  \def\@oddfoot{\__cdossier_components_folio:}%
  \let\@evenfoot\@oddfoot
}
\def\ps@cdossierfurniturefirst{%
  \let\@mkboth\@gobbletwo
  \def\@oddhead{}%
  \let\@evenhead\@oddhead
  \def\@oddfoot{\__cdossier_components_folio:}%
  \let\@evenfoot\@oddfoot
}
\makeatother

%% Issue #242: named \MakeCDossierPageFurniture until v0.7.0, which put it in
%% the same family as \MakeCDossierHeader, \MakeCDossierLetterhead,
%% \MakeCDossierClosing, and \MakeCDossierStatementHeader. It does not belong
%% there: every one of those emits document material where the author calls it,
%% while this one emits nothing at all. It selects a \pagestyle and queues an
%% \AtBeginDocument hook, so it is only meaningful in a class preamble -- by the
%% time a document body could call it the hook has already run. It is the same
%% class-to-package plumbing as \__cdossier_components_headerbelow:N alongside
%% it, and now carries the same private form. See docs/MIGRATION.md.
\cs_new_protected:Npn \__cdossier_components_apply_page_furniture:
  {
    \bool_if:NTF \l__cdossier_components_furniture_bool
      {
        \pagestyle { cdossierfurniture }
        \AtBeginDocument { \thispagestyle { cdossierfurniturefirst } }
      }
      {
        %% medium=screen. The empty style is selected explicitly rather than
        %% simply left alone: the base class's default `plain' would otherwise
        %% put a bare page number in the foot, which is the very furniture this
        %% value asks to remove.
        \pagestyle { empty }
        \AtBeginDocument { \thispagestyle { empty } }
      }
  }

%% ---------------------------------------------------------------------------
%% Section rule.
%%
%% Shared by the résumé and CV. The rule is a rendered component rather than a
%% paragraph line: suppressing interline glue on both sides makes the calibrated
%% rule skips own the complete heading-to-rule and rule-to-content gaps. The
%% rule remains a layout artifact in tagged output, and the keep penalty still
%% binds the complete heading/rule unit to the content that follows.
%%
%% Issue #169: `\CDossierRecordSectionRuleGapSkip' is measured from the
%% heading's *baseline*, not from the bottom of its line box. A line box is as
%% deep as its deepest glyph, so a box-relative offset dropped the rule further
%% under `Experience' (p) than under `Education' -- 4.80 pt versus 2.28 pt at
%% 11 pt, a visible 2.1x swing within one document. The baseline is the line
%% the reader perceives, and it is what rules and underlines are conventionally
%% set from, so the offset is taken from there and the token means exactly what
%% it says.
%%
%% `\prevdepth' carries the heading line's depth here, because the heading
%% primitive ends with `\par'. Subtracting it converts the token from a
%% baseline distance into the box-relative skip TeX needs, and reading it before
%% `\nointerlineskip' matters: that command sets `\prevdepth' to -1000pt.
%%
%% The token must therefore exceed the heading's depth, or the rule would be
%% drawn through descender ink. The shared smoke regression asserts that lower
%% bound rather than clamping it here, so an unusable value fails loudly instead
%% of silently reverting to glyph-dependent placement.
%% ---------------------------------------------------------------------------
\dim_new:N \l__cdossier_components_headingdepth_dim

%% ---------------------------------------------------------------------------
%% \__cdossier_components_section_need: -- the section heading's keep, as a
%% bound (issue #333).
%%
%% Called in vertical mode immediately before a section heading contributes
%% anything. If fewer than \CDossierSectionNeedLines lines of body leading remain
%% on the current page, the page ends here and the heading opens the next one.
%% Otherwise nothing is contributed at all, and every boundary the section goes
%% on to create stays a legal breakpoint.
%%
%% `\pagegoal' is `\maxdimen' until the first box lands on a page, which is both
%% the start of the document and the moment after a page break. Testing the
%% remaining space then would compare against an effectively infinite goal and
%% always succeed, which is harmless -- but the guard is written explicitly
%% because the failure it prevents is the opposite one: were the comparison
%% inverted or the sentinel forgotten, every section would force a page break and
%% every document would become one section per page. The smoke and layout
%% fixtures would catch that, but not as directly as this reads.
%%
%% `\penalty -\CDossierHeadingKeepPenalty' rather than `\newpage': this runs
%% before the section's own `\addvspace', so the forced break discards the glue
%% at the boundary in the ordinary way, and the heading arrives at the top of the
%% next page with no leading skip. `\newpage' would contribute a `\vfil' first.
%% ---------------------------------------------------------------------------
%% Issue #337 generalised the body to take the bound as an argument, so the
%% second heading level states its own line count (\CDossierSubsectionNeedLines)
%% through the same code rather than through a second copy of it. The
%% section-specific name is kept because both record classes call it.
\cs_new_protected:Npn \__cdossier_components_heading_need:N #1
  {
    \dim_compare:nNnF { \tex_pagegoal:D } = { \c_max_dim }
      {
        \dim_compare:nNnT
          { \tex_pagegoal:D - \tex_pagetotal:D } <
          { #1 \CDossierBodyLeading }
          { \penalty -\CDossierHeadingKeepPenalty }
      }
  }

\cs_new_protected:Npn \__cdossier_components_section_need:
  { \__cdossier_components_heading_need:N \CDossierSectionNeedLines }

%% ---------------------------------------------------------------------------
%% \__cdossier_components_section_is_empty:TF -- "nothing has been typeset since
%% the section heading" (issue #337).
%%
%% A section that opens directly with a subsection must not show a wider gap than
%% the same section opening with an entry. `careerdossier-statement.cls' gets
%% that from `\@startsection', which guards its before-skip with `\if@nobreak';
%% the record classes render their headings through the shared primitive instead,
%% so they need their own answer to the same question.
%%
%% The answer is `\prevdepth', read in vertical mode, and it is a *derived* fact
%% rather than a flag anything has to maintain. `\prevdepth' is the depth of the
%% last box on the current vertical list, and the only thing in this toolkit that
%% sets it to the -1000pt sentinel is the `\nointerlineskip' that closes
%% \__cdossier_components_section_rule: below. Any box at all after that -- an
%% entry heading line, a list item's first line, a line of free prose -- replaces
%% the sentinel with a real depth. So the sentinel means exactly "the section
%% rule was the last thing contributed", which is the condition being tested.
%%
%% Three mechanisms were tried and rejected before this one, and the reasons are
%% worth keeping because each looks correct until it is built:
%%
%%   * the kernel's own `@nobreak'. `\@item' reads that flag: with it true, a
%%     list opening a section takes `\@nbitem' instead of `\addvspace\@topsep',
%%     which would silently replace \CDossierRecordListEdgeAboveSkip for every
%%     list that opens a section -- and `\CDossierSection{Publications}' followed
%%     straight by CDossierPublications is a committed example.
%%   * a private boolean armed as an `\everypar', which is how `\@afterheading'
%%     carries the kernel's version. Assigning `\everypar' discards whatever the
%%     kernel already has there, and a list started afterwards then fails with
%%     "Something's wrong--perhaps a missing \item": `\@item''s own
%%     `\global\@newlistfalse' never runs for the first item. Restoring the
%%     previous value in turn needs a token register and an unexpanded round
%%     trip, which is a lot of machinery for a fact `\prevdepth' already holds.
%%   * the `para/begin' paragraph hook, which is the tidiest signal of all and
%%     is off unless a document enables the paragraph hooks, so it cannot carry
%%     a default-path guard.
%%
%% The one other state that reads as the sentinel is the very start of the main
%% vertical list, where a subsection would be the document's first material. Both
%% things the test guards are already right there: leading glue at the top of a
%% page is discarded, and `\pagegoal' is still `\maxdimen', so the need-check
%% below would decline to fire anyway.
%%
%% This couples the subsection to the last line of the section rule. That is a
%% real coupling and it is deliberate -- the alternatives above all couple to
%% something less stable -- so `tests/regression/resume-subsection-edges.lvt'
%% reports this verdict in every position a subsection can arrive at, and pins
%% the glue each branch actually leaves on the vertical list.
%% ---------------------------------------------------------------------------
\prg_new_protected_conditional:Npnn \__cdossier_components_section_is_empty:
  { T , F , TF }
  {
    \dim_compare:nNnTF { \tex_prevdepth:D } < { -999pt }
      { \prg_return_true: }
      { \prg_return_false: }
  }

\cs_new_protected:Npn \__cdossier_components_section_rule:
  {
    \dim_set:Nn \l__cdossier_components_headingdepth_dim { \tex_prevdepth:D }
    \nointerlineskip
    \skip_vertical:n
      {
        \CDossierRecordSectionRuleGapSkip
        - \l__cdossier_components_headingdepth_dim
      }
    \noindent
      {
        \CDossierRuleColor
        \__cdossier_typography_layout_artifact:n
          { \rule { \linewidth } { \CDossierRuleThickness } }
      }
    \par
    \nointerlineskip
    %% Issue #333: no penalty here any more. A `\penalty
    %% \CDossierHeadingKeepPenalty' at this point forbids the break after the
    %% rule without bounding what it thereby commits to the page -- the keep
    %% runs to the next legal breakpoint, wherever that happens to fall.
    %%
    %% Issue #340: it also leaked. With no content after it, the penalty was
    %% left sitting immediately before the gap glue below, and a break at glue is
    %% legal only when a non-discardable item precedes it; the next section's
    %% `\addvspace' collapses into that same glue rather than putting a box
    %% between them, so an empty section made its own closing boundary illegal to
    %% break at. Three consecutive empty sections left zero legal breakpoints.
    %%
    %% The keep now sits *before* the heading, as a requirement rather than a
    %% prohibition: \__cdossier_components_section_need: refuses to place the
    %% heading unless \CDossierSectionNeedLines lines remain. That bounds it, and
    %% it leaves every boundary inside the section legal, so a page fills to the
    %% last entry that fits instead of dumping the whole section.
    %% Issue #168: the rule-to-content gap must be *this* token, not this token
    %% plus whatever leading space the following block contributes. `\vspace'
    %% cannot deliver that: `\@vspace' appends `\vskip\z@skip', so the following
    %% block's `\addvspace' sees `\lastskip' as zero and adds instead of
    %% collapsing. `\addvspace' leaves the skip visible, so LaTeX's usual
    %% collapsing rule applies and the gap is the larger of the two -- never
    %% their sum -- for entry-led, list-led, and prose-led sections alike.
    %% Issue #337: the `\nointerlineskip' above is also what
    %% \__cdossier_components_section_is_empty:TF reads. `\addvspace' does not
    %% touch `\prevdepth', so the sentinel survives to the next block and a
    %% subsection arriving with nothing in between can recognise itself as the
    %% section's opening material. Anything contributed here that sets
    %% `\prevdepth' would break that; the fixture named there catches it.
    \addvspace { \CDossierRecordSectionBelowSkip }
  }

%% ---------------------------------------------------------------------------
%% \__cdossier_components_subsection:n {title} -- the record classes' second
%% heading level (issue #337).
%%
%% One renderer, shared by both record classes, for the reason
%% `careerdossier-statement.cls' gives for wrapping one `\@startsection' twice:
%% the tokens and the tagged structure cannot then drift between the two
%% spellings. The classes' own `\CDossierSection' is hand-rolled twice already;
%% a second hand-rolled heading is the point at which that risk doubles.
%%
%% Depth 3. Issue #267 fixed the document identity as the one depth-1 heading
%% and a section at depth 2, so `sec/3/title' is the level under a section and
%% maps to `/H3' the same way `sec/2/title' maps to `/H2'. The division
%% machinery needs nothing new: `sec/end' closes every division at this depth or
%% deeper before a sibling opens, and a depth-3 division nests inside the
%% depth-2 one its section opened.
%%
%% No rule, and no size of its own. The full-width rule is the section's mark and
%% repeating it at the second level flattens the hierarchy the level exists to
%% show; \CDossierSectionStyle at \CDossierSizeBody is the statement's precedent
%% for the same level, and the type scale has nothing between
%% \CDossierSizeSection and \CDossierSizeBody to reach for.
%%
%% Two things are conditional on "nothing has been typeset since the section
%% heading" -- \__cdossier_components_section_is_empty:TF -- and they stand or
%% fall together:
%%
%%   * the above-skip, so the boundary is \CDossierRecordSectionBelowSkip alone
%%     and a section opening with a subsection leaves the same gap as one
%%     opening with an entry;
%%   * the need-check, because the section's own four-line bound already placed
%%     this material and re-testing it here could only break the page between a
%%     section heading and the subsection under it -- the stranding issue #145
%%     forbids.
%%
%% Nothing else is conditional. The division, the heading, the penalty, and the
%% below-skip are emitted the same way in both branches.
%%
%% Issue #340: the `\penalty` after the heading. The shared heading primitive
%% ends `\par \nobreak', and a break at glue is legal only when a non-discardable
%% item precedes it, so the below-skip that follows an infinite penalty is not a
%% breakpoint at all. A section survives this because its rule puts a box between
%% the two; a subsection has no rule, so without this penalty a run of empty
%% subsections would leave no legal breakpoint anywhere in it -- exactly the
%% failure #340 fixed for empty sections. Zero, not a discount: under the
%% `\raggedbottom' every class inherits, short-page candidates all cost the same,
%% so this restores the breakpoint without making it attractive, and the
%% need-check above is what bounds the heading.
%% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__cdossier_components_subsection:n #1
  {
    \par
    \__cdossier_components_section_is_empty:F
      {
        \__cdossier_components_heading_need:N \CDossierSubsectionNeedLines
        \addvspace { \CDossierRecordSubsectionAboveSkip }
      }
    \__cdossier_typography_division_begin:n { 3 }
    \__cdossier_typography_heading:nnn { 3 } { #1 }
      { { \CDossierSectionStyle \CDossierSizeBody #1 \par } }
    \penalty \c_zero_int
    \addvspace { \CDossierRecordSubsectionBelowSkip }
  }

%% ---------------------------------------------------------------------------
%% Structure-text separator fallback (issue #302).
%%
%% `\pdffakespace' is tagpdf's; it emits a real U+0020 into the content stream
%% at zero rendered width, so a gap made of glue alone still reads as a word
%% boundary to a consumer of the structure tree. It exists only when tagpdf is
%% loaded, which is only when the document asked for tagging. Every call site
%% in this package is therefore on a path that must also work untagged, and on
%% that path the command must simply do nothing.
%%
%% The fallback is declared at \begin{document} rather than here. tagpdf uses
%% \NewDocumentCommand, which errors on an existing definition, so a
%% \providecommand at package-load time would not merely lose the race -- it
%% would break the tagged build outright. By \begin{document} tagpdf has either
%% defined the command or is not present at all.
%%
%% Shared deliberately: careerdossier-letter.cls needs the same fallback for
%% its recipient block, and every class loads this package.
%% ---------------------------------------------------------------------------
\AddToHook { begindocument } { \providecommand \pdffakespace { } }

%% The join between a heading line's left cell and its right cell. Under
%% `column' the cells are pushed to opposite margins by `\hfill', which emits no
%% character at all, so \pdffakespace supplies the word boundary the structure
%% text would otherwise lack (issue #302). Under `inline' they are adjacent and
%% the visible separator supplies it as ordinary glue (issue #230).
%%
%% Named rather than written out because the join is the *whole* of what
%% `entrymeta' changes: neither value may differ in cell order, in the semantic
%% roles the cells take, in the page-break penalty between the two lines, or in
%% the conditions under which a cell or a line is emitted at all. The second
%% heading line guards the join itself and so does not call this -- see there.
\cs_new_protected:Npn \__cdossier_components_entryjoin:
  {
    \bool_if:NTF \l__cdossier_components_entrymeta_inline_bool
      { \CDossierEntryMetaSeparator }
      { \pdffakespace \hfill }
  }

%% ---------------------------------------------------------------------------
%% Entry heading primitive.
%%
%% Renders a single entry heading shared by résumé sections (experience,
%% education, projects, ...). It takes a required title and up to three optional
%% metadata fields, and carries no page geometry or vertical spacing of its own:
%% the owning class decides how much room surrounds an entry. Layout:
%%
%%   Title .......................................... dates
%%   Organization ................................... location
%%
%% Each optional cell is emitted only when its value is nonblank, so a missing
%% field leaves no dangling punctuation, separator, or empty second line. The
%% second line is emitted only when organization or location is present.
%%
%% Issue #219: the right-hand column's *extraction* order is not decided here.
%% Poppler builds reading order from glyph positions alone, and once a bullet
%% list closes up against the heading it groups the heading's left column and
%% the list into one tall block -- which it then reads as the left column of a
%% two-column page and emits before the dates. The trigger is page-level: the
%% same code extracts correctly at the same list gap as soon as any body line
%% happens to reach the dates' horizontal band.
%%
%% Do not try to repair that from inside this macro. The heading row is already
%% a single line box in source order, which is not what Poppler groups on;
%% adjusting the two heading lines' spacing does not split the block; and every
%% invisible bridging character is either discarded (U+0020, U+00A0, U+200B) or
%% missing from TeX Gyre Heros (U+2000, U+2002, U+2003, U+2007, U+2009, and
%% U+205F were each tried). The constraint is
%% carried by `\CDossierRecordListEdgeAboveSkip', which has a measured floor of
%% 0.25; `tokens-invariants' states it and tests/extraction/ enforces it.
%% See docs/ATS-EXTRACTION.md 3.4.
%%
%% Issue #230 does not repair that from inside this macro either -- it removes
%% the column the fault needs. Under `entrymeta=inline' the heading rows carry
%% no large horizontal gap, so Poppler never splits them and the floor has
%% nothing to protect. That is a per-document choice and does not move the
%% token: `column' remains the default and ships at the floor.
%%
%% Issue #302: `\hfill' positions the right-hand cell by an absolute coordinate
%% jump, so no character at all separates the two cells in the content stream.
%% That is invisible to every extractor in the suite -- each rebuilds words from
%% glyph geometry and splits on the gap -- but a consumer that reads the
%% *logical* text of the structure element receives `Engineer2024–2026'.
%%
%% `\pdffakespace' is tagpdf's own remedy for exactly this: it marks the
%% following zero-width skip so the tagging code emits a real U+0020 into the
%% content stream. Zero width means the fill still absorbs the whole line and
%% every glyph keeps its position, and on the untagged path the command is the
%% no-op declared above, so that path is untouched. The interword spaces
%% inside ordinary prose already arrive by this same route:
%% tagged output carries real space glyphs where untagged output has only TJ
%% kerns. The gap here was that tagpdf marks only glue with a positive natural
%% width, and `\hfill' has none. See docs/ATS-EXTRACTION.md 7.5.
%%
%% #1 title (required, nonblank), #2 organization, #3 location, #4 dates.
%% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__cdossier_components_entryhead:nnnn #1#2#3#4
  {
    \noindent
    { \CDossierEntryTitleStyle #1 }
    \tl_if_blank:nF {#4}
      { \__cdossier_components_entryjoin: { \CDossierMutedStyle #4 } }
    \par
    \bool_lazy_or:nnT
      { ! \tl_if_blank_p:n {#2} }
      { ! \tl_if_blank_p:n {#3} }
      {
        %% Issue #145: the title line and the organization/location line are
        %% one visual heading unit. Without this, the two lines could land on
        %% opposite sides of a page break.
        \penalty \CDossierHeadingKeepPenalty
        \noindent
        \tl_if_blank:nF {#2} { { \CDossierBodyStyle #2 } }
        \tl_if_blank:nF {#3}
          {
            %% The join is guarded here rather than taken from
            %% \__cdossier_components_entryjoin:, because this is the one place
            %% where the two values need differently shaped guards.
            %%
            %% An organization-less entry must not open its line with a
            %% separator -- rule 5's stray "|", on the horizontal axis -- so the
            %% visible mark and the fake space are both conditional on #2. But
            %% `column's `\hfill' is not a separator at all: it is what puts a
            %% lone location at the right margin, which is exactly where the
            %% column form wants it whether or not an organization precedes it.
            %% Hoisting it into the guard would move that location to the left
            %% margin, so it stays unconditional.
            \bool_if:NTF \l__cdossier_components_entrymeta_inline_bool
              { \tl_if_blank:nF {#2} { \CDossierEntryMetaSeparator } }
              { \tl_if_blank:nF {#2} { \pdffakespace } \hfill }
            { \CDossierMutedStyle #3 }
          }
        \par
      }
  }
\cs_generate_variant:Nn \__cdossier_components_entryhead:nnnn { VVVV }

%% ---------------------------------------------------------------------------
%% Bullet-list page-break policy (issue #145).
%%
%% Shared by the entry-structured classes (résumé and CV); the continuous-prose
%% classes keep ordinary \widowpenalty/\clubpenalty handling.
%%
%% A uniform inter-item penalty cannot express this policy. TeX chooses a page
%% break by total cost, so if every inter-item boundary carries the same
%% penalty it will still pick whichever one balances the page best -- including
%% the boundary that strands a single bullet. The penalty therefore has to
%% depend on the item's position in its list:
%%
%%   - the boundary after the first item is forbidden, so one bullet is never
%%     left behind alone;
%%   - the boundary before the last item is forbidden, so one bullet is never
%%     carried over alone;
%%   - every interior boundary is merely discouraged, so a list longer than a
%%     page still breaks instead of overflowing.
%%
%% Knowing which item is last requires the list's length before the list is
%% typeset, so each list records its own item count in the auxiliary file under
%% a per-list serial and reads it back on the next run. This is the same
%% two-pass arrangement the page furniture above already relies on for the
%% total page count. On a first clean pass the count is unknown and only the
%% first-item boundary is protected, so the breaks are provisional until the
%% second run.
%% ---------------------------------------------------------------------------
\ExplSyntaxOff
\makeatletter
\newcommand\cdossier@setlistlen[2]{%
  \expandafter\gdef\csname cdossier@listlen@#1\endcsname{#2}%
}
\newcommand\cdossier@writelistlen[2]{%
  \protected@write\@auxout{}{\string\cdossier@setlistlen{#1}{#2}}%
}
\makeatother
\ExplSyntaxOn

\int_new:N \g__cdossier_components_listid_int
\int_new:N \l__cdossier_components_itemidx_int
\int_new:N \l__cdossier_components_itemtotal_int
\tl_new:N  \l__cdossier_components_listkey_tl
\cs_new_eq:NN \l__cdossier_components_saved_item \relax

\msg_new:nnn { careerdossier-components } { list-rerun }
  {
    Bullet-list~page-break~policy~needs~another~run:~
    rerun~LaTeX~to~settle~the~list~page~breaks.
  }

%% Issue #191: give the edge below a list its own token. LaTeX's `\list' has a
%% single `topsep' and uses it at both ends: at the top directly, and at the
%% bottom through `\@topsepadd', the register `\@trivlist' loads with
%% `topsep' (+ `\partopsep') on entry and `\@endparenv' contributes as the
%% list's closing `\addvspace'. Reassigning that register while the list is
%% still open is therefore the point where the two edges can differ, and it is
%% the only one: enumitem exposes no bottom-spacing key, and adding a separate
%% skip after the list would not collapse with the following block's own
%% `\addvspace' the way one list-owned skip does.
%%
%% The assignment is local to the list's group, so it cannot leak into an
%% enclosing list, and it must run before the list ends -- each list environment
%% calls this immediately before its `\end{itemize}' or `\end{enumerate}'.
%%
%% This is the untagged mechanism only. A tagged list never reads `\@topsepadd'
%% -- see the `cdossier-closing-edge' key below -- but the assignment is a local
%% register write either way, so the list environments call it unconditionally
%% rather than branching twice on the same condition.
\cs_new_protected:Npn \__cdossier_components_listedge_after:
  { \use:c { @topsepadd } = \CDossierRecordListEdgeBelowSkip \scan_stop: }

%% ---------------------------------------------------------------------------
%% The same closing edge on the tagged path (issue #193).
%%
%% Under `\DocumentMetadata{tagging=on}' LaTeX Lab replaces LaTeX's list
%% internals with its own block templates. `\@topsepadd' measures 0 pt inside a
%% tagged list, so the mechanism above cannot reach that path and the closing
%% gap was LaTeX Lab's own instance default -- 12 pt against the token's 4.25 pt
%% at the résumé default, enough to shift the last line of a one-page résumé by
%% a full line of body text relative to the untagged build of the same source.
%%
%% The block template does expose the closing edge, as two separate keys:
%%
%%   end-vspace        the counterpart of `topsep' (LaTeX Lab: `begin-vspace')
%%   end-extra-vspace  the counterpart of `partopsep' (`begin-extra-vspace')
%%
%% Both are needed. LaTeX Lab's enumitem emulation maps `topsep' and `partopsep'
%% to the two opening keys and maps nothing to the closing pair, so a list that
%% sets `partopsep = 0pt' still closes with the interface default of
%% `end-extra-vspace', which is `\partopsep' as the `article' class left it:
%% a fixed 3 pt that no token owns. Measured on the résumé fixture, setting
%% `end-vspace' alone gives token + 3 pt, and setting both gives the token.
%%
%% One CDossier-owned key therefore stands for the whole closing edge, and it is
%% the only name the classes use: the value is the complete gap below the list,
%% exactly as `\CDossierRecordListEdgeBelowSkip' is documented to be. Keeping
%% the LaTeX Lab key names in this one place also keeps the dependency on a
%% testphase interface out of the classes.
%%
%% The keys are testphase interfaces and may be renamed or withdrawn. If they
%% are, the CDossier key becomes a no-op that still consumes its value, so a
%% tagged build keeps working with LaTeX Lab's closing spacing -- the behaviour
%% before this issue -- instead of stopping at an unknown-key error. The warning
%% is what turns that silent fidelity loss into something the maintainer sees.
\msg_new:nnnn { careerdossier-components } { tagged-list-closing-edge }
  {
    LaTeX~Lab~no~longer~offers~'end-vspace';~
    tagged~lists~keep~its~own~closing~spacing.
  }
  {
    \c_backslash_str CDossierRecordListEdgeBelowSkip~cannot~be~placed~below~a~
    list~while~tagging~is~active,~so~the~tagged~and~untagged~builds~of~this~
    document~will~space~lists~differently.~The~untagged~build~is~unaffected.
  }

%% `\SetEnumitemKey' is the emulation's own interface for adding an
%% enumitem-style key, and it ships with the emulation: its absence means no
%% tagged list can be built at all and there is no key path to add anything to.
\cs_if_exist:NT \SetEnumitemKey
  {
    \bool_lazy_and:nnTF
      { \keys_if_exist_p:nn { template / block / std } { end-vspace } }
      { \keys_if_exist_p:nn { template / block / std } { end-extra-vspace } }
      {
        \SetEnumitemKey { cdossier-closing-edge }
          { end-vspace = #1 , end-extra-vspace = 0pt }
      }
      {
        \msg_warning:nn { careerdossier-components } { tagged-list-closing-edge }
        \SetEnumitemKey { cdossier-closing-edge } { }
      }
  }

%% Choose this boundary's penalty from the item's position in its list. The
%% kernel reads \@itempenalty inside \item, so the value must be assigned
%% before the real \item runs rather than contributed as a separate penalty
%% node: two adjacent penalties would give TeX the cheaper of the two as a
%% legal breakpoint and defeat the protection.
\cs_new_protected:Npn \__cdossier_components_itempenalty:
  {
    \int_compare:nNnT { \l__cdossier_components_itemidx_int } > { 1 }
      {
        \bool_lazy_or:nnTF
          { \int_compare_p:nNn { \l__cdossier_components_itemidx_int } = { 2 } }
          {
            \bool_lazy_and_p:nn
              { \int_compare_p:nNn
                  { \l__cdossier_components_itemtotal_int } > { 0 } }
              { \int_compare_p:nNn
                  { \l__cdossier_components_itemidx_int }
                  = { \l__cdossier_components_itemtotal_int } }
          }
          { \use:c { @itempenalty } = \CDossierHeadingKeepPenalty \scan_stop: }
          { \use:c { @itempenalty } = \CDossierListOrphanPenalty \scan_stop: }
      }
  }

\cs_new_protected:Npn \__cdossier_components_listpolicy_begin:
  {
    \int_gincr:N \g__cdossier_components_listid_int
    \int_zero:N \l__cdossier_components_itemidx_int
    \tl_set:Nx \l__cdossier_components_listkey_tl
      { cdossier@listlen@ \int_use:N \g__cdossier_components_listid_int }
    \int_zero:N \l__cdossier_components_itemtotal_int
    \cs_if_exist:cT { \l__cdossier_components_listkey_tl }
      {
        \int_set:Nn \l__cdossier_components_itemtotal_int
          { \use:c { \l__cdossier_components_listkey_tl } }
      }
    \cs_set_eq:NN \l__cdossier_components_saved_item \item
    \cs_set_protected:Npn \item
      {
        \int_incr:N \l__cdossier_components_itemidx_int
        \__cdossier_components_itempenalty:
        \l__cdossier_components_saved_item
      }
  }

%% Warn only when a previously recorded count disagrees with this run, which
%% means the document changed and the page breaks have not settled. A first
%% clean pass has nothing recorded yet and stays silent, exactly as the page
%% furniture above does while the total page count is still unknown.
\cs_new_protected:Npn \__cdossier_components_listpolicy_end:
  {
    %% Issue #170: discard the space that ends the final item's text before the
    %% list closes. Readable source puts `\end{CDossierItemize}' on its own
    %% line, and that newline is a space token at the end of the item's
    %% paragraph. When the item's last line already fills the measure, TeX
    %% carries that space onto a line of its own: a box with no glyphs, zero
    %% height, and zero depth, preceded by a full `\baselineskip'. The result is
    %% an invisible extra line that inflates the next structural gap -- 27.84 pt
    %% instead of 14.28 pt above the following section in the default résumé.
    %%
    %% Only the final item is affected; an inter-item boundary discards the
    %% space already. The guard is needed because this runs in vertical mode
    %% when the item body ended with its own `\par', and there `\unskip' would
    %% remove the list's own vertical spacing instead.
    \mode_if_horizontal:T { \unskip }
    \bool_lazy_and:nnT
      { \int_compare_p:nNn { \l__cdossier_components_itemtotal_int } > { 0 } }
      {
        \int_compare_p:n
          {
            \l__cdossier_components_itemidx_int
            != \l__cdossier_components_itemtotal_int
          }
      }
      { \msg_warning:nn { careerdossier-components } { list-rerun } }
    \use:c { cdossier@writelistlen }
      { \int_use:N \g__cdossier_components_listid_int }
      { \int_use:N \l__cdossier_components_itemidx_int }
  }

%% ---------------------------------------------------------------------------
%% PDF document metadata.
%%
%% A PDF with no /Title shows its filename in viewer tab bars and document
%% properties, and /Lang is the document's natural-language declaration. Both
%% are derivable from the profile this module already owns, so they are set
%% here rather than duplicated in every class.
%%
%% Timing: the values are applied at \begin{document}. They cannot be applied
%% earlier, because the class loads hyperref while the profile is still empty --
%% \CDossierSetup does not run until the preamble.
%%
%% Precedence: each field is written only when the document has not already set
%% it, so a user's own \hypersetup wins wherever it appears in the preamble.
%% That matters because the documented template in docs/ATS-EXTRACTION.md
%% places \hypersetup *before* \CDossierSetup; a blind write here would silently
%% discard it.
%%
%% Detecting "already set" takes two readers, not one, and every field here
%% needs both. hyperref's own \@pdf... macros are the record on the default
%% path; under \DocumentMetadata the value goes to the kernel instead, and the
%% \@pdf... macro the module would otherwise trust is left empty. Reading one
%% route only is the failure mode this block has had twice -- #276 for /Lang,
%% #440 for /Title and /Author -- and it is silent both times, because the two
%% mechanisms are writing the same PDF entry by different means. The two
%% conditionals below are those readers.
%%
%% hyperref is not loaded by this module (the classes own it), so every entry
%% point is guarded and the package still loads without it.
%% ---------------------------------------------------------------------------
\tl_new:N \l__cdossier_components_doctype_tl
\tl_new:N \l__cdossier_components_pdfname_tl
\tl_new:N \l__cdossier_components_pdfauthor_tl

%% Declare the kind of document being produced. The owning class calls this, so
%% a resume and a letter built from one profile do not receive identical PDF
%% titles. Absent or blank, the title falls back to the name alone.
\cs_new_protected:Npn \__cdossier_components_doctype:n #1
  { \tl_set:Nn \l__cdossier_components_doctype_tl {#1} }

%% Has the document already supplied this hyperref metadata field?
%%
%% This reads hyperref's internals, so the observed states are spelled out
%% rather than assumed. On a fresh hyperref, \@pdftitle and \@pdfauthor are
%% defined and empty, while \@pdflang is \relax. expl3 reports a \relax-meaning
%% control sequence as *not existing*, so the \relax and never-defined cases
%% collapse into the same branch -- and both mean the document has not supplied
%% a value. Only a defined, non-empty value counts as user-supplied.
%%
%% Getting this backwards is silent: the field simply never reaches the PDF, and
%% no log records it. tests/regression/components-pdfmeta.lvt pins all three
%% states.
%%
%% Emptiness is tested through the macro's expansion rather than with
%% \tl_if_empty:c, which compares meaning against \c_empty_tl and therefore
%% reports an empty \long macro as non-empty. hyperref's fields happen to be
%% non-long today, so \tl_if_empty:c would work by luck; expanding first does
%% not depend on that.
%%
%% These names are read, never redefined.
\prg_new_protected_conditional:Npnn \__cdossier_components_hyp_if_unset:n #1
  { T , TF }
  {
    \cs_if_exist:cTF {#1}
      {
        \exp_args:Ne \tl_if_empty:nTF { \use:c {#1} }
          { \prg_return_true: }
          { \prg_return_false: }
      }
      { \prg_return_true: }
  }

%% Build "Doctype - Name" with an en dash, or just "Name" when the class
%% declared no doctype.
%%
%% The separator is written as the character it is, not as `--' (issue #428).
%% Spelling it `--' produced two different titles from one source, because the
%% two build paths hand the string to different writers. On the default path
%% hyperref's \pdfstringdef performs the usual TeX ligature substitution on its
%% way to the PDF string, so `--' arrives as U+2013; under \DocumentMetadata the
%% kernel's PDF management writes the Info dictionary itself, \pdfstringdef is
%% never involved, and the two hyphens reach the file literally. Neither path
%% logs anything, and the difference is only in the catalog, which is why it
%% survived every suite -- see tests/metadata/run.sh, which now pins the two
%% against each other.
%%
%% U+2013 is the spelling the manual has always documented, and the one the
%% default path has always shipped, so the tagged path was the side that was
%% wrong. Naming it by code point keeps this file ASCII, which matters for a
%% package that ships to CTAN; ^^^^ notation is the kernel's own way to do that
%% and needs no package.
\cs_new_protected:Npn \__cdossier_components_pdftitle:
  {
    \tl_set:Nx \l__cdossier_components_pdfname_tl { \CDossierFieldValue { name } }
    \tl_if_blank:VF \l__cdossier_components_doctype_tl
      {
        \tl_put_left:Nx \l__cdossier_components_pdfname_tl
          { \l__cdossier_components_doctype_tl \c_space_tl ^^^^2013 \c_space_tl }
      }
    \__cdossier_components_pdfligatures:N \l__cdossier_components_pdfname_tl
  }

%% Spell TeX's input ligatures the same way on both build paths (issue #439).
%%
%% The comment above fixed the separator this package writes, and could, by
%% naming the character instead of spelling it `--'. That does not reach a `--'
%% the package did not write: `name = {Ada Lovelace--Byron}' still arrived as an
%% en dash on the default path and as two hyphens under \DocumentMetadata, and
%% the package does not get to choose how a user spells their own name. The
%% doctype is user text too on one class -- careerdossier-statement derives it
%% from \CDossierStatementSetup{title=...} -- so this is applied to the composed
%% string rather than to the name alone.
%%
%% Converting unconditionally is deliberate, and is why there is no test for
%% which path is running. Every sequence below maps to a character that
%% \pdfstringdef then leaves alone, so pre-converting is idempotent: the default
%% path reaches the same string it always did, and the tagged path -- where
%% \pdfstringdef never runs -- reaches it too. A path test here would be a
%% second thing to keep correct for no difference in output.
%%
%% The table is measured, not assumed, against \pdfstringdef under LuaHBTeX
%% 1.24.0 / TeX Live 2026, and it is shorter than issue #439 supposed:
%%
%%   --  -> U+2013     ---  -> U+2014     !`  -> U+00A1     ?`  -> U+00BF
%%
%% and, notably, `` and '' are NOT converted -- they reach the PDF as the two
%% ASCII characters typed, on both paths, and so must not be listed here. So are
%% <<, >> and ,,. The order matters: --- is tried before --, or three hyphens
%% would become an en dash followed by a stray hyphen. Longer runs then agree
%% with \pdfstringdef by falling out of the same greedy left-to-right pass
%% (---- gives U+2014 then a hyphen, both ways round).
%%
%% Naming the outputs by code point keeps this file ASCII, which matters for a
%% package that ships to CTAN; ^^^^ notation is the kernel's own way to do that
%% and needs no package.
%%
%% Reach. This covers the strings this package composes -- /Title and /Author,
%% both from `name'. It cannot cover a value the document sets itself, which
%% since #440 this package deliberately passes through untouched, nor
%% pdfsubject or pdfkeywords, which it never sees. Those follow hyperref's and
%% the kernel's own behaviour and still differ between the paths. Issue #442
%% settled that as accepted rather than worked around: a workaround would
%% rewrite values this package passes through on purpose, and would still reach
%% only the two fields above. pdfsubject is the evidence it is not this
%% package's to fix -- nothing here reads or writes it, and it diverges exactly
%% like the two fields that are -- and `article' with `hyperref' and none of
%% these classes loaded diverges identically too. The manual documents the
%% behaviour and tests/metadata pins it, deliberately asserting that the two
%% paths DISAGREE; if that pair ever fails, read its note before changing
%% anything here.
\cs_new_protected:Npn \__cdossier_components_pdfligatures:N #1
  {
    \regex_replace_all:nnN { --- } { ^^^^2014 } #1
    \regex_replace_all:nnN { -- }  { ^^^^2013 } #1
    \regex_replace_all:nnN { !` }  { ^^^^00a1 } #1
    \regex_replace_all:nnN { \?` } { ^^^^00bf } #1
  }

%% Has \DocumentMetadata already declared the document's language?
%%
%% There are two ways into /Lang and the module can only see one of them.
%% \__cdossier_components_hyp_if_unset:n reads hyperref's \@pdflang, which
%% catches \hypersetup{pdflang=...} but not \DocumentMetadata{lang=...}: the
%% kernel records that separately and writes the catalog itself. Read only
%% \@pdflang and a document that declared `de' looks like a document that
%% declared nothing, so the derived `en' overwrites it -- silently, since both
%% mechanisms are simply writing the same catalog key.
%%
%% \GetDocumentProperties is the kernel's own record of it, and is undefined
%% when \DocumentMetadata was never used at all -- which is the default path,
%% where this module's derived value is exactly what should apply. Note that
%% \DocumentMetadata *always* yields a language, defaulting to `en' when the
%% document gave no lang key, so on that path the kernel owns /Lang outright and
%% this module correctly stays out of it.
\prg_new_protected_conditional:Npnn \__cdossier_components_kernel_lang_if_set:
  { T , F , TF }
  {
    \cs_if_exist:NTF \GetDocumentProperties
      {
        \exp_args:Ne \tl_if_blank:nTF { \GetDocumentProperties { document / lang } }
          { \prg_return_false: }
          { \prg_return_true: }
      }
      { \prg_return_false: }
  }

%% Has the document already supplied this Info dictionary entry through the
%% kernel's PDF management? (issue #440)
%%
%% The /Lang trap above, again, for /Title and /Author. There are two ways into
%% each of those too, and \__cdossier_components_hyp_if_unset:n sees only one.
%% Under \DocumentMetadata, hyperref's driver writes pdftitle and pdfauthor
%% straight into the kernel's PDF management and never populates \@pdftitle or
%% \@pdfauthor, which stay defined and empty -- indistinguishable, to the reader
%% above, from a document that supplied nothing. So a document's own
%% \hypersetup{pdftitle=...} was detected as absent and overwritten by the
%% derived title, silently, with nothing in the log.
%%
%% /Lang is asked through \GetDocumentProperties, and that is not the accessor
%% here: measured on 2026-08-16, \GetDocumentProperties{document/title} is blank
%% on the tagged path even when the document set pdftitle, because the kernel's
%% document properties do not record it. \pdfmanagement_get:nnN is the public
%% l3pdfmanagement reader for the dictionary the value does land in; pdflscape
%% uses it with this same \quark_if_no_value: idiom.
%%
%% Like \GetDocumentProperties it is undefined when \DocumentMetadata was never
%% used -- which is the default path, where hyperref owns the Info dictionary,
%% \@pdftitle is populated, and the reader above is sufficient on its own. So
%% the guard is not a fallback: on each path exactly one of the two readers can
%% see anything, and a field counts as user-supplied when either says so.
\tl_new:N \l__cdossier_components_info_tl
\prg_new_protected_conditional:Npnn \__cdossier_components_kernel_info_if_set:n #1
  { T , F , TF }
  {
    \cs_if_exist:NTF \pdfmanagement_get:nnN
      {
        \pdfmanagement_get:nnN { Info } {#1} \l__cdossier_components_info_tl
        \quark_if_no_value:NTF \l__cdossier_components_info_tl
          { \prg_return_false: }
          {
            \tl_if_empty:NTF \l__cdossier_components_info_tl
              { \prg_return_false: }
              { \prg_return_true: }
          }
      }
      { \prg_return_false: }
  }

%% Apply the derived metadata. Only ever called when hyperref is present.
\cs_new_protected:Npn \__cdossier_components_pdfmeta:
  {
    \CDossierIfFieldTF { name }
      {
        \__cdossier_components_kernel_info_if_set:nF { Title }
          {
            \__cdossier_components_hyp_if_unset:nT { @pdftitle }
              {
                \__cdossier_components_pdftitle:
                \hypersetup { pdftitle = { \l__cdossier_components_pdfname_tl } }
              }
          }
        \__cdossier_components_kernel_info_if_set:nF { Author }
          {
            %% /Author is the second route out of `name' and does not go
            %% through the title builder, so it needs the ligature pass in its
            %% own right (issue #439). Handing \hypersetup the raw field here
            %% passes the /Title check and fails the /Author one.
            \__cdossier_components_hyp_if_unset:nT { @pdfauthor }
              {
                \tl_set:Nx \l__cdossier_components_pdfauthor_tl
                  { \CDossierFieldValue { name } }
                \__cdossier_components_pdfligatures:N
                  \l__cdossier_components_pdfauthor_tl
                \hypersetup
                  { pdfauthor = { \l__cdossier_components_pdfauthor_tl } }
              }
          }
      }
      { }
    %% CareerDossierTeX is English-only by settled decision (see
    %% docs/ARCHITECTURE.md, "English strings and the absence of a language
    %% module"); there is no language key to route this through. Either way of
    %% declaring one wins over the derived value: the document's own
    %% \hypersetup, and \DocumentMetadata.
    \__cdossier_components_kernel_lang_if_set:F
      {
        \__cdossier_components_hyp_if_unset:nT { @pdflang }
          { \hypersetup { pdflang = en } }
      }
  }

\AddToHook { begindocument }
  { \cs_if_exist:NT \hypersetup { \__cdossier_components_pdfmeta: } }

%% Ask the viewer to show the derived /Title (issue #277).
%%
%% A /Title in the file is not what a viewer puts in its window title, tab bar,
%% or recent-documents list; it uses the filename unless the catalog's
%% ViewerPreferences carry /DisplayDocTitle true. Without the flag the title
%% derived above is present and unused, which is what PDF/UA-2 clause 8.11.2
%% and WCAG 2.1 AA 2.4.2 are about. hyperref only sets it when the document
%% asks, or when \DocumentMetadata is given pdfstandard=ua-2, so the documented
%% tagged path -- \DocumentMetadata{tagging=on} -- did not get it.
%%
%% Why this is not part of \__cdossier_components_pdfmeta: above. That function
%% runs at \begin{document} and protects a user's value by *detecting* it, which
%% works because pdftitle/pdfauthor/pdflang are string fields with an observable
%% unset state. pdfdisplaydoctitle is a boolean, and its default is false --
%% exactly what an explicit `pdfdisplaydoctitle = false' leaves behind. Neither
%% driver records the difference: the legacy one has only the switch
%% \ifHy@pdfdisplaydoctitle, and under \DocumentMetadata the key writes straight
%% to the catalog, so an unset flag and a refused one are both simply an absent
%% entry. There is nothing to detect, and a write at \begin{document} could
%% therefore only overwrite a document's own choice.
%%
%% So precedence is obtained by ordering instead. The flag is set as soon as
%% hyperref exists, which is while the class is still loading -- before any
%% preamble line the document itself writes. Both drivers honour the last write
%% (the pdfmanagement key removes the catalog entry again), so a document that
%% wants the filename back writes the ordinary \hypersetup { pdfdisplaydoctitle
%% = false } and wins. The one case ordering cannot cover is the value arriving
%% as a package option, via \PassOptionsToPackage before \documentclass: those
%% are processed while hyperref loads, so this hook still runs last. See
%% doc/careerdossier.tex.
%%
%% Unlike the derived fields this is not gated on `name'. It carries no value of
%% its own, and with no /Title in the file a viewer falls back to the filename
%% exactly as it does now, so there is nothing to suppress -- and `name' is not
%% known yet at this point in any case.
\cs_new_protected:Npn \__cdossier_components_pdfdisplaydoctitle:
  { \hypersetup { pdfdisplaydoctitle = true } }

\AddToHook { package/hyperref/after }
  { \__cdossier_components_pdfdisplaydoctitle: }

%% Ordering against hyperref's own begindocument code (issue #276).
%%
%% /Lang is not written at \end{document} with the rest of the metadata. Without
%% \DocumentMetadata the kernel's PDF management is inactive, so hyperref writes
%% the catalog itself, from its own begindocument chunk -- /Lang(\@pdflang) in
%% hluatex.def's \pdfcatalog. Anything that sets pdflang after that chunk has
%% run is simply not in the file. /Title and /Author are unaffected: those go to
%% the Info dictionary from \PDF@FinishDoc at \end{document}.
%%
%% So the derived pdflang above reaches the PDF only if this package's chunk of
%% `begindocument' precedes hyperref's. Today it does, but only as an accident
%% of load order: the four classes \RequirePackage this package before they
%% \RequirePackage hyperref, and `begindocument' runs its chunks in the order
%% their packages were loaded. Load this package after hyperref -- which a
%% document using it directly may well do -- and /Lang silently disappears from
%% the output, with nothing in the log.
%%
%% State the requirement instead of inheriting it. The rule is declared, not
%% assumed, so the ordering survives a change in load order.
\DeclareHookRule { begindocument } { careerdossier-components } { before }
  { hyperref }
