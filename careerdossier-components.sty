%% Issue #242: named \MakeCDossierPageFurniture until v0.7.0, which put it in
%% the same family as \MakeCDossierHeader, \MakeCDossierLetterhead,
%% \MakeCDossierClosing, and \MakeCDossierStatementHeader. It does not belong
%% there: every one of those emits document material where the author calls it,
%% while this one emits nothing at all. It selects a \pagestyle and queues an
%% \AtBeginDocument hook, so it is only meaningful in a class preamble -- by the
%% time a document body could call it the hook has already run. It is the same
%% class-to-package plumbing as \__cdossier_components_headerbelow:N alongside
%% it, and now carries the same private form. See docs/MIGRATION.md.
\cs_new_protected:Npn \__cdossier_components_apply_page_furniture:
  {
    \bool_if:NTF \l__cdossier_components_furniture_bool
      {
        \pagestyle { cdossierfurniture }
        \AtBeginDocument { \thispagestyle { cdossierfurniturefirst } }
      }
      {
        %% medium=screen. The empty style is selected explicitly rather than
        %% simply left alone: the base class's default `plain' would otherwise
        %% put a bare page number in the foot, which is the very furniture this
        %% value asks to remove.
        \pagestyle { empty }
        \AtBeginDocument { \thispagestyle { empty } }
      }
  }

%% ---------------------------------------------------------------------------
%% Section rule.
%%
%% Shared by the résumé and CV. The rule is a rendered component rather than a
%% paragraph line: suppressing interline glue on both sides makes the calibrated
%% rule skips own the complete heading-to-rule and rule-to-content gaps. The
%% rule remains a layout artifact in tagged output, and the keep penalty still
%% binds the complete heading/rule unit to the content that follows.
%%
%% Issue #169: `\CDossierRecordSectionRuleGapSkip' is measured from the
%% heading's *baseline*, not from the bottom of its line box. A line box is as
%% deep as its deepest glyph, so a box-relative offset dropped the rule further
%% under `Experience' (p) than under `Education' -- 4.80 pt versus 2.28 pt at
%% 11 pt, a visible 2.1x swing within one document. The baseline is the line
%% the reader perceives, and it is what rules and underlines are conventionally
%% set from, so the offset is taken from there and the token means exactly what
%% it says.
%%
%% `\prevdepth' carries the heading line's depth here, because the heading
%% primitive ends with `\par'. Subtracting it converts the token from a
%% baseline distance into the box-relative skip TeX needs, and reading it before
%% `\nointerlineskip' matters: that command sets `\prevdepth' to -1000pt.
%%
%% The token must therefore exceed the heading's depth, or the rule would be
%% drawn through descender ink. The shared smoke regression asserts that lower
%% bound rather than clamping it here, so an unusable value fails loudly instead
%% of silently reverting to glyph-dependent placement.
%% ---------------------------------------------------------------------------
\dim_new:N \l__cdossier_components_headingdepth_dim

\cs_new_protected:Npn \__cdossier_components_section_rule:
  {
    \dim_set:Nn \l__cdossier_components_headingdepth_dim { \tex_prevdepth:D }
    \nointerlineskip
    \skip_vertical:n
      {
        \CDossierRecordSectionRuleGapSkip
        - \l__cdossier_components_headingdepth_dim
      }
    \noindent
      {
        \CDossierRuleColor
        \__cdossier_typography_layout_artifact:n
          { \rule { \linewidth } { \CDossierRuleThickness } }
      }
    \par
    \nointerlineskip
    \penalty \CDossierHeadingKeepPenalty
    %% Issue #168: the rule-to-content gap must be *this* token, not this token
    %% plus whatever leading space the following block contributes. `\vspace'
    %% cannot deliver that: `\@vspace' appends `\vskip\z@skip', so the following
    %% block's `\addvspace' sees `\lastskip' as zero and adds instead of
    %% collapsing. `\addvspace' leaves the skip visible, so LaTeX's usual
    %% collapsing rule applies and the gap is the larger of the two -- never
    %% their sum -- for entry-led, list-led, and prose-led sections alike.
    \addvspace { \CDossierRecordSectionBelowSkip }
  }

%% ---------------------------------------------------------------------------
%% Structure-text separator fallback (issue #302).
%%
%% `\pdffakespace' is tagpdf's; it emits a real U+0020 into the content stream
%% at zero rendered width, so a gap made of glue alone still reads as a word
%% boundary to a consumer of the structure tree. It exists only when tagpdf is
%% loaded, which is only when the document asked for tagging. Every call site
%% in this package is therefore on a path that must also work untagged, and on
%% that path the command must simply do nothing.
%%
%% The fallback is declared at \begin{document} rather than here. tagpdf uses
%% \NewDocumentCommand, which errors on an existing definition, so a
%% \providecommand at package-load time would not merely lose the race -- it
%% would break the tagged build outright. By \begin{document} tagpdf has either
%% defined the command or is not present at all.
%%
%% Shared deliberately: careerdossier-letter.cls needs the same fallback for
%% its recipient block, and every class loads this package.
%% ---------------------------------------------------------------------------
\AddToHook { begindocument } { \providecommand \pdffakespace { } }

%% ---------------------------------------------------------------------------
%% Entry heading primitive.
%%
%% Renders a single entry heading shared by résumé sections (experience,
%% education, projects, ...). It takes a required title and up to three optional
%% metadata fields, and carries no page geometry or vertical spacing of its own:
%% the owning class decides how much room surrounds an entry. Layout:
%%
%%   Title .......................................... dates
%%   Organization ................................... location
%%
%% Each optional cell is emitted only when its value is nonblank, so a missing
%% field leaves no dangling punctuation, separator, or empty second line. The
%% second line is emitted only when organization or location is present.
%%
%% Issue #219: the right-hand column's *extraction* order is not decided here.
%% Poppler builds reading order from glyph positions alone, and once a bullet
%% list closes up against the heading it groups the heading's left column and
%% the list into one tall block -- which it then reads as the left column of a
%% two-column page and emits before the dates. The trigger is page-level: the
%% same code extracts correctly at the same list gap as soon as any body line
%% happens to reach the dates' horizontal band.
%%
%% Do not try to repair that from inside this macro. The heading row is already
%% a single line box in source order, which is not what Poppler groups on;
%% adjusting the two heading lines' spacing does not split the block; and every
%% invisible bridging character is either discarded (U+0020, U+00A0, U+200B) or
%% missing from TeX Gyre Heros (U+2000, U+2002, U+2003, U+2007, U+2009, and
%% U+205F were each tried). The constraint is
%% carried by `\CDossierRecordListEdgeAboveSkip', which has a measured floor of
%% 0.25; `tokens-invariants' states it and tests/extraction/ enforces it.
%% See docs/ATS-EXTRACTION.md 3.4.
%%
%% Issue #302: `\hfill' positions the right-hand cell by an absolute coordinate
%% jump, so no character at all separates the two cells in the content stream.
%% That is invisible to every extractor in the suite -- each rebuilds words from
%% glyph geometry and splits on the gap -- but a consumer that reads the
%% *logical* text of the structure element receives `Engineer2024–2026'.
%%
%% `\pdffakespace' is tagpdf's own remedy for exactly this: it marks the
%% following zero-width skip so the tagging code emits a real U+0020 into the
%% content stream. Zero width means the fill still absorbs the whole line and
%% every glyph keeps its position, and on the untagged path the command is the
%% no-op declared above, so that path is untouched. The interword spaces
%% inside ordinary prose already arrive by this same route:
%% tagged output carries real space glyphs where untagged output has only TJ
%% kerns. The gap here was that tagpdf marks only glue with a positive natural
%% width, and `\hfill' has none. See docs/ATS-EXTRACTION.md 7.5.
%%
%% #1 title (required, nonblank), #2 organization, #3 location, #4 dates.
%% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__cdossier_components_entryhead:nnnn #1#2#3#4
  {
    \noindent
    { \CDossierEntryTitleStyle #1 }
    \tl_if_blank:nF {#4}
      { \pdffakespace \hfill { \CDossierMutedStyle #4 } }
    \par
    \bool_lazy_or:nnT
      { ! \tl_if_blank_p:n {#2} }
      { ! \tl_if_blank_p:n {#3} }
      {
        %% Issue #145: the title line and the organization/location line are
        %% one visual heading unit. Without this, the two lines could land on
        %% opposite sides of a page break.
        \penalty \CDossierHeadingKeepPenalty
        \noindent
        \tl_if_blank:nF {#2} { { \CDossierBodyStyle #2 } }
        \tl_if_blank:nF {#3}
          {
            %% Only when something precedes it: an organization-less entry must
            %% not open its line with a separator, for the same reason rule 5
            %% forbids a stray "|".
            \tl_if_blank:nF {#2} { \pdffakespace }
            \hfill { \CDossierMutedStyle #3 }
          }
        \par
      }
  }
\cs_generate_variant:Nn \__cdossier_components_entryhead:nnnn { VVVV }

%% ---------------------------------------------------------------------------
%% Bullet-list page-break policy (issue #145).
%%
%% Shared by the entry-structured classes (résumé and CV); the continuous-prose
%% classes keep ordinary \widowpenalty/\clubpenalty handling.
%%
%% A uniform inter-item penalty cannot express this policy. TeX chooses a page
%% break by total cost, so if every inter-item boundary carries the same
%% penalty it will still pick whichever one balances the page best -- including
%% the boundary that strands a single bullet. The penalty therefore has to
%% depend on the item's position in its list:
%%
%%   - the boundary after the first item is forbidden, so one bullet is never
%%     left behind alone;
%%   - the boundary before the last item is forbidden, so one bullet is never
%%     carried over alone;
%%   - every interior boundary is merely discouraged, so a list longer than a
%%     page still breaks instead of overflowing.
%%
%% Knowing which item is last requires the list's length before the list is
%% typeset, so each list records its own item count in the auxiliary file under
%% a per-list serial and reads it back on the next run. This is the same
%% two-pass arrangement the page furniture above already relies on for the
%% total page count. On a first clean pass the count is unknown and only the
%% first-item boundary is protected, so the breaks are provisional until the
%% second run.
%% ---------------------------------------------------------------------------
\ExplSyntaxOff
\makeatletter
\newcommand\cdossier@setlistlen[2]{%
  \expandafter\gdef\csname cdossier@listlen@#1\endcsname{#2}%
}
\newcommand\cdossier@writelistlen[2]{%
  \protected@write\@auxout{}{\string\cdossier@setlistlen{#1}{#2}}%
}
\makeatother
\ExplSyntaxOn

\int_new:N \g__cdossier_components_listid_int
\int_new:N \l__cdossier_components_itemidx_int
\int_new:N \l__cdossier_components_itemtotal_int
\tl_new:N  \l__cdossier_components_listkey_tl
\cs_new_eq:NN \l__cdossier_components_saved_item \relax

\msg_new:nnn { careerdossier-components } { list-rerun }
  {
    Bullet-list~page-break~policy~needs~another~run:~
    rerun~LaTeX~to~settle~the~list~page~breaks.
  }

%% Issue #191: give the edge below a list its own token. LaTeX's `\list' has a
%% single `topsep' and uses it at both ends: at the top directly, and at the
%% bottom through `\@topsepadd', the register `\@trivlist' loads with
%% `topsep' (+ `\partopsep') on entry and `\@endparenv' contributes as the
%% list's closing `\addvspace'. Reassigning that register while the list is
%% still open is therefore the point where the two edges can differ, and it is
%% the only one: enumitem exposes no bottom-spacing key, and adding a separate
%% skip after the list would not collapse with the following block's own
%% `\addvspace' the way one list-owned skip does.
%%
%% The assignment is local to the list's group, so it cannot leak into an
%% enclosing list, and it must run before the list ends -- each list environment
%% calls this immediately before its `\end{itemize}' or `\end{enumerate}'.
%%
%% This is the untagged mechanism only. A tagged list never reads `\@topsepadd'
%% -- see the `cdossier-closing-edge' key below -- but the assignment is a local
%% register write either way, so the list environments call it unconditionally
%% rather than branching twice on the same condition.
\cs_new_protected:Npn \__cdossier_components_listedge_after:
  { \use:c { @topsepadd } = \CDossierRecordListEdgeBelowSkip \scan_stop: }

%% ---------------------------------------------------------------------------
%% The same closing edge on the tagged path (issue #193).
%%
%% Under `\DocumentMetadata{tagging=on}' LaTeX Lab replaces LaTeX's list
%% internals with its own block templates. `\@topsepadd' measures 0 pt inside a
%% tagged list, so the mechanism above cannot reach that path and the closing
%% gap was LaTeX Lab's own instance default -- 12 pt against the token's 4.25 pt
%% at the résumé default, enough to shift the last line of a one-page résumé by
%% a full line of body text relative to the untagged build of the same source.
%%
%% The block template does expose the closing edge, as two separate keys:
%%
%%   end-vspace        the counterpart of `topsep' (LaTeX Lab: `begin-vspace')
%%   end-extra-vspace  the counterpart of `partopsep' (`begin-extra-vspace')
%%
%% Both are needed. LaTeX Lab's enumitem emulation maps `topsep' and `partopsep'
%% to the two opening keys and maps nothing to the closing pair, so a list that
%% sets `partopsep = 0pt' still closes with the interface default of
%% `end-extra-vspace', which is `\partopsep' as the `article' class left it:
%% a fixed 3 pt that no token owns. Measured on the résumé fixture, setting
%% `end-vspace' alone gives token + 3 pt, and setting both gives the token.
%%
%% One CDossier-owned key therefore stands for the whole closing edge, and it is
%% the only name the classes use: the value is the complete gap below the list,
%% exactly as `\CDossierRecordListEdgeBelowSkip' is documented to be. Keeping
%% the LaTeX Lab key names in this one place also keeps the dependency on a
%% testphase interface out of the classes.
%%
%% The keys are testphase interfaces and may be renamed or withdrawn. If they
%% are, the CDossier key becomes a no-op that still consumes its value, so a
%% tagged build keeps working with LaTeX Lab's closing spacing -- the behaviour
%% before this issue -- instead of stopping at an unknown-key error. The warning
%% is what turns that silent fidelity loss into something the maintainer sees.
\msg_new:nnnn { careerdossier-components } { tagged-list-closing-edge }
  {
    LaTeX~Lab~no~longer~offers~'end-vspace';~
    tagged~lists~keep~its~own~closing~spacing.
  }
  {
    \c_backslash_str CDossierRecordListEdgeBelowSkip~cannot~be~placed~below~a~
    list~while~tagging~is~active,~so~the~tagged~and~untagged~builds~of~this~
    document~will~space~lists~differently.~The~untagged~build~is~unaffected.
  }

%% `\SetEnumitemKey' is the emulation's own interface for adding an
%% enumitem-style key, and it ships with the emulation: its absence means no
%% tagged list can be built at all and there is no key path to add anything to.
\cs_if_exist:NT \SetEnumitemKey
  {
    \bool_lazy_and:nnTF
      { \keys_if_exist_p:nn { template / block / std } { end-vspace } }
      { \keys_if_exist_p:nn { template / block / std } { end-extra-vspace } }
      {
        \SetEnumitemKey { cdossier-closing-edge }
          { end-vspace = #1 , end-extra-vspace = 0pt }
      }
      {
        \msg_warning:nn { careerdossier-components } { tagged-list-closing-edge }
        \SetEnumitemKey { cdossier-closing-edge } { }
      }
  }

%% Choose this boundary's penalty from the item's position in its list. The
%% kernel reads \@itempenalty inside \item, so the value must be assigned
%% before the real \item runs rather than contributed as a separate penalty
%% node: two adjacent penalties would give TeX the cheaper of the two as a
%% legal breakpoint and defeat the protection.
\cs_new_protected:Npn \__cdossier_components_itempenalty:
  {
    \int_compare:nNnT { \l__cdossier_components_itemidx_int } > { 1 }
      {
        \bool_lazy_or:nnTF
          { \int_compare_p:nNn { \l__cdossier_components_itemidx_int } = { 2 } }
          {
            \bool_lazy_and_p:nn
              { \int_compare_p:nNn
                  { \l__cdossier_components_itemtotal_int } > { 0 } }
              { \int_compare_p:nNn
                  { \l__cdossier_components_itemidx_int }
                  = { \l__cdossier_components_itemtotal_int } }
          }
          { \use:c { @itempenalty } = \CDossierHeadingKeepPenalty \scan_stop: }
          { \use:c { @itempenalty } = \CDossierListOrphanPenalty \scan_stop: }
      }
  }

\cs_new_protected:Npn \__cdossier_components_listpolicy_begin:
  {
    \int_gincr:N \g__cdossier_components_listid_int
    \int_zero:N \l__cdossier_components_itemidx_int
    \tl_set:Nx \l__cdossier_components_listkey_tl
      { cdossier@listlen@ \int_use:N \g__cdossier_components_listid_int }
    \int_zero:N \l__cdossier_components_itemtotal_int
    \cs_if_exist:cT { \l__cdossier_components_listkey_tl }
      {
        \int_set:Nn \l__cdossier_components_itemtotal_int
          { \use:c { \l__cdossier_components_listkey_tl } }
      }
    \cs_set_eq:NN \l__cdossier_components_saved_item \item
    \cs_set_protected:Npn \item
      {
        \int_incr:N \l__cdossier_components_itemidx_int
        \__cdossier_components_itempenalty:
        \l__cdossier_components_saved_item
      }
  }

%% Warn only when a previously recorded count disagrees with this run, which
%% means the document changed and the page breaks have not settled. A first
%% clean pass has nothing recorded yet and stays silent, exactly as the page
%% furniture above does while the total page count is still unknown.
\cs_new_protected:Npn \__cdossier_components_listpolicy_end:
  {
    %% Issue #170: discard the space that ends the final item's text before the
    %% list closes. Readable source puts `\end{CDossierItemize}' on its own
    %% line, and that newline is a space token at the end of the item's
    %% paragraph. When the item's last line already fills the measure, TeX
    %% carries that space onto a line of its own: a box with no glyphs, zero
    %% height, and zero depth, preceded by a full `\baselineskip'. The result is
    %% an invisible extra line that inflates the next structural gap -- 27.84 pt
    %% instead of 14.28 pt above the following section in the default résumé.
    %%
    %% Only the final item is affected; an inter-item boundary discards the
    %% space already. The guard is needed because this runs in vertical mode
    %% when the item body ended with its own `\par', and there `\unskip' would
    %% remove the list's own vertical spacing instead.
    \mode_if_horizontal:T { \unskip }
    \bool_lazy_and:nnT
      { \int_compare_p:nNn { \l__cdossier_components_itemtotal_int } > { 0 } }
      {
        \int_compare_p:n
          {
            \l__cdossier_components_itemidx_int
            != \l__cdossier_components_itemtotal_int
          }
      }
      { \msg_warning:nn { careerdossier-components } { list-rerun } }
    \use:c { cdossier@writelistlen }
      { \int_use:N \g__cdossier_components_listid_int }
      { \int_use:N \l__cdossier_components_itemidx_int }
  }

%% ---------------------------------------------------------------------------
%% PDF document metadata.
%%
%% A PDF with no /Title shows its filename in viewer tab bars and document
%% properties, and /Lang is the document's natural-language declaration. Both
%% are derivable from the profile this module already owns, so they are set
%% here rather than duplicated in every class.
%%
%% Timing: the values are applied at \begin{document}. They cannot be applied
%% earlier, because the class loads hyperref while the profile is still empty --
%% \CDossierSetup does not run until the preamble.
%%
%% Precedence: each field is written only when the document has not already set
%% it, so a user's own \hypersetup wins wherever it appears in the preamble.
%% That matters because the documented template in docs/ATS-EXTRACTION.md
%% places \hypersetup *before* \CDossierSetup; a blind write here would silently
%% discard it.
%%
%% hyperref is not loaded by this module (the classes own it), so every entry
%% point is guarded and the package still loads without it.
%% ---------------------------------------------------------------------------
\tl_new:N \l__cdossier_components_doctype_tl
\tl_new:N \l__cdossier_components_pdfname_tl

%% Declare the kind of document being produced. The owning class calls this, so
%% a resume and a letter built from one profile do not receive identical PDF
%% titles. Absent or blank, the title falls back to the name alone.
\cs_new_protected:Npn \__cdossier_components_doctype:n #1
  { \tl_set:Nn \l__cdossier_components_doctype_tl {#1} }

%% Has the document already supplied this hyperref metadata field?
%%
%% This reads hyperref's internals, so the observed states are spelled out
%% rather than assumed. On a fresh hyperref, \@pdftitle and \@pdfauthor are
%% defined and empty, while \@pdflang is \relax. expl3 reports a \relax-meaning
%% control sequence as *not existing*, so the \relax and never-defined cases
%% collapse into the same branch -- and both mean the document has not supplied
%% a value. Only a defined, non-empty value counts as user-supplied.
%%
%% Getting this backwards is silent: the field simply never reaches the PDF, and
%% no log records it. tests/regression/components-pdfmeta.lvt pins all three
%% states.
%%
%% Emptiness is tested through the macro's expansion rather than with
%% \tl_if_empty:c, which compares meaning against \c_empty_tl and therefore
%% reports an empty \long macro as non-empty. hyperref's fields happen to be
%% non-long today, so \tl_if_empty:c would work by luck; expanding first does
%% not depend on that.
%%
%% These names are read, never redefined.
\prg_new_protected_conditional:Npnn \__cdossier_components_hyp_if_unset:n #1
  { T , TF }
  {
    \cs_if_exist:cTF {#1}
      {
        \exp_args:Ne \tl_if_empty:nTF { \use:c {#1} }
          { \prg_return_true: }
          { \prg_return_false: }
      }
      { \prg_return_true: }
  }

%% Build "Doctype -- Name", or just "Name" when the class declared no doctype.
\cs_new_protected:Npn \__cdossier_components_pdftitle:
  {
    \tl_set:Nx \l__cdossier_components_pdfname_tl { \CDossierFieldValue { name } }
    \tl_if_blank:VF \l__cdossier_components_doctype_tl
      {
        \tl_put_left:Nx \l__cdossier_components_pdfname_tl
          { \l__cdossier_components_doctype_tl \c_space_tl -- \c_space_tl }
      }
  }

%% Has \DocumentMetadata already declared the document's language?
%%
%% There are two ways into /Lang and the module can only see one of them.
%% \__cdossier_components_hyp_if_unset:n reads hyperref's \@pdflang, which
%% catches \hypersetup{pdflang=...} but not \DocumentMetadata{lang=...}: the
%% kernel records that separately and writes the catalog itself. Read only
%% \@pdflang and a document that declared `de' looks like a document that
%% declared nothing, so the derived `en' overwrites it -- silently, since both
%% mechanisms are simply writing the same catalog key.
%%
%% \GetDocumentProperties is the kernel's own record of it, and is undefined
%% when \DocumentMetadata was never used at all -- which is the default path,
%% where this module's derived value is exactly what should apply. Note that
%% \DocumentMetadata *always* yields a language, defaulting to `en' when the
%% document gave no lang key, so on that path the kernel owns /Lang outright and
%% this module correctly stays out of it.
\prg_new_protected_conditional:Npnn \__cdossier_components_kernel_lang_if_set:
  { T , F , TF }
  {
    \cs_if_exist:NTF \GetDocumentProperties
      {
        \exp_args:Ne \tl_if_blank:nTF { \GetDocumentProperties { document / lang } }
          { \prg_return_false: }
          { \prg_return_true: }
      }
      { \prg_return_false: }
  }

%% Apply the derived metadata. Only ever called when hyperref is present.
\cs_new_protected:Npn \__cdossier_components_pdfmeta:
  {
    \CDossierIfFieldTF { name }
      {
        \__cdossier_components_hyp_if_unset:nT { @pdftitle }
          {
            \__cdossier_components_pdftitle:
            \hypersetup { pdftitle = { \l__cdossier_components_pdfname_tl } }
          }
        \__cdossier_components_hyp_if_unset:nT { @pdfauthor }
          { \hypersetup { pdfauthor = { \CDossierFieldValue { name } } } }
      }
      { }
    %% v0.1.0 is English-only (see docs/ARCHITECTURE.md); there is no language
    %% key to route this through yet. Either way of declaring one wins over the
    %% derived value: the document's own \hypersetup, and \DocumentMetadata.
    \__cdossier_components_kernel_lang_if_set:F
      {
        \__cdossier_components_hyp_if_unset:nT { @pdflang }
          { \hypersetup { pdflang = en } }
      }
  }

\AddToHook { begindocument }
  { \cs_if_exist:NT \hypersetup { \__cdossier_components_pdfmeta: } }

%% Ask the viewer to show the derived /Title (issue #277).
%%
%% A /Title in the file is not what a viewer puts in its window title, tab bar,
%% or recent-documents list; it uses the filename unless the catalog's
%% ViewerPreferences carry /DisplayDocTitle true. Without the flag the title
%% derived above is present and unused, which is what PDF/UA-2 clause 8.11.2
%% and WCAG 2.1 AA 2.4.2 are about. hyperref only sets it when the document
%% asks, or when \DocumentMetadata is given pdfstandard=ua-2, so the documented
%% tagged path -- \DocumentMetadata{tagging=on} -- did not get it.
%%
%% Why this is not part of \__cdossier_components_pdfmeta: above. That function
%% runs at \begin{document} and protects a user's value by *detecting* it, which
%% works because pdftitle/pdfauthor/pdflang are string fields with an observable
%% unset state. pdfdisplaydoctitle is a boolean, and its default is false --
%% exactly what an explicit `pdfdisplaydoctitle = false' leaves behind. Neither
%% driver records the difference: the legacy one has only the switch
%% \ifHy@pdfdisplaydoctitle, and under \DocumentMetadata the key writes straight
%% to the catalog, so an unset flag and a refused one are both simply an absent
%% entry. There is nothing to detect, and a write at \begin{document} could
%% therefore only overwrite a document's own choice.
%%
%% So precedence is obtained by ordering instead. The flag is set as soon as
%% hyperref exists, which is while the class is still loading -- before any
%% preamble line the document itself writes. Both drivers honour the last write
%% (the pdfmanagement key removes the catalog entry again), so a document that
%% wants the filename back writes the ordinary \hypersetup { pdfdisplaydoctitle
%% = false } and wins. The one case ordering cannot cover is the value arriving
%% as a package option, via \PassOptionsToPackage before \documentclass: those
%% are processed while hyperref loads, so this hook still runs last. See
%% docs/API.md.
%%
%% Unlike the derived fields this is not gated on `name'. It carries no value of
%% its own, and with no /Title in the file a viewer falls back to the filename
%% exactly as it does now, so there is nothing to suppress -- and `name' is not
%% known yet at this point in any case.
\cs_new_protected:Npn \__cdossier_components_pdfdisplaydoctitle:
  { \hypersetup { pdfdisplaydoctitle = true } }

\AddToHook { package/hyperref/after }
  { \__cdossier_components_pdfdisplaydoctitle: }

%% Ordering against hyperref's own begindocument code (issue #276).
%%
%% /Lang is not written at \end{document} with the rest of the metadata. Without
%% \DocumentMetadata the kernel's PDF management is inactive, so hyperref writes
%% the catalog itself, from its own begindocument chunk -- /Lang(\@pdflang) in
%% hluatex.def's \pdfcatalog. Anything that sets pdflang after that chunk has
%% run is simply not in the file. /Title and /Author are unaffected: those go to
%% the Info dictionary from \PDF@FinishDoc at \end{document}.
%%
%% So the derived pdflang above reaches the PDF only if this package's chunk of
%% `begindocument' precedes hyperref's. Today it does, but only as an accident
%% of load order: the four classes \RequirePackage this package before they
%% \RequirePackage hyperref, and `begindocument' runs its chunks in the order
%% their packages were loaded. Load this package after hyperref -- which a
%% document using it directly may well do -- and /Lang silently disappears from
%% the output, with nothing in the log.
%%
%% State the requirement instead of inheriting it. The rule is declared, not
%% assumed, so the ordering survives a change in load order.
\DeclareHookRule { begindocument } { careerdossier-components } { before }
  { hyperref }
